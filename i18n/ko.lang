template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "레퍼런스 음성(Audio File) + 텍스트(Text) → VoxCPM2 TTS(ref_audio에서 클론) → Audio Player 및 Save to File. 음성 샘플이 담긴 짧은 WAV를 열고 텍스트를 입력한 뒤, Syn Checkpoint 노드에 VoxCPM .syn 모델을 지정하고 Run을 누르세요."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "레퍼런스 음성(Audio File) → GigaAM ASR(자동 전사 → ref text) + 텍스트(Text) → OmniVoice TTS(ref_audio 기반 Clone 모드) → Audio Player 및 Save to File. 음성 샘플이 담긴 WAV를 열고 텍스트를 입력한 뒤, Syn Checkpoint 노드에 .syn 모델을 지정하세요: ASR용 GigaAM(gigaam-v3.syn), TTS용 OmniVoice(omnivoice.syn). 이후 Run을 누르세요. Text View의 전사 내용은 합성 전에 수정할 수 있습니다."
template.builtin-vibevoice-dialogue.name = "VibeVoice: 두 화자 대화"
template.builtin-vibevoice-dialogue.desc = "\"Speaker 1: …\" / \"Speaker 2: …\" 형식의 스크립트와 짧은 WAV 음성 샘플 두 개 → VibeVoice가 연속된 24kHz 대화 트랙을 합성합니다. Syn Checkpoint 노드에 vibevoice-1.5b.syn을 지정하고 Run을 누르세요."
template.builtin-vibevoice-single.name = "VibeVoice: 단일 음성 클론"
template.builtin-vibevoice-single.desc = "WAV 음성 샘플 하나 + 텍스트 → VibeVoice가 전체를 내레이션합니다(모델은 수십 분 분량의 컨텍스트를 유지). Syn Checkpoint 노드에 vibevoice-1.5b.syn 또는 vibevoice-7b.syn을 사용하세요."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: 주제로 만드는 팟캐스트 (LLM → 음성)"
template.builtin-vibevoice-llm-podcast.desc = "주제 → LLM이 \"Speaker N: …\" 형식의 대사로 스크립트를 작성 → Text View(직접 수정 가능) → VibeVoice가 두 화자로 내레이션 → 플레이어 및 저장. Syn Checkpoint 노드 두 개가 필요합니다: LLM 번들과 vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → 플레이어. 텍스트 기반 음악 생성의 기본형입니다."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "같은 태그로 만드는 트랙 변주(노이즈 시드 두 개를 혼합). Retake variance가 변주 강도를 조절하며, 소스 오디오는 필요 없습니다."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "소스 오디오의 [start,end] 구간을 재생성합니다(구간 밖은 원본 그대로 유지). ⚠ Duration을 소스 오디오 길이로 설정하세요."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "오디오를 연장합니다: 원본은 유지되고 새 꼬리 부분이 생성됩니다. ⚠ Duration을 소스 길이보다 크게 설정하고, region은 새로 생성할 부분으로 지정하세요(start = 소스 길이, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "소스 오디오를 새 프롬프트 방향으로 변형합니다(SDEdit: n_max까지 노이즈를 다시 추가한 뒤 디노이즈). n_max=0이면 변화 없음, 1에 가까울수록 변형이 강해집니다. ⚠ Duration = 소스 길이."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "커버 버전: 소스 오디오 → DiT 컨텍스트, 태그로 새로운 스타일/악기를 지정합니다. ⚠ Duration = 소스 길이."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "믹스에서 스템을 추출합니다: 소스 오디오 → DiT 컨텍스트, 태그로 추출할 요소를 지정합니다. ⚠ Duration = 소스 길이."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler(비디오와 오디오를 함께 디노이즈) → VAE Decode + Audio Decode → mp4 및 플레이어. Checkpoint에 MiniMax-H3 .syn 번들을 지정하면 인코더는 번들에서 자동으로 가져옵니다. 원본 파이프라인: 20스텝, CFG 5 — Sampler의 기본값입니다."
template.builtin-h3-turbo.name = "H3: Turbo (6단계)"
template.builtin-h3-turbo.desc = "Text to Video와 같은 그래프이지만 Turbo LoRA에 맞춰 조정되었습니다: 6단계, CFG 없음(이 템플릿의 Sampler에 설정됨). Checkpoint의 LoRA 필드에 minimax_h3_turbo_v4_step600_ema.safetensors를 지정하세요 — 지정하지 않으면 6단계만으로는 노이즈가 낀 깜빡임이 나타납니다."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "이미지에 생명을 불어넣습니다: Keyframe(\"first frame\" 슬롯)의 출력이 Text Encoder(프롬프트 표현에서 <Picture 1>로)와 Sampler(VAE로 인코딩되어 conditioning에 반영) 양쪽에 전달됩니다. AV-latent 해상도를 소스의 종횡비에 맞게 설정하세요."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "두 프레임 사이의 전환입니다. 두 번째 Keyframe 노드에서 \"last frame\" 슬롯을 선택하세요 — 모델은 첫 프레임과 마지막 프레임에만 앵커를 지원하며, 중간 앵커는 레이아웃 조립 단계에서 거부됩니다."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) 및 동영상 플레이어(프레임+오디오를 메모리에서 재생, Save와 병렬 진행). Checkpoint 노드에 LTX-2.3, Gemma, upscaler를 지정하세요 — 모델 디렉터리의 .syn 번들(또는 .safetensors + Gemma HF 디렉터리). 체크포인트는 반드시 distilled 버전(ltx-2.3-22b-distilled-*)이어야 합니다: 각 단계가 distilled 8+3스텝 스케줄을 따르며, dev 체크포인트를 사용하면 영상이 흐려집니다."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "이미지(frame 0) + 프롬프트 → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → 동영상 플레이어 / Save. Checkpoint에 LTX-2.3, Gemma, upscaler를 지정하고, LTX Image에는 이미지를 지정하세요."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "소스 동영상(LTX Video Input) + 프롬프트 → Text Encoder → Retake([start,end]초 구간을 재생성하고 나머지는 고정) → VAE Decode + Audio Decode → 동영상 플레이어 / Save. 단일 단계(upscale 없음)입니다. Checkpoint에 LTX-2.3과 Gemma를 지정하고, Video Input에는 동영상을 지정하세요."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "레퍼런스 동영상(LTX Video Input)이 구조/움직임을 정하고 프롬프트가 내용을 정합니다 → Text Encoder → IC-LoRA(ref-control 추가) → VAE Decode + Audio Decode → 동영상 플레이어 / Save. Checkpoint에 LTX-2.3, Gemma, IC-LoRA 어댑터(LoRA 필드)를 지정하고, Video Input에는 레퍼런스 동영상을 지정하세요."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "레퍼런스 동영상(얼굴) + 음성(Audio Input) → 음성에 맞춰 립싱크: Text Encoder → Lipdub(stage1 A/V에서 ref+audio 추가 → upscale → stage2 refine) → VAE Decode + Audio Decode → 동영상 플레이어 / Save. Checkpoint에 LTX-2.3, Gemma, upscaler, lipdub IC-LoRA(LoRA 필드)를 지정하세요."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "오디오(Audio Input)가 오디오 트랙을 고정하고 프롬프트가 장면을 정합니다 → Text Encoder → A2V(stage1에서 오디오를 고정한 채 video-denoise → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → 동영상 플레이어 / Save. Checkpoint에 LTX-2.3, Gemma, upscaler를 지정하고, Audio Input에는 사운드를 지정하세요."

