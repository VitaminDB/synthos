template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Пустой канвас — старт с нуля."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Чистая арифметика."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Открой WAV, нажми Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Запиши голос и сразу проиграй."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Запиши голос и услышь его с эффектами в реальном времени."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Запись микрофона в WAV-файл (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 источника) → Audio Player. Базовый шаблон микширования двух треков."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Караоке-сценарий: голос поверх трека."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Образец голоса (Audio File) + текст → VoxCPM2 (тембр с образца) → плеер и сохранение. Откройте короткий WAV с образцом, впишите текст и нажмите Run; модель — из библиотеки службы."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Образец голоса (Audio File) → расшифровка GigaAM (текст образца) + текст → OmniVoice (клон с образца) → плеер и сохранение. Откройте WAV с образцом, впишите текст и нажмите Run; модели — из библиотеки службы."
template.builtin-vibevoice-dialogue.name = "VibeVoice: диалог двух голосов"
template.builtin-vibevoice-dialogue.desc = "Сценарий вида «Speaker 1: …» / «Speaker 2: …» плюс два коротких WAV с образцами голосов → VibeVoice синтезирует сплошную дорожку диалога 24 кГц. Модель (vibevoice-1-5b или vibevoice-7b) — в поле «Модель»."
template.builtin-vibevoice-single.name = "VibeVoice: клон одного голоса"
template.builtin-vibevoice-single.desc = "Один WAV с образцом голоса + текст → VibeVoice озвучивает его целиком (модель держит контекст на десятки минут). Модель (vibevoice-1-5b или vibevoice-7b) — в поле «Модель»."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: подкаст из темы (LLM → голос)"
template.builtin-vibevoice-llm-podcast.desc = "Тема → языковая модель пишет сценарий строками «Speaker N: …» → Text View (правится вручную) → VibeVoice озвучивает двумя голосами → плеер и сохранение. Модели — из библиотеки службы."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Модель ACE-Step + теги и стихи → Генерация (text2music) → плеер. Базовая генерация музыки по описанию; считает служба."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Вариация трека при тех же тегах (микс двух шумовых seed'ов). Retake variance задаёт силу вариации; src-аудио не нужно."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Перегенерация отрезка [начало, конец] записи (вне отрезка — оригинал). Длина берётся из записи."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Продление записи: оригинал сохраняется, новый хвост генерируется. Задай «Секунд» больше длины записи, отрезок — новая часть (начало = длина записи, конец = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Морфинг записи к новому описанию (SDEdit: ре-шум до n_max → денойз). n_max = 0 — без изменений, ближе к 1 — сильнее. Длина берётся из записи."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Кавер: запись → контекст DiT, теги задают новый стиль и инструменты. Длина берётся из записи."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Выделение стема из микса: запись → контекст DiT, дорожка — в поле «Extract: дорожка». Длина берётся из записи."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Промпт → Кодировщик H3 (Qwen3-VL) → Сэмплер H3 (видео и звук вместе, 20 шагов, CFG 5) → декодеры видео и звука → Наложение звука → mp4 и плеер. Размер и длительность — в «Размере ролика H3»."
template.builtin-h3-turbo.name = "H3: Turbo (6 шагов)"
template.builtin-h3-turbo.desc = "Тот же граф, что Text to Video, под Turbo LoRA: 6 шагов без CFG. Укажите файл Turbo LoRA (minimax_h3_turbo…safetensors) в поле LoRA «Модели H3» — без неё на 6 шагах будет рябь."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Оживление картинки: файл в «Первый кадр» кодировщика H3 (модель видит его как <Picture 1>, сэмплер держит его первым кадром). Размер ролика задайте под пропорции картинки."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Переход между двумя кадрами: файлы в «Первый кадр» и «Последний кадр» кодировщика H3 — модель держит якоря только на первом и последнем кадре."
template.builtin-h3-ref2va.name = "H3: Референсы в видео"
template.builtin-h3-ref2va.desc = "Видео по референсам (модель Ref2VA): до 9 картинок, 3 видео и 3 звуков, всего до 12, — файлы по строке в ноде «Список». Порядок задаёт метки <Picture i> / <Video k> / <Audio j>, на них ссылается промпт."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Промпт → Кодировщик LTX (Gemma) + NAG → Stage1 → Апскейл ×2 → Stage2 → декодеры видео и звука → Наложение звука → mp4 и плеер. Модель — distilled LTX-2.3 из библиотеки службы (dev-модели служба добавит distilled-LoRA)."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Картинка (файл → Кадр-условие, кадр 0) + промпт → Stage1 → Апскейл ×2 → Stage2 (кадр держится на обеих стадиях) → декодеры → Наложение звука → mp4 и плеер."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Исходный ролик (файл) + промпт → Retake LTX: заново только отрезок [с, по] секунд, остальное как было → декодеры → Наложение звука → mp4 и плеер. Одна стадия, без апскейла."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Образец (файл ролика) задаёт структуру или движение, промпт — содержание → IC-LoRA LTX (сигнал: как есть, контуры Canny или глубина) → декодеры → mp4 и плеер. Адаптер — поле LoRA «Модели LTX» (union / motion или файл)."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Ролик с лицом + новая речь (файлы) → LipDub LTX: губы под речь, обе стадии сразу → декодеры → mp4 и плеер. Адаптер lipdub в поле LoRA «Модели LTX»."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Звук (файл) задаёт дорожку, промпт — сцену → Видео по звуку LTX (звук заморожен на обеих стадиях) → декодеры → Наложение звука → mp4 и плеер."

