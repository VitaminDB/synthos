settings.general.hf_concurrent.desc = "동시에 다운로드할 파일 수입니다. 나머지는 대기열에서 기다립니다."
settings.general.hf_segments = "파일당 세그먼트 수"
settings.general.hf_segments.desc = "파일을 N개의 HTTP-Range 세그먼트로 나누어 병렬로 다운로드합니다. 큰 샤드의 속도를 높입니다."
settings.general.hf_speed_limit = "속도 제한(MB/s)"
settings.general.hf_speed_limit.desc = "모든 다운로드와 세그먼트에 적용되는 전체 상한입니다. 0 = 제한 없음."
settings.general.hf_skip_formats = "onnx/bin/fp32 건너뛰기"
settings.general.hf_skip_formats.desc = "\"모두 다운로드\"는 호환되지 않거나 용량이 큰 형식(onnx, openvino, fp32, .bin)을 건너뜁니다. 파일별 \"다운로드\" 버튼은 모든 형식을 받아옵니다."
settings.general.hf_gguf = "GGUF 지원"
settings.general.hf_gguf.desc = "HuggingFace 페이지에서 GGUF 모델 검색·다운로드와 파일 목록에서 바로 .gguf → .syn 변환을 활성화합니다. 꺼져 있으면 GGUF는 검색도 다운로드도 되지 않습니다."
