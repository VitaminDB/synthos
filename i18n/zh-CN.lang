template.builtin-empty.name = "空白"
template.builtin-empty.desc = "空白画布——从零开始。"
template.builtin-simple-add.name = "简单加法"
template.builtin-simple-add.desc = "数字 + 数字 → 加法 → 输出。纯粹的算术运算。"
template.builtin-audio-playback.name = "音频播放"
template.builtin-audio-playback.desc = "音频文件 → 音频播放器。打开一个 WAV 文件并点击播放。"
template.builtin-voice-recording.name = "语音录制"
template.builtin-voice-recording.desc = "录音 → 音频播放器。录制你的声音并立即回放。"
template.builtin-audio-effects-chain.name = "音频效果链"
template.builtin-audio-effects-chain.desc = "录音 → 增益 → 滤波器 → 混响 → 播放器。录制你的声音，实时听到经过效果处理的结果。"
template.builtin-save-to-file.name = "保存录音"
template.builtin-save-to-file.desc = "录音 → 保存到文件。将麦克风输入录制为 WAV 文件（PCM 16-bit）。"
template.builtin-mix-two-sources.name = "混合两个音源"
template.builtin-mix-two-sources.desc = "音频文件 + 音频文件 → 混音器（2 个音源）→ 音频播放器。用于混合两条音轨的基础模板。"
template.builtin-mix-mic-and-file.name = "麦克风 + 文件"
template.builtin-mix-mic-and-file.desc = "录音 + 音频文件 → 混音器 → 音频播放器。卡拉 OK 场景：人声叠加伴奏。"
template.builtin-voice-clone-voxcpm.name = "VoxCPM：声音克隆"
template.builtin-voice-clone-voxcpm.desc = "参考声音（音频文件）+ 文本 → VoxCPM2 TTS（从 ref_audio 克隆）→ 音频播放器与保存到文件。打开一段带有声音样本的短 WAV，输入文本，将 Syn 检查点节点指向 VoxCPM 的 .syn 模型，然后点击运行。"
template.builtin-voice-clone-omnivoice.name = "OmniVoice：声音克隆"
template.builtin-voice-clone-omnivoice.desc = "参考声音（音频文件）→ GigaAM ASR（自动转写 → 参考文本）+ 文本 → OmniVoice TTS（从 ref_audio 以 Clone 模式克隆）→ 音频播放器与保存到文件。打开一段带有声音样本的 WAV，输入文本，将 Syn 检查点节点分别指向 .syn 模型：用于 ASR 的 GigaAM（gigaam-v3.syn）和用于 TTS 的 OmniVoice（omnivoice.syn），然后点击运行。合成前可以在文本查看中编辑转写结果。"
template.builtin-vibevoice-dialogue.name = "VibeVoice：双人对话"
template.builtin-vibevoice-dialogue.desc = "一段按「Speaker 1: …」/「Speaker 2: …」格式书写的脚本，加上两段短 WAV 声音样本 → VibeVoice 合成一段连续的 24 kHz 对话音轨。将 Syn 检查点节点指向 vibevoice-1.5b.syn，然后点击运行。"
template.builtin-vibevoice-single.name = "VibeVoice：单人声音克隆"
template.builtin-vibevoice-single.desc = "一段 WAV 声音样本 + 文本 → VibeVoice 朗读全部内容（该模型可保持长达数十分钟的上下文）。在 Syn 检查点节点中使用 vibevoice-1.5b.syn 或 vibevoice-7b.syn。"
template.builtin-vibevoice-llm-podcast.name = "VibeVoice：根据主题生成播客（LLM → 语音）"
template.builtin-vibevoice-llm-podcast.desc = "主题 → LLM 撰写按「Speaker N: …」格式的脚本 → 文本查看（可手动编辑）→ VibeVoice 用两个声音朗读 → 播放器与保存。需要两个 Syn 检查点节点：一个 LLM 包和 vibevoice-*.syn。"
template.builtin-acestep-text2music.name = "ACE-Step：文本转音乐"
template.builtin-acestep-text2music.desc = "检查点 + 标签/歌词 → 生成（text2music）→ 播放器。基础的文本转音乐生成。"
template.builtin-acestep-retake.name = "ACE-Step：重录"
template.builtin-acestep-retake.desc = "使用相同标签生成曲目的变体（混合两个噪声种子）。Retake variance 用于控制变化的强度；不需要源音频。"
template.builtin-acestep-repaint.name = "ACE-Step：重绘"
template.builtin-acestep-repaint.desc = "重新生成源音频中 [start,end] 区间的内容（区间之外保留原始音频）。⚠ 请将 Duration 设为源音频的长度。"
template.builtin-acestep-extend.name = "ACE-Step：延长"
template.builtin-acestep-extend.desc = "延长音频：保留原始部分，生成新的尾段。⚠ 请将 Duration 设为大于源音频长度，区间为新增部分（start = 源长度，end = -1）。"
template.builtin-acestep-edit.name = "ACE-Step：编辑"
template.builtin-acestep-edit.desc = "将源音频按新提示词进行变形（SDEdit：加噪至 n_max → 去噪）。n_max=0 表示不变，越接近 1 变化越强。⚠ Duration 需等于源音频长度。"
template.builtin-acestep-cover.name = "ACE-Step：翻唱"
template.builtin-acestep-cover.desc = "翻唱：源音频作为 DiT 上下文，标签设定新的风格/乐器。⚠ Duration 需等于源音频长度。"
template.builtin-acestep-extract.name = "ACE-Step：提取"
template.builtin-acestep-extract.desc = "从混音中提取音轨：源音频作为 DiT 上下文，标签指定要提取的内容。⚠ Duration 需等于源音频长度。"
template.builtin-h3-text-to-video.name = "H3：文本转视频 + 音频"
template.builtin-h3-text-to-video.desc = "提示词 → Qwen3-VL 文本编码器 → 采样器（视频与音频联合去噪）→ VAE 解码 + 音频解码 → mp4 与播放器。将检查点指向 MiniMax-H3 的 .syn 包，编码器会从该包中自动获取。原始管线：20 步，CFG 5——采样器的默认值。"
template.builtin-h3-turbo.name = "H3：Turbo（6 步）"
template.builtin-h3-turbo.desc = "与「文本转视频」相同的图，但针对 Turbo LoRA 做了调优：6 步，无 CFG（已在本模板的采样器中设置）。将检查点的 LoRA 字段指向 minimax_h3_turbo_v4_step600_ema.safetensors——否则 6 步会产生带噪闪烁。"
template.builtin-h3-first-frame.name = "H3：首帧转视频"
template.builtin-h3-first-frame.desc = "让静态图像「活」起来：关键帧节点的「first frame」插槽会同时输入到文本编码器（在提示词中表现为 <Picture 1>）和采样器（经 VAE 编码后进入条件）。请将 AV 潜变量的分辨率设置为与源图像的宽高比一致。"
template.builtin-h3-first-last.name = "H3：首尾帧"
template.builtin-h3-first-last.desc = "两帧之间的过渡。在第二个关键帧节点上选择「last frame」插槽——该模型仅支持在首帧和尾帧设置锚点，组装布局时会拒绝中间锚点。"
template.builtin-ltx-text-to-video.name = "LTX：文本转视频"
template.builtin-ltx-text-to-video.desc = "提示词 → 文本编码器（Gemma）→ 采样器阶段 1（A/V、NAG）→ 放大 ×2 → 阶段 2 精修 → VAE 解码 + 音频解码 → 保存视频（mp4）与视频播放器（帧+音频取自内存，与保存并行）。在检查点节点中指向 LTX-2.3、Gemma 和放大器——可以是模型目录中的 .syn 包（或 .safetensors + Gemma 的 HF 目录）。检查点必须是蒸馏版（ltx-2.3-22b-distilled-*）：各阶段按照蒸馏版的 8+3 步调度运行，使用 dev 检查点会产生模糊的视频。"
template.builtin-ltx-image-to-video.name = "LTX：图像转视频"
template.builtin-ltx-image-to-video.desc = "图像（第 0 帧）+ 提示词 → 文本编码器 → 采样器阶段 1（A/V、图像条件、NAG）→ 放大 ×2 → 阶段 2 精修 → VAE 解码 + 音频解码 → 视频播放器 / 保存。在检查点中指向 LTX-2.3、Gemma 和放大器；在 LTX 图像中指向图片。"
template.builtin-ltx-retake.name = "LTX：重录"
template.builtin-ltx-retake.desc = "源视频（LTX 视频输入）+ 提示词 → 文本编码器 → 重录（重新生成 [start,end] 秒区间，其余部分保持冻结）→ VAE 解码 + 音频解码 → 视频播放器 / 保存。单阶段（无放大）。在检查点中指向 LTX-2.3 和 Gemma；在视频输入中指向视频。"
template.builtin-ltx-ic-lora.name = "LTX：IC-LoRA"
template.builtin-ltx-ic-lora.desc = "参考视频（LTX 视频输入）决定结构/运动，提示词决定内容 → 文本编码器 → IC-LoRA（附加参考控制）→ VAE 解码 + 音频解码 → 视频播放器 / 保存。在检查点中指向 LTX-2.3、Gemma 和 IC-LoRA 适配器（LoRA 字段）；在视频输入中指向参考视频。"
template.builtin-ltx-lipdub.name = "LTX：对口型"
template.builtin-ltx-lipdub.desc = "参考视频（人脸）+ 语音（音频输入）→ 使口型与语音同步：文本编码器 → 对口型（阶段 1 的 A/V 附加参考+音频 → 放大 → 阶段 2 精修）→ VAE 解码 + 音频解码 → 视频播放器 / 保存。在检查点中指向 LTX-2.3、Gemma、放大器和对口型专用的 IC-LoRA（LoRA 字段）。"
template.builtin-ltx-a2v.name = "LTX：音频转视频"
template.builtin-ltx-a2v.desc = "音频（音频输入）固定音轨，提示词决定场景 → 文本编码器 → 音频转视频（阶段 1 在音频冻结的情况下对视频去噪 → 放大 ×2 → 阶段 2 精修）→ VAE 解码 + 音频解码 → 视频播放器 / 保存。在检查点中指向 LTX-2.3、Gemma 和放大器；在音频输入中指向声音。"

