template.builtin-flux-image-to-image.desc = "Bild → VAE Encode → Sampler mit Denoise 0.6 → VAE Decode → PNG. Je kleiner Denoise, desto näher am Original; 1.0 zeichnet in der Bildgröße neu."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → LLM-Encoder (Mistral-24B bei dev, Qwen3 bei klein) → Sampler (Schritte je Modell: dev 50, klein 4) → VAE Decode → PNG. Im Checkpoint flux.2-dev.syn, flux.2-klein-4b.syn oder flux.2-klein-9b.syn wählen; was nicht in den VRAM passt, wird gestreamt."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Bild → Reference → Sampler zusammen mit einer Bearbeitungsanweisung → PNG in Originalgröße (bis 1 MP). Schreiben Sie, was sich ändern und was bleiben soll."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Bild → VAE Encode → Sampler mit denoise 0.7 → VAE Decode → PNG. Je kleiner denoise, desto näher an Komposition und Farben des Originals; für Bearbeitung per Anweisung die Vorlage Edit Image."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Zwei Bilder → Reference → Reference (verkettet) → Sampler: Figur, Objekt oder Stil aus einem Bild in der Szene des anderen. Im Prompt „image 1“, „image 2“ in Kettenreihenfolge."
template.builtin-ltx-flux-keyframe.name = "LTX: FLUX-Bild zu Video"
template.builtin-ltx-flux-keyframe.desc = "FLUX zeichnet das erste Bild nach dem Prompt (16:9, 1344×768) → LTX Image → LTX-2.3 Image-to-Video mit Ton. Zwei Prompts: oben das Bild, unten, was im Video passiert. In FLUX Checkpoint flux.1-dev.syn angeben, in LTX Checkpoint Checkpoint, Gemma und Upscaler."
template.builtin-h3-flux-keyframe.name = "H3: FLUX-Bild zu Video"
template.builtin-h3-flux-keyframe.desc = "FLUX zeichnet das erste Bild (16:9, 1344×768) → H3 Keyframe → MiniMax-H3-Video mit Ton ab diesem Bild. Oberer Prompt: das Bild, unterer: Handlung und Ton im H3-Format. In FLUX Checkpoint flux.1-dev.syn angeben, in H3 Checkpoint das MiniMax-H3-Bundle."
