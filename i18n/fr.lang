settings.ai_models.acestep_xl = "Bundle Encoder/DiT (xl-base ou xl-turbo)"
settings.ai_models.acestep_xl.desc = "Un bundle `.syn` partagé avec un DiT à 32 couches, un TextProjector, un LyricEncoder à 8 couches, un TimbreEncoder à 4 couches, NullConditionEmb, FSQ et AudioTokenDetokenizer. L'un de `acestep_v15_xl_base.syn` (qualité complète) ou `acestep_v15_xl_turbo.syn` (turbo 8 pas). Utilisé par les nœuds TextEncoder/LyricEncoder/TimbreEncoder/Sampler/ArLm."
