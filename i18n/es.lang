template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Lienzo en blanco: empiece desde cero."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Aritmética pura."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Abra un archivo WAV y pulse Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Grabe su voz y reprodúzcala al instante."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Grabe su voz y escúchela procesada con efectos en tiempo real."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Graba el micrófono en un archivo WAV (PCM de 16 bits)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 fuentes) → Audio Player. Plantilla básica para mezclar dos pistas."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Escenario de karaoke: voz sobre una pista de acompañamiento."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Voz de referencia (Audio File) + texto (Text) → VoxCPM2 TTS (clona a partir de ref_audio) → Audio Player y Save to File. Abra un WAV corto con una muestra de voz, escriba el texto, apunte el nodo Syn Checkpoint al modelo .syn de VoxCPM y pulse Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Voz de referencia (Audio File) → GigaAM ASR (transcripción automática → ref text) + texto (Text) → OmniVoice TTS (modo Clone a partir de ref_audio) → Audio Player y Save to File. Abra un WAV con una muestra de voz, escriba el texto, apunte los nodos Syn Checkpoint a los modelos .syn: GigaAM (gigaam-v3.syn) para ASR y OmniVoice (omnivoice.syn) para TTS, y pulse Run. La transcripción en Text View se puede editar antes de la síntesis."
template.builtin-vibevoice-dialogue.name = "VibeVoice: two-voice dialogue"
template.builtin-vibevoice-dialogue.desc = "Un guion con formato «Speaker 1: …» / «Speaker 2: …» más dos muestras de voz WAV cortas → VibeVoice sintetiza una pista de diálogo continua a 24 kHz. Apunte el nodo Syn Checkpoint a vibevoice-1.5b.syn y pulse Run."
template.builtin-vibevoice-single.name = "VibeVoice: single voice clone"
template.builtin-vibevoice-single.desc = "Una muestra de voz WAV + texto → VibeVoice narra todo el texto (el modelo mantiene el contexto durante decenas de minutos). Use vibevoice-1.5b.syn o vibevoice-7b.syn en el nodo Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast from a topic (LLM → voice)"
template.builtin-vibevoice-llm-podcast.desc = "Tema → el LLM escribe un guion en líneas «Speaker N: …» → Text View (editable a mano) → VibeVoice lo narra con dos voces → reproductor y guardado. Requiere dos nodos Syn Checkpoint: un bundle de LLM y vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → reproductor. Generación básica de música a partir de texto."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Una variación de la pista con las mismas tags (una mezcla de dos seeds de ruido). Retake variance controla la fuerza de la variación; no se necesita audio de origen."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regenera la región [start,end] del audio de origen (fuera de la región se conserva el original). ⚠ Ajuste Duration a la duración del audio de origen."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Extiende el audio: se conserva el original y se genera una nueva cola. ⚠ Ajuste Duration por encima de la duración de origen; región = la parte nueva (start = duración de origen, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Transforma el audio de origen hacia un nuevo prompt (SDEdit: re-ruido hasta n_max → denoise). n_max=0 ⇒ sin cambios, más cerca de 1 ⇒ más fuerte. ⚠ Duration = duración del origen."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Versión (cover): el audio de origen → contexto DiT, las tags fijan el nuevo estilo/instrumentos. ⚠ Duration = duración del origen."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Extrae un stem de la mezcla: el audio de origen → contexto DiT, las tags indican qué extraer. ⚠ Duration = duración del origen."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (denoising conjunto de vídeo y audio) → VAE Decode + Audio Decode → mp4 y reproductor. Apunte Checkpoint al bundle .syn de MiniMax-H3; el encoder se toma del bundle. Pipeline original: 20 pasos, CFG 5 — valores por defecto del Sampler."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "El mismo grafo que Text to Video, pero ajustado para el Turbo LoRA: 6 pasos, sin CFG (fijado en el Sampler de esta plantilla). Apunte el campo LoRA de Checkpoint a minimax_h3_turbo_v4_step600_ema.safetensors; sin él, 6 pasos producirán parpadeo con ruido."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Da vida a una imagen: el Keyframe (slot «first frame») alimenta tanto al Text Encoder (como <Picture 1> en la presentación del prompt) como al Sampler (codificado por VAE en el conditioning). Ajuste la resolución del AV-latent a la relación de aspecto del origen."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Una transición entre dos fotogramas. En el segundo nodo Keyframe, elija el slot «last frame»: el modelo solo admite anclas en el primer y el último fotograma; un ancla intermedia se rechaza al ensamblar el layout."
template.builtin-h3-ref2va.name = "H3: Referencias a vídeo"
template.builtin-h3-ref2va.desc = "Vídeo a partir de referencias (checkpoint Ref2VA): hasta 9 imágenes, 3 vídeos y 3 clips de audio, 12 en total, en el nodo H3 References. El orden de la lista define las etiquetas <Picture i> / <Video k> / <Audio j>: el nodo las muestra en cada fila y el prompt se refiere a ellas. El prompt tiene seis secciones (subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape, non_diegetic_music). Checkpoint necesita un paquete Ref2VA: FL2VA no entiende referencias."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) y un reproductor de vídeo (fotogramas+audio desde memoria, en paralelo con Save). En el nodo Checkpoint, apunte a LTX-2.3, Gemma y el upscaler — bundles .syn del directorio de modelos (o .safetensors + el directorio HF de Gemma). El checkpoint debe ser el distilado (ltx-2.3-22b-distilled-*): las etapas siguen el programa distilado de 8+3 pasos, y un checkpoint dev producirá un vídeo borroso."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Imagen (fotograma 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → reproductor de vídeo / Save. En Checkpoint, apunte a LTX-2.3, Gemma y el upscaler; en LTX Image, apunte a la imagen."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Vídeo de origen (LTX Video Input) + prompt → Text Encoder → Retake (regenera la región [start,end] en segundos, el resto queda congelado) → VAE Decode + Audio Decode → reproductor de vídeo / Save. Una sola etapa (sin upscale). En Checkpoint, apunte a LTX-2.3 y Gemma; en Video Input, apunte al vídeo."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Un vídeo de referencia (LTX Video Input) define la estructura/movimiento, el prompt define el contenido → Text Encoder → IC-LoRA (añade ref-control) → VAE Decode + Audio Decode → reproductor de vídeo / Save. En Checkpoint, apunte a LTX-2.3, Gemma y el adaptador IC-LoRA (campo LoRA); en Video Input, apunte al vídeo de referencia."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Un vídeo de referencia (rostro) + voz (Audio Input) → sincronización labial con la voz: Text Encoder → Lipdub (stage1 A/V añade ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → reproductor de vídeo / Save. En Checkpoint, apunte a LTX-2.3, Gemma, el upscaler y el IC-LoRA de lipdub (campo LoRA)."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "El audio (Audio Input) fija la pista de sonido, el prompt define la escena → Text Encoder → A2V (stage1 video-denoise con el audio congelado → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → reproductor de vídeo / Save. En Checkpoint, apunte a LTX-2.3, Gemma y el upscaler; en Audio Input, apunte al sonido."

