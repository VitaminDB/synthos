nav.training = "トレーニング"
training.title = "トレーニング"
training.subtitle = "LoRA アダプターで言語モデルをファインチューニング"
training.overview.nav = "仕組み"
training.overview.lead = "LoRA アダプターはモデルの重みに加える小さな追加部分（数十〜数百 MB）で、文体や回答形式、専門分野をモデルに教えます。モデル自体は変わりません。アダプターはオン・オフでき、1 つのモデルに複数持たせることもできます。トレーニングは AI サービスで実行されるため、Synthos を閉じてもジョブは続きます。"
training.overview.step1.title = "データセットを作成"
training.overview.step1.text = "対話の例：ユーザーの質問と、モデルに覚えさせたい回答。良質な例が百〜数千件あれば十分です。データセットはモデルライブラリの datasets フォルダーに置かれます。既存の JSONL をそこに置くか、ここで作成・編集できます。"
training.overview.step2.title = "トレーニングを開始"
training.overview.step2.text = "モデルとデータセットを選ぶだけで、その他は適切な既定値が使われます。量子化済みモデルはそのままトレーニングできます（QLoRA）。ベースは固定され、アダプターだけが学習します。進捗には損失曲線、速度、残り時間が表示されます。"
training.overview.step3.title = "アダプターを有効化"
