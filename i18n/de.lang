template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Bild → Bild zu Latent → Sampler mit Stärke 0,7 → Bild-Decoder → PNG. Geringere Stärke bleibt näher am Original; für Bearbeitung per Anweisung die Vorlage Edit Image verwenden."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Kurzer Prompt → ein LLM erweitert ihn nach den Vorgaben von Black Forest Labs (Details, Licht, Materialien, Text in Anführungszeichen) → Text View (bearbeitbar) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Zwei Bilder → Referenzen → Referenzen (verkettet) → Sampler: eine Figur, ein Objekt oder ein Stil aus einem Bild in der Szene des anderen. Im Prompt als \"image 1\", \"image 2\" in Kettenreihenfolge bezeichnen."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Bild → Referenzen (für Encoder und Sampler sichtbar) + Bearbeitungsanweisung → Sampler (true CFG 4) → PNG mit ~1 MP in den Originalproportionen. Modell: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Zwei Bilder → Referenzen → Referenzen (verkettet) → Encoder und Sampler: eine Person, ein Objekt oder ein Stil aus einem Bild in der Szene des anderen. Nur Qwen-Image-Edit-2509/2511; im Prompt \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Prompt-Encoder (Qwen3-VL) → Sampler (40 Schritte, ohne CFG, KV-Cache) → Bild-Decoder → PNG. Größe im Leeren Latent (Vielfache von 32; nativ 1024² und 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Bild → Referenzen (an Encoder und Sampler) + Bearbeitungsanweisung → Sampler → PNG in den Originalproportionen. Transparente PNGs behalten ihren Alphakanal."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Zwei Bilder → Referenzen → Referenzen (verkettet, bis 10) → Encoder und Sampler. Im Prompt <image1>, <image2> in Kettenreihenfolge; Größe im Leeren Latent."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Sticker, Logo oder freigestelltes Objekt ohne Hintergrund: Prompt im Format der Modellkarte (\"This is an RGBA image with transparency … the background is transparent\") → PNG mit Alphakanal."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Kurzer Prompt → ein LLM schreibt ihn nach Qwens Prompt Enhancer zu einer detaillierten Bildbeschreibung um → Text View (bearbeitbar) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt und Negativ-Prompt → Prompt-Encoder (CLIP-L + bigG) → Sampler (30 Schritte, CFG 5) → Bild-Decoder → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Bild → Bild zu Latent → Sampler mit Stärke 0,6 → Bild-Decoder → PNG (bis 1 MP, Seiten Vielfache von 64). Geringere Stärke bleibt näher am Original."
template.builtin-ltx-flux-keyframe.name = "LTX: FLUX-Bild zu Video"
template.builtin-ltx-flux-keyframe.desc = "FLUX zeichnet das erste Bild aus einem Prompt (16:9, 1344×768) → LTX-Bedingungsbild → LTX-2.3 Bild zu Video mit Ton. Oberer Prompt: was im Bild ist; unterer: was im Video passiert."
template.builtin-h3-flux-keyframe.name = "H3: FLUX-Bild zu Video"
template.builtin-h3-flux-keyframe.desc = "FLUX zeichnet das erste Bild (16:9, 1344×768) → erstes Bild des H3-Encoders → MiniMax-H3-Video mit Ton daraus. Oberer Prompt: das Bild; unterer: Handlung und Ton im H3-Format."

