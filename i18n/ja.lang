template.builtin-flux2-llm-upsampling.desc = "短いプロンプト → LLM が Black Forest Labs のガイドに沿って展開（ディテール、光、素材、引用テキスト）→ テキスト表示（編集可）→ FLUX.2 → PNG。"
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "2 枚の画像 → 参照画像 → 参照画像（連結）→ サンプラー：一方の画像の人物・物・スタイルをもう一方のシーンに配置。連結順に \"image 1\"、\"image 2\" と呼びます。"
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "画像 → 参照画像（エンコーダーとサンプラーが参照）+ 編集指示 → サンプラー（true CFG 4）→ 元の縦横比の約 1 MP の PNG。モデル：Qwen-Image-Edit / 2511。"
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "2 枚の画像 → 参照画像 → 参照画像（連結）→ エンコーダーとサンプラー：一方の画像の人物・物・スタイルをもう一方のシーンへ。Qwen-Image-Edit-2509/2511 のみ。\"Picture 1\"、\"Picture 2\" と呼びます。"
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "プロンプト → プロンプトエンコーダー（Qwen3-VL）→ サンプラー（40 ステップ、CFG なし、KV キャッシュ）→ 画像デコーダー → PNG。サイズは空のレイテントで指定（32 の倍数、ネイティブは 1024² と 2048²）。"
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "画像 → 参照画像（エンコーダーとサンプラーへ）+ 編集指示 → サンプラー → 元の縦横比の PNG。透過 PNG はアルファを保持します。"
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "2 枚の画像 → 参照画像 → 参照画像（連結、最大 10）→ エンコーダーとサンプラー。連結順に <image1>、<image2> と呼びます。サイズは空のレイテントで指定。"
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "背景なしのステッカー、ロゴ、切り抜きオブジェクト：モデルカード形式のプロンプト（\"This is an RGBA image with transparency … the background is transparent\"）→ アルファ付き PNG。"
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "短いプロンプト → LLM が Qwen の Prompt Enhancer に沿って詳細なショット説明に書き換え → テキスト表示（編集可）→ Qwen-Image 2.1 → PNG。"
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "プロンプトとネガティブ → プロンプトエンコーダー（CLIP-L + bigG）→ サンプラー（30 ステップ、CFG 5）→ 画像デコーダー → 1024² の PNG。"
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "画像 → 画像をレイテントへ → 強度 0.6 のサンプラー → 画像デコーダー → PNG（最大 1 MP、辺は 64 の倍数）。強度を下げるほど元画像に近くなります。"
template.builtin-ltx-flux-keyframe.name = "LTX：FLUX のフレームから動画"
template.builtin-ltx-flux-keyframe.desc = "FLUX がプロンプトから最初のフレームを描画（16:9、1344×768）→ LTX 条件フレーム → 音声付き LTX-2.3 画像から動画。上のプロンプト：フレームの内容、下：動画で起きること。"
template.builtin-h3-flux-keyframe.name = "H3：FLUX のフレームから動画"
template.builtin-h3-flux-keyframe.desc = "FLUX が最初のフレームを描画（16:9、1344×768）→ H3 エンコーダーの最初のフレーム → そこから MiniMax-H3 の音声付き動画。上のプロンプト：フレーム、下：H3 形式の動きと音。"

