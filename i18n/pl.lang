template.builtin-flux-text-to-image.name = "FLUX: tekst na obraz"
template.builtin-flux-text-to-image.desc = "Opis → Koder opisu → Sampler (28 kroków, guidance domyślnie 3,5) → Dekoder obrazu → PNG. Model: FLUX.1 z biblioteki usługi; rozmiar w węźle Pusty latent."
template.builtin-flux-image-to-image.name = "FLUX: obraz na obraz"
template.builtin-flux-image-to-image.desc = "Obraz → Obraz w latent → Sampler z siłą 0,6 → Dekoder obrazu → PNG. Mniejsza siła trzyma się bliżej źródła; 1 rysuje od nowa w rozmiarze obrazu."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Opis → Koder opisu (Mistral-24B dla dev, Qwen3 dla klein) → Sampler (kroki modelu: dev 50, klein 4) → Dekoder obrazu → PNG. Model: FLUX.2 dev/klein z biblioteki usługi."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Obraz → Referencje → Sampler z poleceniem edycji → PNG w rozmiarze źródła (do 1 MP). Napisz, co zmienić, a co zachować."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Obraz → Obraz w latent → Sampler z siłą 0,7 → Dekoder obrazu → PNG. Mniejsza siła trzyma się bliżej źródła; do edycji poleceniem użyj Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Krótki opis → LLM rozwija go według wskazówek Black Forest Labs (szczegóły, światło, materiały, tekst w cudzysłowie) → Podgląd tekstu (edytowalny) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Dwa obrazy → Referencje → Referencje (łańcuch) → Sampler: postać, obiekt lub styl z jednego obrazu przeniesiony do sceny drugiego. Odwołuj się do nich jako \"image 1\", \"image 2\" w kolejności łańcucha."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Obraz → Referencje (widziane przez koder i sampler) + polecenie edycji → Sampler (true CFG 4) → PNG ~1 MP w proporcjach źródła. Model: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Dwa obrazy → Referencje → Referencje (łańcuch) → koder i sampler: osoba, obiekt lub styl z jednego obrazu w scenie drugiego. Tylko Qwen-Image-Edit-2509/2511; odwołuj się do \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Opis → Koder opisu (Qwen3-VL) → Sampler (40 kroków, bez CFG, pamięć KV) → Dekoder obrazu → PNG. Rozmiar w węźle Pusty latent (wielokrotności 32; natywnie 1024² i 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Obraz → Referencje (do kodera i samplera) + polecenie edycji → Sampler → PNG w proporcjach źródła. Przezroczyste PNG zachowują kanał alfa."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Dwa obrazy → Referencje → Referencje (łańcuch, do 10) → koder i sampler. Odwołuj się do <image1>, <image2> w kolejności łańcucha; rozmiar w węźle Pusty latent."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Naklejka, logo lub wycięty obiekt bez tła: opis w formacie z karty modelu (\"This is an RGBA image with transparency … the background is transparent\") → PNG z kanałem alfa."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Krótki opis → LLM przepisuje go na szczegółowy opis ujęcia według Prompt Enhancer Qwen → Podgląd tekstu (edytowalny) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Opis i negatyw → Koder opisu (CLIP-L + bigG) → Sampler (30 kroków, CFG 5) → Dekoder obrazu → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Obraz → Obraz w latent → Sampler z siłą 0,6 → Dekoder obrazu → PNG (do 1 MP, boki wielokrotnością 64). Mniejsza siła trzyma się bliżej źródła."
template.builtin-ltx-flux-keyframe.name = "LTX: klatka FLUX na wideo"
template.builtin-ltx-flux-keyframe.desc = "FLUX rysuje pierwszą klatkę z opisu (16:9, 1344×768) → Klatka warunkowa LTX → LTX-2.3 obraz na wideo z dźwiękiem. Górny opis: co jest w kadrze; dolny: co dzieje się w wideo."
template.builtin-h3-flux-keyframe.name = "H3: klatka FLUX na wideo"
template.builtin-h3-flux-keyframe.desc = "FLUX rysuje pierwszą klatkę (16:9, 1344×768) → pierwsza klatka węzła Koder H3 → wideo MiniMax-H3 z dźwiękiem na jej podstawie. Górny opis: klatka; dolny: akcja i dźwięk w formacie H3."

