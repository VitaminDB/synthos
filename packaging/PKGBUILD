# Maintainer: Alexeyev Vitaly
pkgname=synthos
# Версия — 0.2.<номер сборки>: она же version в Cargo.toml, она же тег релиза
# v0.2.278, её же показывает титлбар. Патч — сквозной номер сборки. epoch=1 —
# потому что с 20.09 по 23.09 версией был голый номер сборки (268…278), а для
# pacman 278 > 0.2.278: без epoch обновление считалось бы откатом. pkgrel —
# ревизия пакета: растёт, только если тот же код пересобирается под новые
# библиотеки (мажорный ffmpeg), и сбрасывается в 1 вместе с новым pkgver.
epoch=1
pkgver=0.2.281
pkgrel=1
pkgdesc="Synthos — локальная AI-студия: чат с агентом, заметки, node-редактор (video/audio/music/image), редактор кода; NVIDIA sm_80+, модели .syn и GGUF"
license=("MIT" "Apache-2.0")
arch=("x86_64")
url="https://github.com/VitaminDB/synthos"

# Runtime: cpal/alsa, vulkan/wgpu, font-config, libxkbcommon, gtk-портал диалогов через rfd.
# ffmpeg — динамическая линковка через ffmpeg-next (libav*/libsw*). Мажорный
# апдейт ffmpeg меняет soname, поэтому пакет надо пересобирать вслед за ним;
# зависимость указана по soname, чтобы pacman ловил рассинхрон при обновлении.
depends=(
    "alsa-lib"
    "fontconfig"
    "vulkan-icd-loader"
    "libxkbcommon"
    "wayland"
    "gtk3"
    "libavutil.so=61-64"
    "libavcodec.so=63-64"
    "libavformat.so=63-64"
    "libswscale.so=10-64"
    "libswresample.so=7-64"
)
makedepends=(
    "cargo"
    "rust"
    "git"
    "pkgconf"
)

prepare() {
    # Корень workspace — на уровень выше packaging/.
    workspace_root="$(cd "$startdir/.." && pwd)"
    export WORKSPACE_ROOT="$workspace_root"
}

build() {
    # PKGBUILD не запускает cargo сам — компиляция тяжёлая (workspace с synaptix/
    # tree-sitter/ffmpeg, ~10-15 мин), и makepkg без TTY часто прерывают по
    # тайм-ауту. Сборка делается отдельно командой:
    #   cargo build --release -p synthos
    # Здесь только проверяем что бинарь существует.
    if [ ! -x "$WORKSPACE_ROOT/target/release/synthos" ]; then
        error "target/release/synthos не найден — запустите 'cargo build --release -p synthos' перед makepkg"
        return 1
    fi

    # pkgver зашивается в бинарь на этапе компиляции (build.rs → SYNTHOS_VERSION,
    # его показывает титлбар). Если версию подняли уже после сборки, пакет N
    # уедет с бинарём, который показывает N-1 — ловим это по mtime.
    if [ "$startdir/PKGBUILD" -nt "$WORKSPACE_ROOT/target/release/synthos" ]; then
        error "PKGBUILD новее бинаря — pkgrel подняли после сборки; пересоберите 'cargo build --release -p synthos'"
        return 1
    fi
}

package() {
    cd "$WORKSPACE_ROOT"

    install -Dm755 "$WORKSPACE_ROOT/target/release/synthos" "$pkgdir/usr/bin/synthos"

    # .desktop + scalable иконка по freedesktop.org spec.
    install -Dm644 "$startdir/synthos.desktop" \
        "$pkgdir/usr/share/applications/synthos.desktop"
    install -Dm644 "$startdir/synthos.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/synthos.svg"

    # README в /usr/share/doc — опционально, не критично.
    if [ -f "README.md" ]; then
        install -Dm644 "README.md" \
            "$pkgdir/usr/share/doc/$pkgname/README.md"
    fi
}
