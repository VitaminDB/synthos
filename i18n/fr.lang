settings.ai_models.layer_sync.off = "Off — jamais (vitesse max, risque d'OOM sur contexte long)"
settings.ai_models.section.runtime = "Inférence (runtime)"
settings.ai_models.attn = "Mode d'attention (couches full-attention)"
settings.ai_models.attn.desc = "Contrôle le chemin CUDA dans les 16 couches full-attention de Qwen3.6. FA-4 — le plus rapide (decode Split-K + WMMA Tensor Cores au prefill hd=256) : ×1,4 à 5K decode, ×4,3 à 23K decode, ×1,81 à 5K prefill (1262 vs 705 tok/s), ×2,53 à 23K prefill. FA-2 — le même Split-K mais sans WMMA (mma scalaire) — pour le débogage par bisection ou si les Tensor Cores se comportent mal. Off — softmax de référence (OOM à partir de 10K tokens, référence pour les bancs de régression). S'applique instantanément à la réponse suivante, sans rechargement du modèle."
settings.ai_models.cuda_graph = "Decode CUDA-graph (Phase D)"
settings.ai_models.cuda_graph.desc = "Capture d'un pas de decode dans un CUDA Graph et rejeu pour chaque token suivant. Supprime le surcoût par lancement d'environ 140 appels de kernel par token. Gain : ×1,45 sur contexte court (17,8 → 25,8 tok/s), ×1,16 à 23K (19,4 → 22,6 tok/s) — sur contexte long, la bande passante de flash-attention domine sur le surcoût de lancement. Nécessite CUDA. S'applique instantanément à la réponse suivante — un rechargement du modèle n'est nécessaire que si l'appareil a été créé sans flux non par défaut (anciennes builds avant la Phase D — désormais automatique dans `model_registry`)."
settings.ai_models.mtp = "MTP (prédiction multi-token)"
settings.ai_models.mtp.desc = "Décodage spéculatif sur la tête nextn intégrée au modèle : la tête prédit le deuxième token, le modèle principal vérifie les deux en une seule passe forward. Fonctionne uniquement en décodage glouton (temperature = 0) et seulement si le bundle possède des tenseurs `mtp.*` (variante MTP de GGUF). La sortie est bit-identique au décodage normal. Sur RTX 5090 Laptop, NVFP4 : 38,2 → 43,9 tok/s avec un taux d'acceptation des brouillons de 80-84%. Nécessite un rechargement du modèle — les poids de la tête MTP se chargent avec le modèle."
settings.ai_models.dflash = "DFlash (spéculation par blocs, Muse Glimmer)"
settings.ai_models.dflash.desc = "Décodage spéculatif sur un drafter assistant (2,3 Md, 5 couches) : le drafter voit les états cachés de 5 couches du modèle principal et propose un bloc de 15 tokens en une seule passe forward ; le modèle principal vérifie tout le bloc en une passe. Fonctionne uniquement en décodage glouton (temperature = 0) et seulement si le bundle possède un composant `dflash`. La sortie correspond au décodage normal — seuls les tokens confirmés par le modèle principal sont acceptés. Nécessite un rechargement du modèle : les poids du drafter se chargent avec lui (+1,2 Go en NVFP4). Désactivez pour libérer de la VRAM ou comparer les performances."
settings.ai_models.la_fused = "Préparation linear_attn fusionnée (Phase B-1)"
settings.ai_models.la_fused.desc = "Fusionne sigmoid + softplus + 3x repeat_interleave_cast en un seul kernel CUDA (5 → 1 lancement sur chacune des 48 couches linear_attn). Bit-exact par rapport au chemin séparé ; défaut = activé. Sur le modèle 27B, le gain reste dans le bruit de mesure (les kernels de calcul sont plus gros que le surcoût de lancement) — mais cela ne nuit pas et réduit le nombre de nœuds de kernel dans le CUDA graph capturé. Désactivez uniquement pour le débogage par bisection."
settings.ai_models.gdr_fused = "Fusion gated_delta_rule + RmsNorm (Phase B-2)"
settings.ai_models.gdr_fused.desc = "Fusionne le pas SSM et RmsNormGated en un seul kernel : la sortie SSM reste en mémoire partagée au lieu de globale, et la phase RMS s'exécute dans le même bloc. Supprime 8 Ko de trafic lecture+écriture par tête et par token. Nécessite hk == hv (vrai pour Qwen3.6, 128 == 128). Bit-exact ; défaut = activé. Désactivez pour le débogage par bisection."
settings.ai_models.prefill_chunk = "Taille de chunk du prefill"
settings.ai_models.prefill_chunk.desc = "Taille de chunk dans `prefill_chunked`. La valeur par défaut de 1024 offre le débit maximal sur les prompts courts, mais à partir de 10K tokens sur un GPU 24 Go, l'allocation KV de pointe `(B,nh,1024,T) F32 ≈ 660 Mo` en plus de l'anneau KV courant provoque un OOM. Réduire à 64-256 échange -5-10% de vitesse de prefill contre de la marge VRAM. S'applique au prochain appel `generate(...)` sans rechargement."
settings.ai_models.layer_sync = "Synchronisation des couches (mémoire)"
settings.ai_models.layer_sync.desc = "`cudaStreamSynchronize` après chaque couche du décodeur. Sans sync, `cudaMallocAsync` de cudarc conserve les tenseurs intermédiaires du MLP entre les couches dans le pool sans réelle récupération : à prefill chunk=1024, cela ajoute +2-6 Go de VRAM de pointe, ce qui provoque un OOM sur les prompts longs. Auto (par défaut) — sync uniquement quand T > 1 (c.-à-d. les chunks de prefill) : coût nul au decode, ~4 Go libres sur un prefill long. On — sync toujours : -5% decode, -4% prefill, économie de mémoire maximale. Off — jamais : vitesse maximale, risque d'OOM à partir de ~30K tokens. S'applique au prochain appel `forward` sans rechargement."
settings.ai_models.nvfp4_mma = "GEMV mma FP4 natif (Phase E.2)"
settings.ai_models.nvfp4_mma.desc = "Tensor Cores FP4 natifs pour le decode M=1 sur les projections NVFP4 — remplace le chemin cuBLASLt-NVFP4 sur les formes où N+K sont multiples de 64. Disponible uniquement sur Blackwell grand public (sm_120a) ; les GPU plus anciens retombent silencieusement sur cuBLASLt."
settings.ai_models.nvfp4_gemv = "GEMV NVFP4 scalaire (repli Phase E.2)"
settings.ai_models.nvfp4_gemv.desc = "Chemin GEMV scalaire pour le decode M=1 sur les projections NVFP4 (sans Tensor Cores). Désactivé par défaut — cuBLASLt-NVFP4 + Tensor Cores offre un meilleur débit. À activer uniquement pour la bisection de bugs."
settings.ai_models.image_tokens = "Détail des images jointes"
settings.ai_models.image_tokens.desc = "Combien de tokens vision consacrer à une image dans le chat. Un token couvre un patch de 28×28 px, donc 1024 tokens correspondent environ à 896×896 px après smart-resize : une capture d'écran avec un texte d'interface normal se lit en entier. Plus de tokens révèlent les petites polices et les détails des schémas, mais chaque image mord sur le contexte et allonge le prefill (4096 tokens pour une seule photo sont comparables à un article joint). Fonctionne uniquement sur les bundles multimodaux (avec une tour de vision) ; s'applique au prochain message envoyé — sans rechargement du modèle."
settings.ai_models.preset.quality = "Quality — KV en F16, lm_head/embed en F16 (précision maximale)"
settings.ai_models.preset.balance = "Balance — KV F16 + lm_head/embed FP8 (par défaut, 65K sur 24 Go)"
settings.ai_models.preset.vram_saver = "VRAM-Saver — KV F16 + lm_head/embed NVFP4 (VRAM minimale)"
settings.ai_models.preset.custom = "Custom — configuration manuelle"
settings.ai_models.section.preset = "Préréglage"
settings.ai_models.preset = "Politique de quantification intégrée"
settings.ai_models.preset.desc = "Quality — tout en F16 (précision maximale). Balance — backbone NVFP4 + lm_head/embed FP8 : 65K de contexte sur un GPU 24 Go sans perte de qualité (≈ F16). VRAM-Saver — lm_head/embed en NVFP4 pour un minimum de VRAM, mais une baisse de précision notable sur la projection du vocabulaire. Toute modification manuelle d'une liste déroulante ci-dessous bascule le préréglage sur « Custom »."
app.browse = "Parcourir…"
settings.ai_models.section.models_dir = "Répertoire des modèles"
settings.ai_models.models_dir = "Où chercher les modèles (.syn, LoRA, répertoires HF)"
settings.ai_models.models_dir.desc = "Dossier de modèles partagé pour tous les pipelines. L'agent Syn-chat y récupère les chemins des bundles quand il remplit les nœuds checkpoint (pipelines action=list affiche son contenu). Par défaut — ~/Storage/syn_models."
settings.ai_models.weights_storage = "Poids attn/MLP (stockage)"
settings.ai_models.weights_storage.desc = "Format de stockage des poids d'attention et des couches linéaires MLP en VRAM. NVFP4 — la principale économie (~12 Go sur 30 Go), nécessite Blackwell sm_120. FP8 — une alternative sur Hopper/Ada/Blackwell. F16 — sans quantification."
settings.ai_models.compute_dtype = "Dtype de calcul (activations)"
settings.ai_models.compute_dtype.desc = "Précision des activations entre les couches. F16 — le standard GPU. BF16 — plage dynamique plus large, utile pour le prefill de contexte long. F32 — débogage."
settings.ai_models.kv_cache = "Cache KV (couches full-attention)"
settings.ai_models.kv_cache.desc = "Format de stockage des projections K/V entre les pas de decode. FP8 — -50% de VRAM sur le KV (~-2 Go à 13K tokens), une seule échelle partagée par tenseur, déquantifiée avant le matmul. F16 — sans quantification. Auto = dtype de calcul."
settings.ai_models.lm_head = "lm_head (projection du vocabulaire, 2,5 Go en F16)"
settings.ai_models.lm_head.desc = "Couche de sortie sur vocab=248K. F16 — un Linear standard. FP8 E4M3 (balance par défaut) — GEMM FP8 cuBLASLt natif, économise ~1,2 Go, précision ≈ F16. NVFP4 — économise ~1,9 Go via un kernel NVFP4 par blocs, mais avec une dégradation de qualité notable sur la projection du vocabulaire (VRAM-Saver uniquement). Le decode est -10..15% par rapport à F16 à cause du surcoût de quantification FP8."
settings.ai_models.embed_tokens = "embed_tokens (embedding du vocabulaire, 2,5 Go en F16)"
settings.ai_models.embed_tokens.desc = "Table des vecteurs de tokens. F16/BF16/F32 — un Embedding standard (gather depuis la table). FP8 E4M3 (balance par défaut) — octets FP8 empaquetés + échelle par tenseur + kernel de gather personnalisé, économise ~1,2 Go à vocab=248K, précision ≈ F16. NVFP4 (Phase F) — nibbles FP4 empaquetés + échelles par tuile, économise ~1,8 Go, mais la dégradation de qualité sur embed est notable — VRAM-Saver uniquement. Q8_0/Q4_0 pour embed ne sont pas implémentés — repli sur F16."
settings.ai_models.tied_embeddings = "Embeddings liés (lm_head ↔ embed_tokens)"
settings.ai_models.tied_embeddings.desc = "Auto — lit `tie_word_embeddings` dans le config.json du modèle (généralement false pour Qwen3.6 27B). Force On — lm_head réutilise les poids d'embed_tokens (économise tout le lm_head séparé : ~2,4 Go en F16 ou ~0,4 Go en NVFP4) ; sur un checkpoint non lié, cela change la sortie numérique. Force Off — toujours un lm_head séparé. S'applique au prochain rechargement du modèle."
settings.ai_models.ssm_state = "État SSM (Gated DeltaNet)"
settings.ai_models.ssm_state.desc = "État de récurrence à travers les 48 couches linear-attention. F32 par défaut (`mamba_ssm_dtype` de HF). BF16 économise ~48 Mo avec une perte de précision possible sur les longues récurrences."
settings.ai_models.conv_state = "État Conv1d (Gated DeltaNet)"
settings.ai_models.conv_state.desc = "Contexte gauche causal conv1d dans les couches linear_attn. Effet négligeable sur la VRAM (quelques milliers d'éléments par couche), mais influe sur la précision de la mise à jour conv."
