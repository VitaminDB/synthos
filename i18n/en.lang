template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Blank canvas — start from scratch."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Pure arithmetic."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Open a WAV file and hit Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Record your voice and play it back right away."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Record your voice and hear it processed with effects in real time."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Records the microphone to a WAV file (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 sources) → Audio Player. A basic template for mixing two tracks."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. A karaoke scenario: voice over a backing track."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Reference voice (Audio File) + text (Text) → VoxCPM2 TTS (clones from ref_audio) → Audio Player and Save to File. Open a short WAV with a voice sample, enter the text, point the Syn Checkpoint node to the VoxCPM .syn model, and click Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Reference voice (Audio File) → GigaAM ASR (auto-transcript → ref text) + text (Text) → OmniVoice TTS (Clone mode from ref_audio) → Audio Player and Save to File. Open a WAV with a voice sample, enter the text, point the Syn Checkpoint nodes to the .syn models: GigaAM (gigaam-v3.syn) for ASR and OmniVoice (omnivoice.syn) for TTS, then click Run. The transcript in Text View can be edited before synthesis."
template.builtin-vibevoice-dialogue.name = "VibeVoice: two-voice dialogue"
template.builtin-vibevoice-dialogue.desc = "A script formatted as \"Speaker 1: …\" / \"Speaker 2: …\" plus two short WAV voice samples → VibeVoice synthesizes a continuous 24 kHz dialogue track. Point the Syn Checkpoint node to vibevoice-1.5b.syn and click Run."
template.builtin-vibevoice-single.name = "VibeVoice: single voice clone"
template.builtin-vibevoice-single.desc = "One WAV voice sample + text → VibeVoice narrates the whole thing (the model keeps context for tens of minutes). Use vibevoice-1.5b.syn or vibevoice-7b.syn in the Syn Checkpoint node."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast from a topic (LLM → voice)"
template.builtin-vibevoice-llm-podcast.desc = "Topic → the LLM writes a script as \"Speaker N: …\" lines → Text View (editable by hand) → VibeVoice narrates it with two voices → player and save. Needs two Syn Checkpoint nodes: an LLM bundle and vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → player. Basic text-to-music generation."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "A variation of the track with the same tags (a mix of two noise seeds). Retake variance controls the strength of the variation; no source audio is needed."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regenerates the [start,end] region of the source audio (outside the region — the original stays). ⚠ Set Duration to the length of the source audio."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Extends the audio: the original is preserved, a new tail is generated. ⚠ Set Duration greater than the source length, region = the new part (start = source length, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Morphs the source audio toward a new prompt (SDEdit: re-noise up to n_max → denoise). n_max=0 ⇒ no change, closer to 1 ⇒ stronger. ⚠ Duration = length of the source."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: the source audio → DiT context, tags set the new style/instruments. ⚠ Duration = length of the source."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Extracts a stem from the mix: the source audio → DiT context, tags specify what to pull out. ⚠ Duration = length of the source."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (joint video and audio denoising) → VAE Decode + Audio Decode → mp4 and player. Point Checkpoint to the MiniMax-H3 .syn bundle; the encoder is picked up from the bundle. Original pipeline: 20 steps, CFG 5 — the Sampler defaults."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "The same graph as Text to Video, but tuned for the Turbo LoRA: 6 steps, no CFG (set in this template's Sampler). Point the LoRA field of Checkpoint to minimax_h3_turbo_v4_step600_ema.safetensors — without it, 6 steps will produce noisy flicker."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Brings an image to life: the Keyframe (\"first frame\" slot) feeds both the Text Encoder (as <Picture 1> in the prompt presentation) and the Sampler (VAE-encoded into the conditioning). Set the AV-latent resolution to match the source's aspect ratio."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "A transition between two frames. On the second Keyframe node, pick the \"last frame\" slot — the model only supports anchors on the first and last frames; a middle anchor is rejected while the layout is assembled."
template.builtin-h3-ref2va.name = "H3: References to Video"
template.builtin-h3-ref2va.desc = "Video from references (Ref2VA checkpoint): up to 9 images, 3 videos and 3 audio clips, 12 in total, in the H3 References node. The list order sets the <Picture i> / <Video k> / <Audio j> tags — the node shows them on every row, and the prompt refers to them. The prompt has six sections (subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape, non_diegetic_music). Checkpoint needs a Ref2VA bundle: FL2VA does not understand references."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) and a video player (frames+audio from memory, in parallel with Save). In the Checkpoint node, point to the LTX-2.3, Gemma, and upscaler — .syn bundles from the model directory (or .safetensors + the Gemma HF directory). The checkpoint must be the distilled one (ltx-2.3-22b-distilled-*): the stages follow the distilled 8+3-step schedule, and a dev checkpoint will produce a blurry video."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Image (frame 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → video player / Save. In Checkpoint, point to LTX-2.3, Gemma, and the upscaler; in LTX Image, point to the picture."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Source video (LTX Video Input) + prompt → Text Encoder → Retake (regenerates the [start,end] second region, the rest stays frozen) → VAE Decode + Audio Decode → video player / Save. Single-stage (no upscale). In Checkpoint, point to LTX-2.3 and Gemma; in Video Input, point to the video."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "A reference video (LTX Video Input) sets the structure/motion, the prompt sets the content → Text Encoder → IC-LoRA (appends ref-control) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, point to LTX-2.3, Gemma, and the IC-LoRA adapter (LoRA field); in Video Input, point to the reference video."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "A reference video (face) + speech (Audio Input) → lip-sync to the speech: Text Encoder → Lipdub (stage1 A/V appends ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, point to LTX-2.3, Gemma, the upscaler, and the lipdub IC-LoRA (LoRA field)."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Audio (Audio Input) fixes the audio track, the prompt sets the scene → Text Encoder → A2V (stage1 video-denoise with the audio frozen → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, point to LTX-2.3, Gemma, and the upscaler; in Audio Input, point to the sound."

