template.builtin-empty.name = "Vide"
template.builtin-empty.desc = "Canevas vide — pour partir de zéro."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Arithmétique pure."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Ouvrez un fichier WAV et cliquez sur Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Enregistrez votre voix et réécoutez-la aussitôt."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Enregistrez votre voix et entendez-la traitée avec des effets en temps réel."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Enregistre le microphone dans un fichier WAV (PCM 16 bits)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 sources) → Audio Player. Un modèle de base pour mixer deux pistes."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Un scénario karaoké : voix par-dessus une piste d'accompagnement."
template.builtin-voice-clone-voxcpm.name = "VoxCPM : clonage de voix"
template.builtin-voice-clone-voxcpm.desc = "Voix de référence (Audio File) + texte (Text) → VoxCPM2 TTS (clone à partir de ref_audio) → Audio Player et Save to File. Ouvrez un court WAV avec un échantillon de voix, saisissez le texte, pointez le nœud Syn Checkpoint vers le modèle .syn VoxCPM et cliquez sur Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice : clonage de voix"
template.builtin-voice-clone-omnivoice.desc = "Voix de référence (Audio File) → GigaAM ASR (transcription auto → ref text) + texte (Text) → OmniVoice TTS (mode Clone à partir de ref_audio) → Audio Player et Save to File. Ouvrez un WAV avec un échantillon de voix, saisissez le texte, pointez les nœuds Syn Checkpoint vers les modèles .syn : GigaAM (gigaam-v3.syn) pour l'ASR et OmniVoice (omnivoice.syn) pour le TTS, puis cliquez sur Run. La transcription dans Text View peut être corrigée avant la synthèse."
template.builtin-vibevoice-dialogue.name = "VibeVoice : dialogue à deux voix"
template.builtin-vibevoice-dialogue.desc = "Un script au format « Speaker 1 : … » / « Speaker 2 : … » plus deux courts échantillons WAV de voix → VibeVoice synthétise une piste de dialogue continue en 24 kHz. Pointez le nœud Syn Checkpoint vers vibevoice-1.5b.syn et cliquez sur Run."
template.builtin-vibevoice-single.name = "VibeVoice : clonage d'une seule voix"
template.builtin-vibevoice-single.desc = "Un échantillon WAV de voix + texte → VibeVoice narre l'ensemble (le modèle garde le contexte sur des dizaines de minutes). Utilisez vibevoice-1.5b.syn ou vibevoice-7b.syn dans le nœud Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice : podcast à partir d'un sujet (LLM → voix)"
template.builtin-vibevoice-llm-podcast.desc = "Sujet → le LLM écrit un script en lignes « Speaker N : … » → Text View (modifiable à la main) → VibeVoice le narre avec deux voix → lecteur et sauvegarde. Nécessite deux nœuds Syn Checkpoint : un bundle LLM et vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step : Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → lecteur. Génération musicale de base à partir de texte."
template.builtin-acestep-retake.name = "ACE-Step : Retake"
template.builtin-acestep-retake.desc = "Une variation de la piste avec les mêmes tags (un mélange de deux graines de bruit). Retake variance contrôle la force de la variation ; aucun audio source n'est nécessaire."
template.builtin-acestep-repaint.name = "ACE-Step : Repaint"
template.builtin-acestep-repaint.desc = "Régénère la région [start,end] de l'audio source (hors région — l'original reste). ⚠ Réglez Duration sur la longueur de l'audio source."
template.builtin-acestep-extend.name = "ACE-Step : Extend"
template.builtin-acestep-extend.desc = "Prolonge l'audio : l'original est préservé, une nouvelle fin est générée. ⚠ Réglez Duration plus grand que la longueur source, région = la nouvelle partie (start = longueur source, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step : Edit"
template.builtin-acestep-edit.desc = "Fait évoluer l'audio source vers un nouveau prompt (SDEdit : rebruitage jusqu'à n_max → débruitage). n_max=0 ⇒ aucun changement, plus proche de 1 ⇒ plus fort. ⚠ Duration = longueur de la source."
template.builtin-acestep-cover.name = "ACE-Step : Cover"
template.builtin-acestep-cover.desc = "Reprise : l'audio source → contexte DiT, les tags fixent le nouveau style/instruments. ⚠ Duration = longueur de la source."
template.builtin-acestep-extract.name = "ACE-Step : Extract"
template.builtin-acestep-extract.desc = "Extrait une piste du mix : l'audio source → contexte DiT, les tags précisent quoi extraire. ⚠ Duration = longueur de la source."
template.builtin-h3-text-to-video.name = "H3 : texte vers vidéo + audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (débruitage conjoint vidéo et audio) → VAE Decode + Audio Decode → mp4 et lecteur. Pointez Checkpoint vers le bundle .syn MiniMax-H3 ; l'encodeur est repris du bundle. Pipeline d'origine : 20 pas, CFG 5 — valeurs par défaut du Sampler."
template.builtin-h3-turbo.name = "H3 : Turbo (6 pas)"
template.builtin-h3-turbo.desc = "Le même graphe que Text to Video, mais ajusté pour le Turbo LoRA : 6 pas, sans CFG (défini dans le Sampler de ce modèle). Pointez le champ LoRA de Checkpoint vers minimax_h3_turbo_v4_step600_ema.safetensors — sans quoi 6 pas produiront un scintillement bruité."
template.builtin-h3-first-frame.name = "H3 : première image vers vidéo"
template.builtin-h3-first-frame.desc = "Anime une image : le Keyframe (emplacement « première image ») alimente à la fois le Text Encoder (comme <Picture 1> dans la présentation du prompt) et le Sampler (encodé VAE dans le conditionnement). Réglez la résolution du latent AV selon le rapport d'aspect de la source."
template.builtin-h3-first-last.name = "H3 : première + dernière image"
template.builtin-h3-first-last.desc = "Une transition entre deux images. Sur le second nœud Keyframe, choisissez l'emplacement « dernière image » — le modèle ne prend en charge des ancrages que sur la première et la dernière image ; un ancrage intermédiaire est rejeté lors de l'assemblage du layout."
template.builtin-ltx-text-to-video.name = "LTX : texte vers vidéo"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) et un lecteur vidéo (images+audio depuis la mémoire, en parallèle de Save). Dans le nœud Checkpoint, pointez vers LTX-2.3, Gemma et l'upscaler — bundles .syn du répertoire de modèles (ou .safetensors + répertoire HF de Gemma). Le checkpoint doit être le distillé (ltx-2.3-22b-distilled-*) : les étapes suivent le planning distillé 8+3 pas, et un checkpoint dev produira une vidéo floue."
template.builtin-ltx-image-to-video.name = "LTX : image vers vidéo"
template.builtin-ltx-image-to-video.desc = "Image (image 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → lecteur vidéo / Save. Dans Checkpoint, pointez vers LTX-2.3, Gemma et l'upscaler ; dans LTX Image, pointez vers l'image."
template.builtin-ltx-retake.name = "LTX : Retake"
template.builtin-ltx-retake.desc = "Vidéo source (LTX Video Input) + prompt → Text Encoder → Retake (régénère la région [start,end] en secondes, le reste reste figé) → VAE Decode + Audio Decode → lecteur vidéo / Save. Une seule étape (sans upscale). Dans Checkpoint, pointez vers LTX-2.3 et Gemma ; dans Video Input, pointez vers la vidéo."
template.builtin-ltx-ic-lora.name = "LTX : IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Une vidéo de référence (LTX Video Input) fixe la structure/le mouvement, le prompt fixe le contenu → Text Encoder → IC-LoRA (ajoute le ref-control) → VAE Decode + Audio Decode → lecteur vidéo / Save. Dans Checkpoint, pointez vers LTX-2.3, Gemma et l'adaptateur IC-LoRA (champ LoRA) ; dans Video Input, pointez vers la vidéo de référence."
template.builtin-ltx-lipdub.name = "LTX : Lipdub"
template.builtin-ltx-lipdub.desc = "Une vidéo de référence (visage) + parole (Audio Input) → synchronisation labiale sur la parole : Text Encoder → Lipdub (stage1 A/V ajoute ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → lecteur vidéo / Save. Dans Checkpoint, pointez vers LTX-2.3, Gemma, l'upscaler et l'IC-LoRA de lipdub (champ LoRA)."
template.builtin-ltx-a2v.name = "LTX : audio vers vidéo"
template.builtin-ltx-a2v.desc = "L'audio (Audio Input) fixe la piste sonore, le prompt fixe la scène → Text Encoder → A2V (stage1 débruitage vidéo avec audio figé → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → lecteur vidéo / Save. Dans Checkpoint, pointez vers LTX-2.3, Gemma et l'upscaler ; dans Audio Input, pointez vers le son."

