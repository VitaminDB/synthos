template.builtin-flux-text-to-image.name = "FLUX: Text to Image"
template.builtin-flux-text-to-image.desc = "Prompt → Prompt Encoder → Sampler (28 steps, guidance 3.5 by default) → Image Decoder → PNG. Model: FLUX.1 from the service library; size in Empty Latent."
template.builtin-flux-image-to-image.name = "FLUX: Image to Image"
template.builtin-flux-image-to-image.desc = "Image → Image to Latent → Sampler with strength 0.6 → Image Decoder → PNG. Lower strength stays closer to the source; 1 redraws at the image size."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → Prompt Encoder (Mistral-24B for dev, Qwen3 for klein) → Sampler (model steps: dev 50, klein 4) → Image Decoder → PNG. Model: FLUX.2 dev/klein from the service library."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Image → References → Sampler with an edit instruction → PNG at the source size (up to 1 MP). Say what to change and what to keep."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Image → Image to Latent → Sampler with strength 0.7 → Image Decoder → PNG. Lower strength stays closer to the source; for instruction edits use Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Short prompt → an LLM expands it per Black Forest Labs guidance (details, light, materials, quoted text) → Text View (editable) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Two images → References → References (chained) → Sampler: a character, object or style from one image placed in the other's scene. Refer to them as \"image 1\", \"image 2\" in chain order."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Image → References (seen by the encoder and the sampler) + edit instruction → Sampler (true CFG 4) → ~1 MP PNG in the source proportions. Model: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Two images → References → References (chained) → encoder and sampler: a person, object or style from one image in the other's scene. Qwen-Image-Edit-2509/2511 only; refer to \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Prompt Encoder (Qwen3-VL) → Sampler (40 steps, no CFG, KV cache) → Image Decoder → PNG. Size in Empty Latent (multiples of 32; native 1024² and 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Image → References (to the encoder and sampler) + edit instruction → Sampler → PNG in the source proportions. Transparent PNGs keep their alpha."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Two images → References → References (chained, up to 10) → encoder and sampler. Refer to <image1>, <image2> in chain order; size in Empty Latent."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Sticker, logo or cut-out object without background: prompt in the model card format (\"This is an RGBA image with transparency … the background is transparent\") → PNG with alpha."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Short prompt → an LLM rewrites it into a detailed shot description per Qwen's Prompt Enhancer → Text View (editable) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt and negative → Prompt Encoder (CLIP-L + bigG) → Sampler (30 steps, CFG 5) → Image Decoder → 1024² PNG."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Image → Image to Latent → Sampler with strength 0.6 → Image Decoder → PNG (up to 1 MP, sides multiple of 64). Lower strength stays closer to the source."
