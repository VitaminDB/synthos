training.overview.lead = "LoRA адаптері — модель салмақтарына шағын қосымша (ондаған-жүздеген мегабайт), ол модельді стильге, жауап пішіміне немесе пәндік салаға үйретеді. Модельдің өзі өзгермейді: адаптер қосылып-өшіріледі, бір модельде олар бірнешеу болуы мүмкін. Оқыту нейрожелі қызметінде жүреді — Synthos-ты жапсаңыз да, тапсырма жалғаса береді."
training.overview.step1.title = "Деректер жинағын құрыңыз"
