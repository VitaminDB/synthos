settings.ai_models.acestep_xl = "Encoder/DiT-Bundle (xl-base oder xl-turbo)"
settings.ai_models.acestep_xl.desc = "Ein gemeinsames `.syn`-Bundle mit einem 32-schichtigen DiT, TextProjector, einem 8-schichtigen LyricEncoder, einem 4-schichtigen TimbreEncoder, NullConditionEmb, FSQ und AudioTokenDetokenizer. Entweder `acestep_v15_xl_base.syn` (volle Qualität) oder `acestep_v15_xl_turbo.syn` (8-Schritte-Turbo). Wird von den Nodes TextEncoder/LyricEncoder/TimbreEncoder/Sampler/ArLm verwendet."
