template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Tela vuota — inizia da zero."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Aritmetica pura."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Apri un file WAV e premi Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Registra la tua voce e riproducila subito."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Registra la tua voce e ascoltala elaborata con effetti in tempo reale."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Registra il microfono in un file WAV (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 sources) → Audio Player. Un template di base per mixare due tracce."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Uno scenario karaoke: voce su una base musicale."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Voce di riferimento (Audio File) + testo (Text) → VoxCPM2 TTS (clona da ref_audio) → Audio Player e Save to File. Apri un breve WAV con un campione vocale, inserisci il testo, indica il modello .syn di VoxCPM nel nodo Syn Checkpoint e fai clic su Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Voce di riferimento (Audio File) → GigaAM ASR (trascrizione automatica → ref text) + testo (Text) → OmniVoice TTS (modalità Clone da ref_audio) → Audio Player e Save to File. Apri un WAV con un campione vocale, inserisci il testo, indica i modelli .syn nei nodi Syn Checkpoint: GigaAM (gigaam-v3.syn) per l'ASR e OmniVoice (omnivoice.syn) per il TTS, quindi fai clic su Run. La trascrizione in Text View può essere modificata prima della sintesi."
template.builtin-vibevoice-dialogue.name = "VibeVoice: dialogo a due voci"
template.builtin-vibevoice-dialogue.desc = "Uno script nel formato «Speaker 1: …» / «Speaker 2: …» più due brevi campioni vocali WAV → VibeVoice sintetizza una traccia di dialogo continua a 24 kHz. Indica vibevoice-1.5b.syn nel nodo Syn Checkpoint e fai clic su Run."
template.builtin-vibevoice-single.name = "VibeVoice: clone di una singola voce"
template.builtin-vibevoice-single.desc = "Un campione vocale WAV + testo → VibeVoice narra l'intero contenuto (il modello mantiene il contesto per decine di minuti). Usa vibevoice-1.5b.syn o vibevoice-7b.syn nel nodo Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast da un argomento (LLM → voce)"
template.builtin-vibevoice-llm-podcast.desc = "Argomento → l'LLM scrive uno script con righe «Speaker N: …» → Text View (modificabile a mano) → VibeVoice lo narra con due voci → player e salvataggio. Servono due nodi Syn Checkpoint: un bundle LLM e vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → player. Generazione di base da testo a musica."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Una variazione della traccia con gli stessi tag (un mix di due seed di rumore). Retake variance controlla l'intensità della variazione; non serve un audio sorgente."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Rigenera la regione [start,end] dell'audio sorgente (fuori dalla regione resta l'originale). ⚠ Imposta Duration sulla lunghezza dell'audio sorgente."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Estende l'audio: l'originale viene preservato, viene generata una nuova coda. ⚠ Imposta Duration maggiore della lunghezza sorgente, regione = la nuova parte (start = lunghezza sorgente, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Trasforma l'audio sorgente verso un nuovo prompt (SDEdit: re-noise fino a n_max → denoise). n_max=0 ⇒ nessun cambiamento, più vicino a 1 ⇒ effetto più forte. ⚠ Duration = lunghezza della sorgente."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: l'audio sorgente → contesto DiT, i tag impostano il nuovo stile/strumenti. ⚠ Duration = lunghezza della sorgente."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Estrae uno stem dal mix: l'audio sorgente → contesto DiT, i tag specificano cosa estrarre. ⚠ Duration = lunghezza della sorgente."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (denoising congiunto di video e audio) → VAE Decode + Audio Decode → mp4 e player. Indica il bundle .syn di MiniMax-H3 in Checkpoint; l'encoder viene preso dal bundle. Pipeline originale: 20 passi, CFG 5 — i valori predefiniti del Sampler."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "Lo stesso grafo di Text to Video, ma adattato per la Turbo LoRA: 6 passi, senza CFG (impostato nel Sampler di questo template). Indica minimax_h3_turbo_v4_step600_ema.safetensors nel campo LoRA di Checkpoint — senza di esso, 6 passi produrranno uno sfarfallio rumoroso."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Dà vita a un'immagine: il Keyframe (slot «first frame») alimenta sia il Text Encoder (come <Picture 1> nella presentazione del prompt) sia il Sampler (codificato in VAE nel conditioning). Imposta la risoluzione del latente AV in base alle proporzioni della sorgente."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Una transizione tra due fotogrammi. Sul secondo nodo Keyframe, scegli lo slot «last frame» — il modello supporta gli ancoraggi solo sul primo e sull'ultimo fotogramma; un ancoraggio intermedio viene rifiutato durante l'assemblaggio del layout."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) e un video player (fotogrammi+audio dalla memoria, in parallelo al Save). Nel nodo Checkpoint, indica LTX-2.3, Gemma e l'upscaler — bundle .syn dalla cartella dei modelli (oppure .safetensors + la cartella HF di Gemma). Il checkpoint deve essere quello distilled (ltx-2.3-22b-distilled-*): le fasi seguono la pianificazione distilled a 8+3 passi, e un checkpoint dev produrrà un video sfocato."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Immagine (fotogramma 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → video player / Save. In Checkpoint, indica LTX-2.3, Gemma e l'upscaler; in LTX Image, indica l'immagine."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Video sorgente (LTX Video Input) + prompt → Text Encoder → Retake (rigenera la regione [start,end] in secondi, il resto resta invariato) → VAE Decode + Audio Decode → video player / Save. A stadio singolo (senza upscale). In Checkpoint, indica LTX-2.3 e Gemma; in Video Input, indica il video."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Un video di riferimento (LTX Video Input) imposta struttura/movimento, il prompt imposta il contenuto → Text Encoder → IC-LoRA (aggiunge ref-control) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, indica LTX-2.3, Gemma e l'adattatore IC-LoRA (campo LoRA); in Video Input, indica il video di riferimento."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Un video di riferimento (viso) + parlato (Audio Input) → sincronizzazione labiale sul parlato: Text Encoder → Lipdub (stage1 A/V aggiunge ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, indica LTX-2.3, Gemma, l'upscaler e l'IC-LoRA per il lipdub (campo LoRA)."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "L'audio (Audio Input) fissa la traccia audio, il prompt imposta la scena → Text Encoder → A2V (stage1 video-denoise con l'audio bloccato → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → video player / Save. In Checkpoint, indica LTX-2.3, Gemma e l'upscaler; in Audio Input, indica il suono."
