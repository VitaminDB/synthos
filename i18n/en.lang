training.title = "Training"
training.subtitle = "Fine-tune language models with LoRA adapters"
training.overview.nav = "How it works"
training.overview.lead = "A LoRA adapter is a small add-on to a model's weights (tens to hundreds of megabytes) that teaches it a style, an answer format or a subject area. The model itself does not change: the adapter is switched on and off, and one model can have several. Training runs in the AI service — you can close Synthos and the job keeps going."
training.overview.step1.title = "Build a dataset"
training.overview.step1.text = "Example dialogues: a user's question and the answer the model should learn. A hundred to a few thousand good examples is enough. Datasets live in the datasets folder of the model library; drop a ready JSONL there or create and edit one here."
training.overview.step2.title = "Start training"
training.overview.step2.text = "Pick a model and a dataset — the rest has sensible defaults. A quantized model trains as is (QLoRA): the base stays frozen, only the adapters learn. Progress shows the loss curve, speed and time left."
training.overview.step3.title = "Turn the adapter on"
training.overview.step3.text = "Enable the finished adapter for the model by default (here or in system Settings) or in the «LoRA adapters» card of a particular chat. Its strength can be changed without retraining."
