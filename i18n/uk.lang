nav.training = "Навчання"
training.title = "Навчання"
training.subtitle = "Донавчання мовних моделей адаптерами LoRA"
training.overview.nav = "Як це працює"
training.overview.lead = "Адаптер LoRA — це невелика надбудова над вагами моделі (від десятків до сотень мегабайт), яка навчає її стилю, формату відповідей чи предметної галузі. Сама модель не змінюється: адаптер вмикається й вимикається, а в однієї моделі їх може бути кілька. Навчання йде у службі нейромереж — Synthos можна закрити, завдання продовжиться."
training.overview.step1.title = "Зберіть датасет"
training.overview.step1.text = "Приклади діалогів: питання користувача й відповідь, якої має навчитися модель. Достатньо від сотні до кількох тисяч добрих прикладів. Датасети лежать у теці datasets бібліотеки моделей; покладіть туди готовий JSONL або створіть і редагуйте його тут."
training.overview.step2.title = "Запустіть навчання"
training.overview.step2.text = "Оберіть модель і датасет — решта має розумні значення за замовчуванням. Квантована модель навчається як є (QLoRA): основа заморожена, навчаються лише адаптери. У ході навчання видно криву втрат, швидкість і час, що залишився."
training.overview.step3.title = "Увімкніть адаптер"
training.overview.step3.text = "Увімкніть готовий адаптер для моделі за замовчуванням (тут або в системних Параметрах) чи в картці «Адаптери LoRA» окремого чату. Силу можна змінювати без перенавчання."
