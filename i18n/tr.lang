nav.training = "Eğitim"
training.title = "Eğitim"
training.subtitle = "Dil modellerini LoRA adaptörleriyle ince ayarlayın"
training.overview.nav = "Nasıl çalışır"
training.overview.lead = "LoRA adaptörü, model ağırlıklarına eklenen küçük bir eklentidir (onlarca ila yüzlerce megabayt); modele bir üslup, yanıt biçimi veya konu alanı öğretir. Modelin kendisi değişmez: adaptör açılıp kapatılır ve bir modelin birden fazla adaptörü olabilir. Eğitim sinir ağı hizmetinde çalışır — Synthos’u kapatabilirsiniz, iş devam eder."
training.overview.step1.title = "Veri kümesi oluşturun"
training.overview.step1.text = "Örnek diyaloglar: kullanıcının sorusu ve modelin öğrenmesi gereken yanıt. Yüz ila birkaç bin iyi örnek yeterlidir. Veri kümeleri model kütüphanesinin datasets klasöründe bulunur; oraya hazır bir JSONL koyun ya da burada oluşturup düzenleyin."
training.overview.step2.title = "Eğitimi başlatın"
training.overview.step2.text = "Bir model ve veri kümesi seçin — gerisi makul varsayılanlara sahiptir. Nicemlenmiş model olduğu gibi eğitilir (QLoRA): taban dondurulur, yalnızca adaptörler öğrenir. İlerleme sırasında kayıp eğrisi, hız ve kalan süre görünür."
training.overview.step3.title = "Adaptörü açın"
training.overview.step3.text = "Hazır adaptörü model için varsayılan olarak (burada veya sistem Ayarlarında) ya da belirli bir sohbetin “LoRA adaptörleri” kartında etkinleştirin. Gücü yeniden eğitmeden değiştirilebilir."
