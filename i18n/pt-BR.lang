template.builtin-empty.name = "Vazio"
template.builtin-empty.desc = "Tela em branco — comece do zero."
template.builtin-simple-add.name = "Soma simples"
template.builtin-simple-add.desc = "Número + Número → Add → Output. Aritmética pura."
template.builtin-audio-playback.name = "Reprodução de áudio"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Abra um arquivo WAV e aperte Reproduzir."
template.builtin-voice-recording.name = "Gravação de voz"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Grave sua voz e ouça-a na hora."
template.builtin-audio-effects-chain.name = "Cadeia de efeitos de áudio"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Grave sua voz e ouça-a processada com efeitos em tempo real."
template.builtin-save-to-file.name = "Salvar gravação"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Grava o microfone em um arquivo WAV (PCM de 16 bits)."
template.builtin-mix-two-sources.name = "Mixar 2 fontes"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 fontes) → Audio Player. Um template básico para mixar duas faixas."
template.builtin-mix-mic-and-file.name = "Microfone + Arquivo"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Um cenário de karaokê: voz sobre uma base instrumental."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Clone de voz"
template.builtin-voice-clone-voxcpm.desc = "Voz de referência (Audio File) + texto (Text) → VoxCPM2 TTS (clona a partir de ref_audio) → Audio Player e Save to File. Abra um WAV curto com uma amostra de voz, digite o texto, aponte o nó Syn Checkpoint para o modelo .syn do VoxCPM e clique em Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Clone de voz"
template.builtin-voice-clone-omnivoice.desc = "Voz de referência (Audio File) → GigaAM ASR (transcrição automática → texto de referência) + texto (Text) → OmniVoice TTS (modo Clone a partir de ref_audio) → Audio Player e Save to File. Abra um WAV com uma amostra de voz, digite o texto, aponte os nós Syn Checkpoint para os modelos .syn: GigaAM (gigaam-v3.syn) para ASR e OmniVoice (omnivoice.syn) para TTS, depois clique em Run. A transcrição em Text View pode ser editada antes da síntese."
template.builtin-vibevoice-dialogue.name = "VibeVoice: diálogo com duas vozes"
template.builtin-vibevoice-dialogue.desc = "Um roteiro formatado como \"Speaker 1: …\" / \"Speaker 2: …\" mais duas amostras de voz curtas em WAV → o VibeVoice sintetiza uma faixa de diálogo contínua em 24 kHz. Aponte o nó Syn Checkpoint para vibevoice-1.5b.syn e clique em Run."
template.builtin-vibevoice-single.name = "VibeVoice: clone de uma única voz"
template.builtin-vibevoice-single.desc = "Uma amostra de voz em WAV + texto → o VibeVoice narra tudo (o modelo mantém contexto por dezenas de minutos). Use vibevoice-1.5b.syn ou vibevoice-7b.syn no nó Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast a partir de um tema (LLM → voz)"
template.builtin-vibevoice-llm-podcast.desc = "Tema → a LLM escreve um roteiro em linhas \"Speaker N: …\" → Text View (editável manualmente) → o VibeVoice narra com duas vozes → player e salvamento. Precisa de dois nós Syn Checkpoint: um pacote de LLM e vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Texto→Música"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/letra → Generate (text2music) → player. Geração básica de texto para música."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Uma variação da faixa com as mesmas tags (uma mistura de duas sementes de ruído). Retake variance controla a intensidade da variação; não é necessário áudio de origem."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regenera a região [start,end] do áudio de origem (fora da região — o original permanece). ⚠ Defina Duration como a duração do áudio de origem."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Estende o áudio: o original é preservado, uma nova cauda é gerada. ⚠ Defina Duration maior que a duração de origem, região = a parte nova (start = duração de origem, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Transforma o áudio de origem em direção a um novo prompt (SDEdit: reintroduz ruído até n_max → remove o ruído). n_max=0 ⇒ sem mudança, quanto mais perto de 1 ⇒ mais forte. ⚠ Duration = duração da origem."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: o áudio de origem → contexto do DiT, as tags definem o novo estilo/instrumentos. ⚠ Duration = duração da origem."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Extrai um stem da mixagem: o áudio de origem → contexto do DiT, as tags especificam o que extrair. ⚠ Duration = duração da origem."
template.builtin-h3-text-to-video.name = "H3: Texto para vídeo + áudio"
template.builtin-h3-text-to-video.desc = "Prompt → Codificador H3 (Qwen3-VL) → Sampler H3 (vídeo e áudio juntos, 20 passos, CFG 5) → decodificadores de vídeo e áudio → Adicionar áudio → mp4 e player. Tamanho e duração em Tamanho do vídeo H3."
template.builtin-h3-turbo.name = "H3: Turbo (6 passos)"
template.builtin-h3-turbo.desc = "Mesmo grafo de Texto para vídeo para a LoRA Turbo: 6 passos sem CFG. Coloque o arquivo da LoRA Turbo (minimax_h3_turbo…safetensors) no campo LoRA do Modelo H3 — sem ela, 6 passos saem com ruído."
template.builtin-h3-first-frame.name = "H3: Primeiro quadro para vídeo"
template.builtin-h3-first-frame.desc = "Anime uma imagem: o arquivo vai para o primeiro quadro do Codificador H3 (o modelo o vê como <Picture 1>, o sampler o mantém como primeiro quadro). Ajuste o tamanho do vídeo às proporções da imagem."
template.builtin-h3-first-last.name = "H3: Primeiro+Último quadro"
template.builtin-h3-first-last.desc = "Transição entre dois quadros: arquivos no primeiro e no último quadro do Codificador H3 — o modelo fixa apenas o primeiro e o último quadro."
template.builtin-h3-ref2va.name = "H3: Referências para vídeo"
template.builtin-h3-ref2va.desc = "Vídeo a partir de referências (modelo Ref2VA): até 9 imagens, 3 vídeos e 3 áudios, 12 no total — um arquivo por linha no nó Lista. A ordem define as tags <Picture i> / <Video k> / <Audio j> usadas no prompt."
template.builtin-ltx-text-to-video.name = "LTX: Texto para vídeo"
template.builtin-ltx-text-to-video.desc = "Prompt → Codificador LTX (Gemma) + NAG → Stage1 → Upscale ×2 → Stage2 → decodificadores de vídeo e áudio → Adicionar áudio → mp4 e player. Modelo: LTX-2.3 distilled da biblioteca do serviço (um modelo dev recebe a LoRA distilled)."
template.builtin-ltx-image-to-video.name = "LTX: Imagem para vídeo"
template.builtin-ltx-image-to-video.desc = "Imagem (arquivo → Quadro de condição LTX, quadro 0) + prompt → Stage1 → Upscale ×2 → Stage2 (o quadro é mantido nos dois estágios) → decodificadores → Adicionar áudio → mp4 e player."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Vídeo de origem (arquivo) + prompt → LTX Retake: só os segundos [de, até] são regenerados, o resto é mantido → decodificadores → Adicionar áudio → mp4 e player. Um único estágio, sem upscale."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Um vídeo de exemplo (arquivo) define a estrutura ou o movimento, o prompt o conteúdo → LTX IC-LoRA (sinal: como está, bordas Canny ou profundidade) → decodificadores → mp4 e player. Adaptador: campo LoRA do Modelo LTX (union / motion ou um arquivo)."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Um vídeo de rosto + nova fala (arquivos) → LTX LipDub: os lábios acompanham a fala, os dois estágios de uma vez → decodificadores → mp4 e player. O adaptador lipdub vai no campo LoRA do Modelo LTX."
template.builtin-ltx-a2v.name = "LTX: Áudio para vídeo"
template.builtin-ltx-a2v.desc = "O áudio (arquivo) define a trilha sonora, o prompt a cena → LTX áudio para vídeo (áudio congelado nos dois estágios) → decodificadores → Adicionar áudio → mp4 e player."

