template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Leere Arbeitsfläche — Start bei null."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Reine Arithmetik."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. WAV-Datei öffnen und Play drücken."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Stimme aufnehmen und sofort abspielen."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Stimme aufnehmen und in Echtzeit mit Effekten hören."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Nimmt das Mikrofon in eine WAV-Datei auf (PCM 16-Bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 Quellen) → Audio Player. Grundvorlage zum Mischen zweier Spuren."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Karaoke-Szenario: Stimme über einer Begleitspur."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Referenzstimme (Audio File) + Text (Text) → VoxCPM2 TTS (Klon aus ref_audio) → Audio Player und Save to File. Öffnen Sie ein kurzes WAV mit einer Stimmprobe, geben Sie den Text ein, verweisen Sie die Syn-Checkpoint-Node auf das VoxCPM-.syn-Modell und klicken Sie auf Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Referenzstimme (Audio File) → GigaAM ASR (Auto-Transkript → ref text) + Text (Text) → OmniVoice TTS (Clone-Modus aus ref_audio) → Audio Player und Save to File. Öffnen Sie ein WAV mit einer Stimmprobe, geben Sie den Text ein, verweisen Sie die Syn-Checkpoint-Nodes auf die .syn-Modelle: GigaAM (gigaam-v3.syn) für ASR und OmniVoice (omnivoice.syn) für TTS, und klicken Sie auf Run. Das Transkript in Text View lässt sich vor der Synthese bearbeiten."
template.builtin-vibevoice-dialogue.name = "VibeVoice: Dialog zweier Stimmen"
template.builtin-vibevoice-dialogue.desc = "Ein Skript im Format „Speaker 1: …“ / „Speaker 2: …“ plus zwei kurze WAV-Stimmproben → VibeVoice synthetisiert eine durchgehende 24-kHz-Dialogspur. Verweisen Sie die Syn-Checkpoint-Node auf vibevoice-1.5b.syn und klicken Sie auf Run."
template.builtin-vibevoice-single.name = "VibeVoice: Klon einer Stimme"
template.builtin-vibevoice-single.desc = "Eine WAV-Stimmprobe + Text → VibeVoice erzählt alles vor (das Modell hält den Kontext über zig Minuten). Verwenden Sie vibevoice-1.5b.syn oder vibevoice-7b.syn in der Syn-Checkpoint-Node."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: Podcast aus einem Thema (LLM → Stimme)"
template.builtin-vibevoice-llm-podcast.desc = "Thema → das LLM schreibt ein Skript als „Speaker N: …“-Zeilen → Text View (von Hand bearbeitbar) → VibeVoice erzählt es mit zwei Stimmen vor → Player und Speichern. Erfordert zwei Syn-Checkpoint-Nodes: ein LLM-Bundle und vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → Player. Grundlegende Text-zu-Musik-Generierung."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Eine Variation des Tracks mit denselben Tags (eine Mischung zweier Noise-Seeds). Retake variance steuert die Stärke der Variation; kein Quellaudio nötig."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regeneriert den Bereich [start,end] des Quellaudios (außerhalb des Bereichs bleibt das Original). ⚠ Duration auf die Länge des Quellaudios setzen."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Verlängert das Audio: das Original bleibt erhalten, ein neues Ende wird generiert. ⚠ Duration größer als die Quelllänge setzen, region = der neue Teil (start = Quelllänge, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Morpht das Quellaudio in Richtung eines neuen Prompts (SDEdit: Re-Noise bis n_max → Denoise). n_max=0 ⇒ keine Änderung, näher an 1 ⇒ stärker. ⚠ Duration = Länge der Quelle."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: das Quellaudio → DiT-Kontext, Tags legen den neuen Stil/die Instrumente fest. ⚠ Duration = Länge der Quelle."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Extrahiert einen Stem aus dem Mix: das Quellaudio → DiT-Kontext, Tags geben an, was herausgezogen wird. ⚠ Duration = Länge der Quelle."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (gemeinsames Video- und Audio-Denoising) → VAE Decode + Audio Decode → mp4 und Player. Checkpoint auf das MiniMax-H3-.syn-Bundle verweisen; der Encoder wird aus dem Bundle übernommen. Original-Pipeline: 20 Schritte, CFG 5 — die Sampler-Vorgaben."
template.builtin-h3-turbo.name = "H3: Turbo (6 Schritte)"
template.builtin-h3-turbo.desc = "Derselbe Graph wie Text to Video, aber auf die Turbo-LoRA abgestimmt: 6 Schritte, kein CFG (im Sampler dieser Vorlage gesetzt). Das LoRA-Feld von Checkpoint auf minimax_h3_turbo_v4_step600_ema.safetensors verweisen — ohne sie erzeugen 6 Schritte ein verrauschtes Flackern."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Erweckt ein Bild zum Leben: Keyframe (Slot „first frame“) speist sowohl den Text Encoder (als <Picture 1> in der Prompt-Darstellung) als auch den Sampler (VAE-kodiert ins Conditioning). Die AV-Latent-Auflösung passend zum Seitenverhältnis der Quelle setzen."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Ein Übergang zwischen zwei Frames. Bei der zweiten Keyframe-Node den Slot „last frame“ wählen — das Modell unterstützt Anker nur am ersten und letzten Frame; ein mittlerer Anker wird beim Aufbau des Layouts abgelehnt."
template.builtin-h3-ref2va.name = "H3: Referenzen zu Video"
template.builtin-h3-ref2va.desc = "Video aus Referenzen (Ref2VA-Checkpoint): bis zu 9 Bilder, 3 Videos und 3 Audioclips, insgesamt 12, im Node H3 References. Die Reihenfolge der Liste legt die Tags <Picture i> / <Video k> / <Audio j> fest — der Node zeigt sie in jeder Zeile, der Prompt bezieht sich darauf. Der Prompt hat sechs Abschnitte (subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape, non_diegetic_music). Checkpoint braucht ein Ref2VA-Bundle: FL2VA versteht keine Referenzen."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2-Refine → VAE Decode + Audio Decode → Video Save (mp4) und ein Videoplayer (Frames+Audio aus dem Speicher, parallel zu Save). In der Checkpoint-Node auf LTX-2.3, Gemma und den Upscaler verweisen — .syn-Bundles aus dem Modellverzeichnis (oder .safetensors + das Gemma-HF-Verzeichnis). Der Checkpoint muss der distillierte sein (ltx-2.3-22b-distilled-*): die Stufen folgen dem distilled-Schema mit 8+3 Schritten, ein dev-Checkpoint erzeugt ein unscharfes Video."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Bild (Frame 0) + Prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2-Refine → VAE Decode + Audio Decode → Videoplayer / Save. In Checkpoint auf LTX-2.3, Gemma und den Upscaler verweisen; in LTX Image auf das Bild."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Quellvideo (LTX Video Input) + Prompt → Text Encoder → Retake (regeneriert den [start,end]-Sekundenbereich, der Rest bleibt eingefroren) → VAE Decode + Audio Decode → Videoplayer / Save. Einstufig (ohne Upscale). In Checkpoint auf LTX-2.3 und Gemma verweisen; in Video Input auf das Video."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Ein Referenzvideo (LTX Video Input) legt Struktur/Bewegung fest, der Prompt den Inhalt → Text Encoder → IC-LoRA (hängt ref-control an) → VAE Decode + Audio Decode → Videoplayer / Save. In Checkpoint auf LTX-2.3, Gemma und den IC-LoRA-Adapter (LoRA-Feld) verweisen; in Video Input auf das Referenzvideo."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Ein Referenzvideo (Gesicht) + Sprache (Audio Input) → Lippensynchronisation zur Sprache: Text Encoder → Lipdub (Stage1 A/V hängt ref+audio an → Upscale → Stage2-Refine) → VAE Decode + Audio Decode → Videoplayer / Save. In Checkpoint auf LTX-2.3, Gemma, den Upscaler und die Lipdub-IC-LoRA (LoRA-Feld) verweisen."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Audio (Audio Input) legt die Tonspur fest, der Prompt die Szene → Text Encoder → A2V (Stage1 Video-Denoise bei eingefrorenem Audio → Upscale ×2 → Stage2-Refine) → VAE Decode + Audio Decode → Videoplayer / Save. In Checkpoint auf LTX-2.3, Gemma und den Upscaler verweisen; in Audio Input auf den Ton."

