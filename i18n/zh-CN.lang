template.builtin-flux-text-to-image.name = "FLUX：文本生成图像"
template.builtin-flux-text-to-image.desc = "提示词 → 提示词编码器 → 采样器（默认 28 步，guidance 3.5）→ 图像解码器 → PNG。模型：服务库中的 FLUX.1；尺寸在空潜变量中设置。"
template.builtin-flux-image-to-image.name = "FLUX：图像生成图像"
template.builtin-flux-image-to-image.desc = "图像 → 图像转潜变量 → 强度 0.6 的采样器 → 图像解码器 → PNG。强度越低越接近原图；为 1 时按图像尺寸重绘。"
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "提示词 → 提示词编码器（dev 用 Mistral-24B，klein 用 Qwen3）→ 采样器（模型步数：dev 50，klein 4）→ 图像解码器 → PNG。模型：服务库中的 FLUX.2 dev/klein。"
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "图像 → 参考图 → 带编辑指令的采样器 → 原尺寸 PNG（最多 1 MP）。说明要改什么、保留什么。"
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "图像 → 图像转潜变量 → 强度 0.7 的采样器 → 图像解码器 → PNG。强度越低越接近原图；按指令编辑请用“编辑图像”。"
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "简短提示词 → LLM 按 Black Forest Labs 指南扩写（细节、光线、材质、引号内文字）→ 文本视图（可编辑）→ FLUX.2 → PNG。"
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "两张图像 → 参考图 → 参考图（串联）→ 采样器：把一张图中的人物、物体或风格放进另一张图的场景。按串联顺序称为 \"image 1\"、\"image 2\"。"
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "图像 → 参考图（编码器和采样器均可见）+ 编辑指令 → 采样器（true CFG 4）→ 原比例约 1 MP 的 PNG。模型：Qwen-Image-Edit / 2511。"
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "两张图像 → 参考图 → 参考图（串联）→ 编码器和采样器：把一张图中的人物、物体或风格放进另一张图的场景。仅限 Qwen-Image-Edit-2509/2511；称为 \"Picture 1\"、\"Picture 2\"。"
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "提示词 → 提示词编码器（Qwen3-VL）→ 采样器（40 步，无 CFG，KV 缓存）→ 图像解码器 → PNG。尺寸在空潜变量中设置（32 的倍数；原生 1024² 和 2048²）。"
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "图像 → 参考图（送入编码器和采样器）+ 编辑指令 → 采样器 → 原比例 PNG。透明 PNG 保留 alpha 通道。"
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "两张图像 → 参考图 → 参考图（串联，最多 10）→ 编码器和采样器。按串联顺序引用 <image1>、<image2>；尺寸在空潜变量中设置。"
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "无背景的贴纸、徽标或抠图物体：按模型卡格式写提示词（\"This is an RGBA image with transparency … the background is transparent\"）→ 带 alpha 的 PNG。"
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "简短提示词 → LLM 按 Qwen 的 Prompt Enhancer 改写为详细的镜头描述 → 文本视图（可编辑）→ Qwen-Image 2.1 → PNG。"
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "提示词和反向提示词 → 提示词编码器（CLIP-L + bigG）→ 采样器（30 步，CFG 5）→ 图像解码器 → 1024² PNG。"
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "图像 → 图像转潜变量 → 强度 0.6 的采样器 → 图像解码器 → PNG（最多 1 MP，边长为 64 的倍数）。强度越低越接近原图。"
template.builtin-ltx-flux-keyframe.name = "LTX：FLUX 画面转视频"
template.builtin-ltx-flux-keyframe.desc = "FLUX 根据提示词绘制首帧（16:9，1344×768）→ LTX 条件帧 → 带音频的 LTX-2.3 图生视频。上方提示词：画面内容；下方：视频中发生的事。"
template.builtin-h3-flux-keyframe.name = "H3：FLUX 画面转视频"
template.builtin-h3-flux-keyframe.desc = "FLUX 绘制首帧（16:9，1344×768）→ H3 编码器首帧 → 由此生成带音频的 MiniMax-H3 视频。上方提示词：画面；下方：H3 格式的动作与声音。"

