template.builtin-flux-text-to-image.name = "FLUX: Text to Image"
template.builtin-flux-text-to-image.desc = "Prompt → CLIP-L + T5-XXL → Sampler (28 steps, guidance 3.5) → VAE Decode → PNG. Point Checkpoint to the flux.1-dev.syn bundle (or a diffusers folder); set the picture size in Empty Latent."
template.builtin-flux-image-to-image.name = "FLUX: Image to Image"
template.builtin-flux-image-to-image.desc = "Image → VAE Encode → Sampler with denoise 0.6 → VAE Decode → PNG. Lower denoise stays closer to the source; 1.0 redraws from scratch at the image's size."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → LLM encoder (Mistral-24B for dev, Qwen3 for klein) → Sampler (steps by model: dev 50, klein 4) → VAE Decode → PNG. Point Checkpoint to flux.2-dev.syn, flux.2-klein-4b.syn or flux.2-klein-9b.syn; whatever does not fit in VRAM streams."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Picture → Reference → Sampler together with an edit instruction → PNG at the source size (up to 1 MP). Say what to change and what to keep."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Picture → VAE Encode → Sampler with denoise 0.7 → VAE Decode → PNG. Lower denoise keeps closer to the source's composition and colors; for instruction edits use the Edit Image template."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Short prompt → an LLM rewrites it in detail following Black Forest Labs' instruction (details, light, materials, quoted text) → Text View (editable) → FLUX.2 → PNG. Any chat LLM goes into Syn Checkpoint; \"Keep in memory\" is off so FLUX.2 gets the VRAM."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Two pictures → Reference → Reference (chained) → Sampler: a character, object or style from one picture in the scene of another. Refer to them as \"image 1\", \"image 2\" in chain order."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Picture → Reference (into the Qwen2.5-VL encoder and the sampler) + edit instruction → Sampler (true CFG 4, steps by model) → PNG ~1 MP in the source's aspect ratio. Point Checkpoint to qwen-image-edit-2511.syn or qwen-image-edit.syn."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Two pictures → Reference → Reference (chained) → encoder and Sampler: a person, object or style from one picture in the scene of another. Qwen-Image-Edit-2509/2511 only; refer to them as \"Picture 1\", \"Picture 2\" in chain order."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt and negative → CLIP-L + bigG → Sampler (30 steps, CFG 5) → VAE Decode → PNG 1024². Point Checkpoint to sdxl-base-1.0.syn."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Picture → SDXL VAE Encode → Sampler with denoise 0.6 → VAE Decode → PNG (up to 1 MP, sides multiple of 64). Lower denoise stays closer to the source."
template.builtin-ltx-flux-keyframe.name = "LTX: FLUX Frame to Video"
template.builtin-ltx-flux-keyframe.desc = "FLUX draws the first frame from a prompt (16:9, 1344×768) → LTX Image → LTX-2.3 image-to-video with sound. Two prompts: the top one is the frame, the bottom one is what happens in the video. Point FLUX Checkpoint to flux.1-dev.syn and LTX Checkpoint to the checkpoint, Gemma and upscaler."
template.builtin-h3-flux-keyframe.name = "H3: FLUX Frame to Video"
template.builtin-h3-flux-keyframe.desc = "FLUX draws the first frame (16:9, 1344×768) → H3 Keyframe → MiniMax-H3 video with sound from that frame. The top prompt is the frame, the bottom one is the action and sound in H3 format. Point FLUX Checkpoint to flux.1-dev.syn and H3 Checkpoint to the MiniMax-H3 bundle."
