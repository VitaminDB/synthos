template.builtin-flux-text-to-image.name = "FLUX: texto a imagen"
template.builtin-flux-text-to-image.desc = "Prompt → CLIP-L + T5-XXL → Sampler (28 pasos, guidance 3.5) → VAE Decode → PNG. Indica en Checkpoint el bundle flux.1-dev.syn (o una carpeta diffusers); el tamaño de la imagen se fija en Empty Latent."
template.builtin-flux-image-to-image.name = "FLUX: imagen a imagen"
template.builtin-flux-image-to-image.desc = "Imagen → VAE Encode → Sampler con denoise 0.6 → VAE Decode → PNG. Cuanto menor el denoise, más cerca del original; 1.0 redibuja desde cero con el tamaño de la imagen."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → codificador LLM (Mistral-24B en dev, Qwen3 en klein) → Sampler (pasos según el modelo: dev 50, klein 4) → VAE Decode → PNG. En Checkpoint: flux.2-dev.syn, flux.2-klein-4b.syn o flux.2-klein-9b.syn; lo que no cabe en la VRAM se transmite."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Imagen → Reference → Sampler junto con una instrucción de edición → PNG al tamaño del original (hasta 1 MP). Di qué cambiar y qué mantener."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Imagen → VAE Encode → Sampler con denoise 0.7 → VAE Decode → PNG. Cuanto menor el denoise, más fiel a la composición y los colores del original; para editar con instrucciones usa la plantilla Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Prompt corto → un LLM lo reescribe en detalle según la instrucción de Black Forest Labs (detalles, luz, materiales, textos entre comillas) → Text View (editable) → FLUX.2 → PNG. En Syn Checkpoint, cualquier LLM de chat; «Mantener en memoria» está desactivado para que FLUX.2 tenga la VRAM."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Dos imágenes → Reference → Reference (en cadena) → Sampler: un personaje, objeto o estilo de una imagen en la escena de otra. En el prompt, «image 1», «image 2» según el orden de la cadena."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Imagen → Reference (al codificador Qwen2.5-VL y al sampler) + instrucción de edición → Sampler (true CFG 4, pasos según el modelo) → PNG ~1 MP con las proporciones del original. En Checkpoint — qwen-image-edit-2511.syn o qwen-image-edit.syn."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Dos imágenes → Reference → Reference (en cadena) → codificador y Sampler: una persona, objeto o estilo de una imagen en la escena de otra. Solo Qwen-Image-Edit-2509/2511; en el prompt, «Picture 1», «Picture 2» en el orden de la cadena."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Text Encoder (Qwen3-VL) → Sampler (40 pasos, sin CFG, caché KV) → VAE Decode → PNG. Tamaño — FLUX Empty Latent (lados múltiplos de 32; nativos 1024² y 2048²). En Checkpoint — qwen-image-2.1.syn."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Imagen → Reference (al codificador Qwen3-VL y al sampler) + instrucción de edición → Sampler → PNG con la proporción del original. Los PNG transparentes se editan con su alfa. Di qué cambiar y qué conservar."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Dos imágenes → Reference → Reference (encadenadas, hasta 10) → codificador y Sampler: una persona, objeto o estilo de una imagen en la escena de otra. En el prompt — <image1>, <image2> en orden de cadena; tamaño — Empty Latent."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Pegatina, logotipo u objeto recortado sin fondo: formato de prompt de la ficha del modelo («This is an RGBA image with transparency … the background is transparent») → PNG con canal alfa. Image Save conserva la transparencia."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Prompt corto → un LLM lo reescribe como descripción detallada del encuadre según la guía Prompt Enhancer de Qwen (conservar lo fijado, decidir el resto, texto de la imagen entre comillas) → Text View (editable) → Qwen-Image 2.1 → PNG. Cualquier LLM de chat en Syn Checkpoint; «Mantener en memoria» apagado para que la VRAM quede para el DiT."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt y negativo → CLIP-L + bigG → Sampler (30 pasos, CFG 5) → VAE Decode → PNG 1024². En Checkpoint — sdxl-base-1.0.syn."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Imagen → SDXL VAE Encode → Sampler con denoise 0.6 → VAE Decode → PNG (hasta 1 MP, lados múltiplos de 64). Cuanto menor el denoise, más cerca del original."
template.builtin-ltx-flux-keyframe.name = "LTX: fotograma FLUX a vídeo"
template.builtin-ltx-flux-keyframe.desc = "FLUX dibuja el primer fotograma a partir del prompt (16:9, 1344×768) → LTX Image → LTX-2.3 image-to-video con sonido. Dos prompts: el de arriba es el fotograma, el de abajo lo que ocurre en el vídeo. Indica flux.1-dev.syn en FLUX Checkpoint y el checkpoint, Gemma y el upscaler en LTX Checkpoint."
template.builtin-h3-flux-keyframe.name = "H3: fotograma FLUX a vídeo"
template.builtin-h3-flux-keyframe.desc = "FLUX dibuja el primer fotograma (16:9, 1344×768) → H3 Keyframe → vídeo MiniMax-H3 con sonido a partir de ese fotograma. El prompt de arriba es el fotograma, el de abajo la acción y el sonido en formato H3. Indica flux.1-dev.syn en FLUX Checkpoint y el bundle MiniMax-H3 en H3 Checkpoint."

