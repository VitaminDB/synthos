settings.ai_models.image_tokens.256 = "256 — miniature : vue d'ensemble, gros objets"
settings.ai_models.image_tokens.512 = "512 — économique, le texte large reste lisible"
settings.ai_models.image_tokens.1024 = "1024 — par défaut : captures d'écran et documents"
settings.ai_models.image_tokens.2048 = "2048 — texte fin, schémas"
settings.ai_models.image_tokens.4096 = "4096 — qualité maximale, prefill long"
settings.ai_models.image_tokens.unlimited = "Aucune limite — selon la configuration du modèle"
