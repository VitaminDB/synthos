training.overview.step2.title = "Оқытуды бастаңыз"
training.overview.step2.text = "Модель мен деректер жинағын таңдаңыз — қалғанының ақылға қонымды әдепкі мәндері бар. Кванттелген модель сол күйінде оқытылады (QLoRA): негіз қатырылған, тек адаптерлер үйренеді. Барысында шығын қисығы, жылдамдық және қалған уақыт көрсетіледі."
