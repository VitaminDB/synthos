template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Бос канвас — нөлден бастаңыз."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Таза арифметика."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. WAV файлын ашып, Play басыңыз."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Дауысыңызды жазып, бірден қайта тыңдаңыз."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Дауысыңызды жазып, оны нақты уақытта эффектілермен өңделген түрде тыңдаңыз."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Микрофоннан WAV файлына жазады (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 дереккөз) → Audio Player. Екі тректі микштеуге арналған негізгі шаблон."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Караоке сценарийі: дауыс аккомпанемент үстінен."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Референс дауыс (Audio File) + мәтін (Text) → VoxCPM2 TTS (ref_audio бойынша клондайды) → Audio Player және Save to File. Дауыс үлгісі бар қысқа WAV ашыңыз, мәтінді енгізіңіз, Syn Checkpoint түйінінде VoxCPM .syn моделін көрсетіп, Run басыңыз."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Референс дауыс (Audio File) → GigaAM ASR (авто-транскрипт → ref text) + мәтін (Text) → OmniVoice TTS (ref_audio бойынша Clone режимі) → Audio Player және Save to File. Дауыс үлгісі бар WAV ашыңыз, мәтінді енгізіңіз, Syn Checkpoint түйіндерінде .syn модельдерін көрсетіңіз: ASR үшін GigaAM (gigaam-v3.syn) және TTS үшін OmniVoice (omnivoice.syn), содан соң Run басыңыз. Text View ішіндегі транскриптті синтездеу алдында түзетуге болады."
template.builtin-vibevoice-dialogue.name = "VibeVoice: екі дауыс диалогы"
template.builtin-vibevoice-dialogue.desc = "«Speaker 1: …» / «Speaker 2: …» пішіміндегі сценарий және екі қысқа WAV дауыс үлгісі → VibeVoice тұтас 24 кГц диалог дорожкасын синтездейді. Syn Checkpoint түйінінде vibevoice-1.5b.syn көрсетіп, Run басыңыз."
template.builtin-vibevoice-single.name = "VibeVoice: бір дауыс клоны"
template.builtin-vibevoice-single.desc = "Бір WAV дауыс үлгісі + мәтін → VibeVoice бәрін дыбыстайды (модель контексті ондаған минутқа дейін сақтайды). Syn Checkpoint түйінінде vibevoice-1.5b.syn немесе vibevoice-7b.syn қолданыңыз."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: тақырыптан подкаст (LLM → дауыс)"
template.builtin-vibevoice-llm-podcast.desc = "Тақырып → LLM сценарийді «Speaker N: …» жолдарымен жазады → Text View (қолмен түзетуге болады) → VibeVoice екі дауыспен дыбыстайды → плеер және сақтау. Екі Syn Checkpoint түйіні қажет: LLM bundle және vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → плеер. Мәтіннен музыкаға негізгі генерация."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Сол теги бар трек вариациясы (екі шу seed'інің қоспасы). Retake variance вариация күшін басқарады; бастапқы аудио қажет емес."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Бастапқы аудионың [start,end] аймағын қайта генерациялайды (аймақтан тыс — түпнұсқа қалады). ⚠ Duration мәнін бастапқы аудио ұзақтығына теңестіріңіз."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Аудионы ұзартады: түпнұсқа сақталады, жаңа соңы генерацияланады. ⚠ Duration мәнін бастапқы ұзақтықтан үлкен қойыңыз, аймақ = жаңа бөлік (start = бастапқы ұзақтық, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Бастапқы аудионы жаңа промпт бағытында морфтайды (SDEdit: n_max деңгейіне дейін қайта шулатып → денойзинг). n_max=0 ⇒ өзгеріссіз, 1-ге жақындаған сайын ⇒ күшті. ⚠ Duration = бастапқы ұзақтық."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: бастапқы аудио → DiT контексі, теги жаңа стиль/аспаптарды белгілейді. ⚠ Duration = бастапқы ұзақтық."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Микстен стемді бөліп алады: бастапқы аудио → DiT контексі, теги нені бөліп алу керегін көрсетеді. ⚠ Duration = бастапқы ұзақтық."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (видео мен аудионы бірлесіп денойзинг ету) → VAE Decode + Audio Decode → mp4 және плеер. Checkpoint-те MiniMax-H3 .syn bundle көрсетіңіз; энкодер bundle-дан алынады. Түпнұсқа pipeline: 20 қадам, CFG 5 — Sampler-дің әдепкі мәндері."
template.builtin-h3-turbo.name = "H3: Turbo (6 қадам)"
template.builtin-h3-turbo.desc = "Text to Video-мен бірдей граф, бірақ Turbo LoRA-ға бейімделген: 6 қадам, CFG жоқ (осы шаблонның Sampler-інде орнатылған). Checkpoint-тің LoRA өрісінде minimax_h3_turbo_v4_step600_ema.safetensors көрсетіңіз — онсыз 6 қадамда шуылды жыпылықтау болады."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Суретті жандандырады: Keyframe («бірінші кадр» слоты) Text Encoder-ге (промпт презентациясында <Picture 1> ретінде) және Sampler-ге (conditioning-ке VAE-кодталған түрде) беріледі. AV-латент ажыратымдылығын түпнұсқаның пропорциясына сай орнатыңыз."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Екі кадр арасындағы өту. Екінші Keyframe түйінінде «соңғы кадр» слотын таңдаңыз — модель тек бірінші және соңғы кадрдағы якорьларды қолдайды; ортаңғы якорь layout жиналу кезінде қабылданбайды."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) және видеоплеер (кадрлар+дыбыс жадыдан, Save-мен қатар). Checkpoint түйінінде LTX-2.3, Gemma және upscaler көрсетіңіз — модель каталогынан .syn bundle'дар (немесе .safetensors + Gemma HF-каталогы). Чекпойнт міндетті түрде distilled болуы керек (ltx-2.3-22b-distilled-*): кезеңдер distilled 8+3-қадам кестесімен жүреді, ал dev-чекпойнт бұлдыр видео береді."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Сурет (0-кадр) + промпт → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → видеоплеер / Save. Checkpoint-те LTX-2.3, Gemma және upscaler көрсетіңіз; LTX Image-де суретті көрсетіңіз."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Бастапқы видео (LTX Video Input) + промпт → Text Encoder → Retake ([start,end] секунд аймағын қайта генерациялайды, қалғаны frozen күйде қалады) → VAE Decode + Audio Decode → видеоплеер / Save. Бір кезеңді (upscale жоқ). Checkpoint-те LTX-2.3 және Gemma көрсетіңіз; Video Input-те видеоны көрсетіңіз."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Референс видео (LTX Video Input) құрылым/қозғалысты, промпт мазмұнды белгілейді → Text Encoder → IC-LoRA (ref-control қосады) → VAE Decode + Audio Decode → видеоплеер / Save. Checkpoint-те LTX-2.3, Gemma және IC-LoRA адаптерін (LoRA өрісі) көрсетіңіз; Video Input-те референс видеоны көрсетіңіз."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Референс видео (бет) + сөз (Audio Input) → сөзге ерін синхрондау: Text Encoder → Lipdub (stage1 A/V ref+audio қосады → upscale → stage2 refine) → VAE Decode + Audio Decode → видеоплеер / Save. Checkpoint-те LTX-2.3, Gemma, upscaler және lipdub IC-LoRA (LoRA өрісі) көрсетіңіз."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Аудио (Audio Input) дыбыс дорожкасын бекітеді, промпт сахнаны белгілейді → Text Encoder → A2V (stage1 видео-денойзинг аудио frozen күйде → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → видеоплеер / Save. Checkpoint-те LTX-2.3, Gemma және upscaler көрсетіңіз; Audio Input-те дыбысты көрсетіңіз."
