nav.training = "학습"
training.title = "학습"
training.subtitle = "LoRA 어댑터로 언어 모델 미세 조정"
training.overview.nav = "작동 방식"
training.overview.lead = "LoRA 어댑터는 모델 가중치에 더하는 작은 추가 요소(수십~수백 MB)로, 모델에 문체, 답변 형식 또는 전문 분야를 가르칩니다. 모델 자체는 바뀌지 않습니다. 어댑터는 켜고 끌 수 있으며 한 모델에 여러 개를 둘 수 있습니다. 학습은 AI 서비스에서 실행되므로 Synthos를 닫아도 작업은 계속됩니다."
training.overview.step1.title = "데이터셋 만들기"
training.overview.step1.text = "예시 대화: 사용자의 질문과 모델이 배워야 할 답변. 좋은 예시 백~수천 개면 충분합니다. 데이터셋은 모델 라이브러리의 datasets 폴더에 있습니다. 준비된 JSONL을 그곳에 넣거나 여기서 만들고 편집하세요."
training.overview.step2.title = "학습 시작"
training.overview.step2.text = "모델과 데이터셋을 고르세요. 나머지는 적절한 기본값이 있습니다. 양자화된 모델은 그대로 학습됩니다(QLoRA). 베이스는 고정되고 어댑터만 학습합니다. 진행 상황에는 손실 곡선, 속도, 남은 시간이 표시됩니다."
training.overview.step3.title = "어댑터 켜기"
training.overview.step3.text = "완성된 어댑터를 모델의 기본값으로 켜거나(여기 또는 시스템 설정에서) 특정 채팅의 “LoRA 어댑터” 카드에서 켜세요. 강도는 다시 학습하지 않고도 바꿀 수 있습니다."
