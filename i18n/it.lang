template.builtin-flux-text-to-image.name = "FLUX: testo in immagine"
template.builtin-flux-text-to-image.desc = "Prompt → Codificatore del prompt → Sampler (28 passi, guidance 3,5 di default) → Decodificatore di immagini → PNG. Modello: FLUX.1 dalla libreria del servizio; dimensioni in Latente vuoto."
template.builtin-flux-image-to-image.name = "FLUX: immagine in immagine"
template.builtin-flux-image-to-image.desc = "Immagine → Immagine in latente → Sampler con intensità 0,6 → Decodificatore di immagini → PNG. Un'intensità minore resta più vicina all'originale; 1 ridisegna alle dimensioni dell'immagine."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → Codificatore del prompt (Mistral-24B per dev, Qwen3 per klein) → Sampler (passi del modello: dev 50, klein 4) → Decodificatore di immagini → PNG. Modello: FLUX.2 dev/klein dalla libreria del servizio."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Immagine → Riferimenti → Sampler con un'istruzione di modifica → PNG alle dimensioni originali (fino a 1 MP). Indica cosa cambiare e cosa mantenere."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Immagine → Immagine in latente → Sampler con intensità 0,7 → Decodificatore di immagini → PNG. Un'intensità minore resta più vicina all'originale; per modifiche tramite istruzioni usa Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Prompt breve → un LLM lo espande secondo le linee guida di Black Forest Labs (dettagli, luce, materiali, testo tra virgolette) → Vista testo (modificabile) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Due immagini → Riferimenti → Riferimenti (in catena) → Sampler: un personaggio, un oggetto o uno stile da un'immagine inserito nella scena dell'altra. Chiamale \"image 1\", \"image 2\" nell'ordine della catena."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Immagine → Riferimenti (visti dal codificatore e dal sampler) + istruzione di modifica → Sampler (true CFG 4) → PNG di ~1 MP nelle proporzioni originali. Modello: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Due immagini → Riferimenti → Riferimenti (in catena) → codificatore e sampler: una persona, un oggetto o uno stile da un'immagine nella scena dell'altra. Solo Qwen-Image-Edit-2509/2511; chiamale \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Codificatore del prompt (Qwen3-VL) → Sampler (40 passi, senza CFG, cache KV) → Decodificatore di immagini → PNG. Dimensioni in Latente vuoto (multipli di 32; native 1024² e 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Immagine → Riferimenti (al codificatore e al sampler) + istruzione di modifica → Sampler → PNG nelle proporzioni originali. I PNG trasparenti mantengono il canale alfa."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Due immagini → Riferimenti → Riferimenti (in catena, fino a 10) → codificatore e sampler. Chiamale <image1>, <image2> nell'ordine della catena; dimensioni in Latente vuoto."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Sticker, logo od oggetto ritagliato senza sfondo: prompt nel formato della scheda del modello (\"This is an RGBA image with transparency … the background is transparent\") → PNG con canale alfa."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Prompt breve → un LLM lo riscrive in una descrizione dettagliata dell'inquadratura secondo il Prompt Enhancer di Qwen → Vista testo (modificabile) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt e negativo → Codificatore del prompt (CLIP-L + bigG) → Sampler (30 passi, CFG 5) → Decodificatore di immagini → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Immagine → Immagine in latente → Sampler con intensità 0,6 → Decodificatore di immagini → PNG (fino a 1 MP, lati multipli di 64). Un'intensità minore resta più vicina all'originale."
template.builtin-ltx-flux-keyframe.name = "LTX: fotogramma FLUX in video"
template.builtin-ltx-flux-keyframe.desc = "FLUX disegna il primo fotogramma da un prompt (16:9, 1344×768) → Fotogramma di condizionamento LTX → LTX-2.3 da immagine a video con audio. Prompt superiore: cosa c'è nel fotogramma; inferiore: cosa succede nel video."
template.builtin-h3-flux-keyframe.name = "H3: fotogramma FLUX in video"
template.builtin-h3-flux-keyframe.desc = "FLUX disegna il primo fotogramma (16:9, 1344×768) → primo fotogramma del Codificatore H3 → video MiniMax-H3 con audio a partire da esso. Prompt superiore: il fotogramma; inferiore: azione e suono nel formato H3."

