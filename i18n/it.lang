# Training (LoRA)
nav.training = "Addestramento"
training.title = "Addestramento"
training.subtitle = "Affina i modelli linguistici con adattatori LoRA"
training.overview.nav = "Come funziona"
training.overview.lead = "Un adattatore LoRA è una piccola aggiunta ai pesi del modello (da decine a centinaia di megabyte) che gli insegna uno stile, un formato di risposta o un ambito. Il modello stesso non cambia: l'adattatore si attiva e disattiva, e un modello può averne diversi. L'addestramento gira nel servizio IA — puoi chiudere Synthos e il lavoro continua."
training.overview.step1.title = "Prepara un dataset"
training.overview.step1.text = "Dialoghi di esempio: la domanda dell'utente e la risposta che il modello deve imparare. Bastano da cento a qualche migliaio di buoni esempi. I dataset stanno nella cartella datasets della libreria modelli; mettici un JSONL già pronto oppure creane e modificane uno qui."
training.overview.step2.title = "Avvia l'addestramento"
training.overview.step2.text = "Scegli un modello e un dataset — il resto ha valori predefiniti sensati. Un modello quantizzato si addestra così com'è (QLoRA): la base resta congelata, imparano solo gli adattatori. L'avanzamento mostra la curva della loss, la velocità e il tempo rimanente."
training.overview.step3.title = "Attiva l'adattatore"
training.overview.step3.text = "Attiva l'adattatore pronto per il modello come predefinito (qui o nelle Impostazioni di sistema) oppure nella scheda «Adattatori LoRA» di una singola chat. La sua intensità si può cambiare senza riaddestrare."
