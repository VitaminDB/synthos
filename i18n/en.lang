template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Blank canvas — start from scratch."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Pure arithmetic."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Open a WAV file and hit Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Record your voice and play it back right away."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Record your voice and hear it processed with effects in real time."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Records the microphone to a WAV file (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 sources) → Audio Player. A basic template for mixing two tracks."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. A karaoke scenario: voice over a backing track."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Voice sample (Audio File) + text → VoxCPM2 (timbre from the sample) → player and save. Open a short WAV sample, enter the text and click Run; the model comes from the service library."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Voice sample (Audio File) → GigaAM transcription (sample text) + text → OmniVoice (clone from the sample) → player and save. Open a WAV sample, enter the text and click Run; models come from the service library."
template.builtin-vibevoice-dialogue.name = "VibeVoice: two-voice dialogue"
template.builtin-vibevoice-dialogue.desc = "A script formatted as \"Speaker 1: …\" / \"Speaker 2: …\" plus two short WAV voice samples → VibeVoice synthesizes a continuous 24 kHz dialogue track. Pick the model (vibevoice-1-5b or vibevoice-7b) in the Model field."
template.builtin-vibevoice-single.name = "VibeVoice: single voice clone"
template.builtin-vibevoice-single.desc = "One WAV voice sample + text → VibeVoice narrates the whole thing (the model keeps context for tens of minutes). Pick the model (vibevoice-1-5b or vibevoice-7b) in the Model field."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast from a topic (LLM → voice)"
template.builtin-vibevoice-llm-podcast.desc = "Topic → the language model writes a script as \"Speaker N: …\" lines → Text View (editable by hand) → VibeVoice narrates it with two voices → player and save. Models come from the service library."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "ACE-Step Model + tags and lyrics → Generate (text2music) → player. Basic text-to-music generation; runs in the service."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "A variation of the track with the same tags (a mix of two noise seeds). Retake variance controls the strength of the variation; no source audio is needed."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regenerates the [start, end] region of the source audio (outside the region the original stays). Length comes from the source."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Extends the audio: the original is preserved, a new tail is generated. Set Seconds above the source length, region = the new part (start = source length, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Morphs the source audio toward a new prompt (SDEdit: re-noise up to n_max → denoise). n_max = 0 ⇒ no change, closer to 1 ⇒ stronger. Length comes from the source."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: the source audio → DiT context, tags set the new style and instruments. Length comes from the source."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Extracts a stem from the mix: the source audio → DiT context, the stem is set in the Extract track field. Length comes from the source."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → H3 Encoder (Qwen3-VL) → H3 Sampler (joint video and audio, 20 steps, CFG 5) → video and audio decoders → Mux → mp4 and player. Size and duration in H3 Video Size."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "Same graph as Text to Video for the Turbo LoRA: 6 steps without CFG. Put the Turbo LoRA file (minimax_h3_turbo…safetensors) into the LoRA field of H3 Model — without it 6 steps come out noisy."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Animate an image: the file goes to the H3 Encoder's first frame (the model sees it as <Picture 1>, the sampler keeps it as frame one). Set the video size to the image proportions."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Transition between two frames: files into the H3 Encoder's first and last frame — the model anchors only the first and last frames."
template.builtin-h3-ref2va.name = "H3: References to Video"
template.builtin-h3-ref2va.desc = "Video from references (Ref2VA model): up to 9 images, 3 videos and 3 audio, 12 total — one file per line in the List node. The order sets the <Picture i> / <Video k> / <Audio j> tags the prompt refers to."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → LTX Encoder (Gemma) + NAG → Stage1 → Upscale ×2 → Stage2 → video and audio decoders → Mux → mp4 and player. Model: distilled LTX-2.3 from the service library (a dev model gets the distilled LoRA)."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Image (file → LTX Frame, frame 0) + prompt → Stage1 → Upscale ×2 → Stage2 (the frame is held on both stages) → decoders → Mux → mp4 and player."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Source video (file) + prompt → LTX Retake: only the [from, to] seconds are regenerated, the rest is kept → decoders → Mux → mp4 and player. Single stage, no upscale."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "A sample video (file) sets the structure or motion, the prompt sets the content → LTX IC-LoRA (signal: as is, Canny edges or depth) → decoders → mp4 and player. Adapter: LoRA field of LTX Model (union / motion or a file)."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "A face video + new speech (files) → LTX LipDub: lips follow the speech, both stages at once → decoders → mp4 and player. The lipdub adapter in the LoRA field of LTX Model."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Audio (file) sets the soundtrack, the prompt the scene → LTX Audio to Video (audio frozen on both stages) → decoders → Mux → mp4 and player."

