template.builtin-empty.name = "Boş"
template.builtin-empty.desc = "Boş tuval — sıfırdan başlayın."
template.builtin-simple-add.name = "Basit Toplama"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Saf aritmetik."
template.builtin-audio-playback.name = "Ses Oynatma"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Bir WAV dosyası açın ve Play'e basın."
template.builtin-voice-recording.name = "Ses Kaydı"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Sesinizi kaydedin ve hemen geri oynatın."
template.builtin-audio-effects-chain.name = "Ses Efekti Zinciri"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Sesinizi kaydedin ve gerçek zamanlı efektlerle işlenmiş halini duyun."
template.builtin-save-to-file.name = "Kaydı Kaydet"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Mikrofonu bir WAV dosyasına kaydeder (PCM 16-bit)."
template.builtin-mix-two-sources.name = "2 Kaynağı Karıştır"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 kaynak) → Audio Player. İki parçayı karıştırmak için temel bir şablon."
template.builtin-mix-mic-and-file.name = "Mikrofon + Dosya"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Bir karaoke senaryosu: bir müzik altyapısı üzerine ses."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Referans ses (Audio File) + metin (Text) → VoxCPM2 TTS (ref_audio'dan klonlar) → Audio Player ve Save to File. Bir ses örneği içeren kısa bir WAV açın, metni girin, Syn Checkpoint düğümünü VoxCPM .syn modeline yönlendirin ve Run'a tıklayın."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Referans ses (Audio File) → GigaAM ASR (otomatik transkript → ref text) + metin (Text) → OmniVoice TTS (ref_audio'dan Clone modu) → Audio Player ve Save to File. Bir ses örneği içeren WAV açın, metni girin, Syn Checkpoint düğümlerini .syn modellerine yönlendirin: ASR için GigaAM (gigaam-v3.syn) ve TTS için OmniVoice (omnivoice.syn), ardından Run'a tıklayın. Text View'daki transkript sentezden önce düzenlenebilir."
template.builtin-vibevoice-dialogue.name = "VibeVoice: two-voice dialogue"
template.builtin-vibevoice-dialogue.desc = "\"Speaker 1: …\" / \"Speaker 2: …\" biçiminde bir senaryo, artı iki kısa WAV ses örneği → VibeVoice kesintisiz 24 kHz'lik bir diyalog parçası sentezler. Syn Checkpoint düğümünü vibevoice-1.5b.syn'e yönlendirin ve Run'a tıklayın."
template.builtin-vibevoice-single.name = "VibeVoice: single voice clone"
template.builtin-vibevoice-single.desc = "Bir WAV ses örneği + metin → VibeVoice tamamını seslendirir (model onlarca dakika boyunca bağlamı korur). Syn Checkpoint düğümünde vibevoice-1.5b.syn veya vibevoice-7b.syn kullanın."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast from a topic (LLM → voice)"
template.builtin-vibevoice-llm-podcast.desc = "Konu → LLM, \"Speaker N: …\" satırları biçiminde bir senaryo yazar → Text View (elle düzenlenebilir) → VibeVoice bunu iki sesle seslendirir → oynatıcı ve kayıt. İki Syn Checkpoint düğümü gerekir: bir LLM bundle'ı ve vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → oynatıcı. Temel metinden müziğe üretim."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Aynı tag'lerle parçanın bir varyasyonu (iki noise seed'inin karışımı). Retake variance, varyasyonun gücünü kontrol eder; kaynak ses gerekmez."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Kaynak sesin [start,end] bölgesini yeniden üretir (bölge dışında — orijinal kalır). ⚠ Duration'ı kaynak sesin uzunluğuna ayarlayın."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Sesi uzatır: orijinal korunur, yeni bir kuyruk üretilir. ⚠ Duration'ı kaynak uzunluğundan büyük ayarlayın, region = yeni kısım (start = kaynak uzunluğu, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Kaynak sesi yeni bir prompta doğru dönüştürür (SDEdit: n_max'e kadar yeniden gürültüleme → denoise). n_max=0 ⇒ değişiklik yok, 1'e yaklaştıkça ⇒ daha güçlü. ⚠ Duration = kaynağın uzunluğu."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: kaynak ses → DiT bağlamı, tag'ler yeni stili/enstrümanları belirler. ⚠ Duration = kaynağın uzunluğu."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Miksten bir stem çıkarır: kaynak ses → DiT bağlamı, tag'ler neyin çıkarılacağını belirtir. ⚠ Duration = kaynağın uzunluğu."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (video ve sesin ortak denoise'u) → VAE Decode + Audio Decode → mp4 ve oynatıcı. Checkpoint'i MiniMax-H3 .syn bundle'ına yönlendirin; encoder bundle'dan alınır. Orijinal pipeline: 20 adım, CFG 5 — Sampler'ın varsayılanları."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "Text to Video ile aynı graf, ama Turbo LoRA için ayarlanmış: 6 adım, CFG yok (bu şablonun Sampler'ında ayarlı). Checkpoint'in LoRA alanını minimax_h3_turbo_v4_step600_ema.safetensors'a yönlendirin — bu olmadan 6 adım gürültülü titreme üretir."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Bir görseli canlandırır: Keyframe (\"first frame\" slotu) hem Text Encoder'ı (promptun sunumunda <Picture 1> olarak) hem de Sampler'ı (conditioning içine VAE ile kodlanmış olarak) besler. AV-latent çözünürlüğünü kaynağın en-boy oranına uyacak şekilde ayarlayın."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "İki kare arasında bir geçiş. İkinci Keyframe düğümünde \"last frame\" slotunu seçin — model yalnızca ilk ve son karede anchor'ı destekler; layout kurulurken ortadaki bir anchor reddedilir."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) ve bir video oynatıcı (bellekten kare+ses, Save ile paralel). Checkpoint düğümünde LTX-2.3, Gemma ve upscaler'ı gösterin — model dizininden .syn bundle'ları (veya .safetensors + Gemma HF dizini). Checkpoint mutlaka distilled olmalı (ltx-2.3-22b-distilled-*): aşamalar distilled 8+3 adımlık programı izler, dev bir checkpoint bulanık video üretir."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Görsel (kare 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → video oynatıcı / Save. Checkpoint'te LTX-2.3, Gemma ve upscaler'ı gösterin; LTX Image'de görseli gösterin."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Kaynak video (LTX Video Input) + prompt → Text Encoder → Retake (saniye cinsinden [start,end] bölgesini yeniden üretir, geri kalanı sabit kalır) → VAE Decode + Audio Decode → video oynatıcı / Save. Tek aşamalı (upscale yok). Checkpoint'te LTX-2.3 ve Gemma'yı gösterin; Video Input'ta videoyu gösterin."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Bir referans video (LTX Video Input) yapıyı/hareketi belirler, prompt içeriği belirler → Text Encoder → IC-LoRA (ref-control ekler) → VAE Decode + Audio Decode → video oynatıcı / Save. Checkpoint'te LTX-2.3, Gemma ve IC-LoRA adaptörünü (LoRA alanı) gösterin; Video Input'ta referans videoyu gösterin."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Bir referans video (yüz) + konuşma (Audio Input) → konuşmaya dudak senkronu: Text Encoder → Lipdub (stage1 A/V ref+audio ekler → upscale → stage2 refine) → VAE Decode + Audio Decode → video oynatıcı / Save. Checkpoint'te LTX-2.3, Gemma, upscaler ve lipdub IC-LoRA'yı (LoRA alanı) gösterin."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Ses (Audio Input) ses parçasını sabitler, prompt sahneyi belirler → Text Encoder → A2V (stage1 video-denoise, ses sabitken → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → video oynatıcı / Save. Checkpoint'te LTX-2.3, Gemma ve upscaler'ı gösterin; Audio Input'ta sesi gösterin."

