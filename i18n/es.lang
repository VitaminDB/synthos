training.title = "Entrenamiento"
training.subtitle = "Ajusta modelos de lenguaje con adaptadores LoRA"
training.overview.nav = "Cómo funciona"
training.overview.lead = "Un adaptador LoRA es un pequeño complemento a los pesos de un modelo (de decenas a cientos de megabytes) que le enseña un estilo, un formato de respuesta o un área temática. El modelo en sí no cambia: el adaptador se activa y desactiva, y un modelo puede tener varios. El entrenamiento se ejecuta en el servicio de IA: puedes cerrar Synthos y la tarea sigue en marcha."
training.overview.step1.title = "Crea un conjunto de datos"
training.overview.step1.text = "Diálogos de ejemplo: la pregunta del usuario y la respuesta que el modelo debe aprender. Bastan de cien a unos miles de buenos ejemplos. Los conjuntos de datos están en la carpeta datasets de la biblioteca de modelos; deja ahí un JSONL listo o crea y edita uno aquí."
training.overview.step2.title = "Inicia el entrenamiento"
training.overview.step2.text = "Elige un modelo y un conjunto de datos; el resto tiene valores predeterminados razonables. Un modelo cuantizado se entrena tal cual (QLoRA): la base queda congelada y solo aprenden los adaptadores. El progreso muestra la curva de pérdida, la velocidad y el tiempo restante."
training.overview.step3.title = "Activa el adaptador"
training.overview.step3.text = "Activa el adaptador terminado de forma predeterminada para el modelo (aquí o en los Ajustes del sistema) o en la tarjeta «Adaptadores LoRA» de un chat concreto. Su intensidad se puede cambiar sin volver a entrenar."
