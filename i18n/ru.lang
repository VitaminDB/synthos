template.builtin-flux-text-to-image.name = "FLUX: текст в картинку"
template.builtin-flux-text-to-image.desc = "Промпт → Кодировщик описания → Сэмплер (по умолчанию 28 шагов, guidance 3.5) → Декодер → PNG. Модель — FLUX.1 из библиотеки службы; размер — в «Пустом латенте»."
template.builtin-flux-image-to-image.name = "FLUX: картинка в картинку"
template.builtin-flux-image-to-image.desc = "Картинка → Картинка в латент → Сэмплер с силой 0,6 → Декодер → PNG. Чем меньше сила, тем ближе к исходнику; 1 — рисовать заново в размере картинки."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Промпт → Кодировщик описания (Mistral-24B у dev, Qwen3 у klein) → Сэмплер (шаги по модели: dev 50, klein 4) → Декодер → PNG. Модель — FLUX.2 dev/klein из библиотеки службы."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Картинка → Референсы → Сэмплер с инструкцией правки → PNG в размере исходника (до 1 Мп). Пишите, что изменить и что оставить."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Картинка → Картинка в латент → Сэмплер с силой 0,7 → Декодер → PNG. Чем меньше сила, тем ближе к исходнику; правка по инструкции — шаблон Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Короткий промпт → LLM переписывает его подробно по инструкции Black Forest Labs (детали, свет, материалы, надписи в кавычках) → Text View (можно поправить) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Две картинки → Референсы → Референсы (цепочкой) → Сэмплер: персонаж, предмет или стиль с одной картинки в сцене другой. В промпте — «image 1», «image 2» по порядку цепочки."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Картинка → Референсы (их видят и кодировщик, и сэмплер) + инструкция правки → Сэмплер (true CFG 4) → PNG ~1 Мп в пропорциях исходника. Модель — Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Две картинки → Референсы → Референсы (цепочкой) → кодировщик и сэмплер: человек, предмет или стиль с одной картинки в сцене другой. Только Qwen-Image-Edit-2509/2511; в промпте — «Picture 1», «Picture 2»."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Промпт → Кодировщик описания (Qwen3-VL) → Сэмплер (40 шагов, без CFG, KV-кэш) → Декодер → PNG. Размер — в «Пустом латенте» (стороны кратны 32; родные 1024² и 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Картинка → Референсы (в кодировщик и сэмплер) + инструкция правки → Сэмплер → PNG в пропорциях исходника. Прозрачные PNG правятся с альфой."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Две картинки → Референсы → Референсы (цепочкой, до 10) → кодировщик и сэмплер. В промпте — <image1>, <image2> по порядку цепочки; размер — «Пустой латент»."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Стикер, логотип или вырезанный объект без фона: промпт в формате карточки модели («This is an RGBA image with transparency … the background is transparent») → PNG с альфа-каналом."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Короткий промпт → LLM переписывает его в подробное описание кадра по инструкции Qwen (Prompt Enhancer) → Text View (можно поправить) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Промпт и негатив → Кодировщик описания (CLIP-L + bigG) → Сэмплер (30 шагов, CFG 5) → Декодер → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Картинка → Картинка в латент → Сэмплер с силой 0,6 → Декодер → PNG (до 1 Мп, стороны кратны 64). Чем меньше сила, тем ближе к исходнику."
template.builtin-ltx-flux-keyframe.name = "LTX: кадр FLUX в видео"
template.builtin-ltx-flux-keyframe.desc = "FLUX рисует первый кадр по промпту (16:9, 1344×768) → Кадр-условие LTX → LTX-2.3 картинка-в-видео со звуком. Верхний промпт — что на кадре, нижний — что происходит в ролике."
template.builtin-h3-flux-keyframe.name = "H3: кадр FLUX в видео"
template.builtin-h3-flux-keyframe.desc = "FLUX рисует первый кадр (16:9, 1344×768) → первый кадр кодировщика H3 → видео MiniMax-H3 со звуком от этого кадра. Верхний промпт — кадр, нижний — действие и звук в формате H3."

