settings.ai_models.attn.desc = "Qwen3.6'nın 16 full-attention katmanındaki CUDA yolunu kontrol eder. FA-4 — en hızlısı (Split-K decode + prefill hd=256'da WMMA Tensor Cores): 5K decode'da ×1.4, 23K decode'da ×4.3, 5K prefill'de ×1.81 (1262'ye karşı 705 tok/s), 23K prefill'de ×2.53. FA-2 — aynı Split-K ama WMMA olmadan (scalar mma) — bisect hata ayıklaması için ya da Tensor Cores hatalı davranırsa. Off — reference softmax (≥10K token'da OOM, regresyon benchmark'ları için baseline). Bir sonraki yanıta anında uygulanır, model yeniden yüklemesi gerekmez."
settings.ai_models.cuda_graph = "CUDA-graph decode (Phase D)"
settings.ai_models.cuda_graph.desc = "Bir decode adımını bir CUDA Graph'a yakalar ve sonraki her token için tekrar oynatır. Token başına ~140 kernel çağrısının per-launch overhead'ini kaldırır. Hızlanma: kısa bağlamda ×1.45 (17.8 → 25.8 tok/s), 23K'da ×1.16 (19.4 → 22.6 tok/s) — uzun bağlamda flash-attention bandwidth'i launch overhead'ine baskın gelir. CUDA gerektirir. Bir sonraki yanıta anında uygulanır — model yeniden yüklemesi yalnızca aygıt non-default stream olmadan oluşturulmuşsa gerekir (Phase D öncesi eski derlemeler — artık `model_registry` içinde otomatik yapılıyor)."
settings.ai_models.mtp = "MTP (multi-token prediction)"
settings.ai_models.mtp.desc = "Modelin dahili nextn head'i üzerinde spekülatif decode: head ikinci token'ı tahmin eder, ana model her ikisini tek bir forward pass'te doğrular. Yalnızca greedy decode (temperature = 0) için ve yalnızca bundle'da `mtp.*` tensörleri varsa çalışır (GGUF'un MTP varyantı). Çıktı, normal decode ile bit-birebir aynıdır. RTX 5090 Laptop'ta, NVFP4: %80-84 draft kabul oranında 38.2 → 43.9 tok/s. Model yeniden yüklemesi gerektirir — MTP head ağırlıkları modelle birlikte yüklenir."
settings.ai_models.dflash = "DFlash (blok spekülasyonu, Muse Glimmer)"
settings.ai_models.dflash.desc = "Bir yardımcı drafter (2.3B, 5 katman) üzerinde spekülatif decode: drafter, ana modelin 5 katmanının hidden state'lerini görür ve tek bir forward pass'te 15 token'lık bir blok önerir; ana model tüm bloğu tek geçişte doğrular. Yalnızca greedy decode (temperature = 0) için ve yalnızca bundle'da bir `dflash` bileşeni varsa çalışır. Çıktı normal decode ile eşleşir — yalnızca ana model tarafından onaylanan token'lar kabul edilir. Model yeniden yüklemesi gerektirir: drafter'ın ağırlıkları onunla birlikte yüklenir (NVFP4'te +1.2 GB). VRAM'i serbest bırakmak ya da hızı karşılaştırmak için kapatın."
settings.ai_models.la_fused = "Fused linear_attn prep (Phase B-1)"
settings.ai_models.la_fused.desc = "Sigmoid + softplus + 3x repeat_interleave_cast'i tek bir CUDA kernel'de birleştirir (48 linear_attn katmanının her birinde 5 → 1 launch). Ayrı yoldan bit-birebir aynıdır; varsayılan = ON. 27B modelde kazanç ölçüm gürültüsü sınırları içindedir (compute kernel'ler launch overhead'inden daha büyüktür) — ama zarar vermez ve captured CUDA graph'ta daha az kernel node tutar. Yalnızca bisect hata ayıklaması için kapatın."
settings.ai_models.gdr_fused = "Fused gated_delta_rule + RmsNorm (Phase B-2)"
settings.ai_models.gdr_fused.desc = "SSM adımını ve RmsNormGated'i tek bir kernel'de birleştirir: SSM çıktısı global yerine shared memory'de kalır, RMS aşaması aynı block içinde çalışır. Head başına token başına 8 KB okuma+yazma trafiğini kaldırır. hk == hv gerektirir (Qwen3.6 için doğru, 128 == 128). Bit-exact; varsayılan = ON. Bisect hata ayıklaması için kapatın."
settings.ai_models.prefill_chunk = "Prefill chunk size"
settings.ai_models.prefill_chunk.desc = "`prefill_chunked` içindeki chunk boyutu. Varsayılan 1024, kısa promptlarda maksimum throughput sağlar, ama 24 GB GPU'da ≥10K token'da mevcut KV ring'in üzerine binen `(B,nh,1024,T) F32 ≈ 660 MB` tepe KV-allocation'ı OOM'a yol açar. 64-256'ya düşürmek -%5-10 prefill hızını VRAM alanıyla değiştirir. Yeniden yükleme olmadan bir sonraki `generate(...)` çağrısına uygulanır."
settings.ai_models.layer_sync = "Layer sync (bellek)"
settings.ai_models.layer_sync.desc = "Her decoder katmanından sonra `cudaStreamSynchronize`. Sync olmadan, cudarc'ın `cudaMallocAsync`'i MLP ara tensörlerini katmanlar arasında pool'da gerçek bir reclaim olmadan tutar: prefill chunk=1024'te bu +2-6 GB tepe VRAM ekler, bu da uzun promptlarda OOM'a yol açar. Auto (varsayılan) — yalnızca T > 1 olduğunda sync (yani prefill chunk'ları): decode'da sıfır maliyet, uzun prefill'de ~4 GB boşluk. On — her zaman sync: -%5 decode, -%4 prefill, maksimum bellek tasarrufu. Off — asla: maksimum hız, ≥30K token'lı promptlarda OOM riski. Yeniden yükleme olmadan bir sonraki `forward` çağrısına uygulanır."
settings.ai_models.nvfp4_mma = "Native FP4 mma GEMV (Phase E.2)"
settings.ai_models.nvfp4_mma.desc = "NVFP4 projeksiyonlarında decode M=1 için Native FP4 Tensor Cores — N+K'sı 64'ün katları olan shape'lerde cuBLASLt-NVFP4 yolunun yerini alır. Yalnızca Blackwell consumer'da (sm_120a) kullanılabilir; eski GPU'lar sessizce cuBLASLt'ye döner."
settings.ai_models.nvfp4_gemv = "Scalar NVFP4 GEMV (Phase E.2 fallback)"
settings.ai_models.nvfp4_gemv.desc = "NVFP4 projeksiyonlarında decode M=1 için scalar GEMV yolu (Tensor Cores olmadan). Varsayılan olarak kapalı — cuBLASLt-NVFP4 + Tensor Cores daha iyi throughput verir. Yalnızca bug bisect için etkinleştirin."
settings.ai_models.image_tokens = "Görsel ek detayı"
settings.ai_models.image_tokens.desc = "Sohbette bir görsele kaç vision token harcanacağı. Bir token 28x28 px'lik bir patch'i kapsar, yani 1024 token smart-resize sonrası yaklaşık 896x896 px eder: normal arayüz metni içeren bir ekran görüntüsü tamamen okunur. Daha fazla token küçük fontları ve diyagram detaylarını ortaya çıkarır, ama her görsel bağlamdan yer kaplar ve prefill'i uzatır (bir fotoğraf için 4096 token, eklenmiş bir makaleyle kıyaslanabilir). Yalnızca multimodal bundle'larda (bir vision tower'a sahip) çalışır; bir sonraki gönderilen mesaja uygulanır — model yeniden yüklemesi gerekmez."
settings.ai_models.preset.quality = "Quality — F16 KV, F16 lm_head/embed (maksimum doğruluk)"
settings.ai_models.preset.balance = "Balance — F16 KV + FP8 lm_head/embed (varsayılan, 24 GB'de 65K)"
settings.ai_models.preset.vram_saver = "VRAM-Saver — F16 KV + NVFP4 lm_head/embed (minimum VRAM)"
settings.ai_models.preset.custom = "Custom — manuel yapılandırma"
settings.ai_models.section.preset = "Preset"
settings.ai_models.preset = "Hazır kuantizasyon politikası"
settings.ai_models.preset.desc = "Quality — her şey F16'da (maksimum doğruluk). Balance — NVFP4 backbone + FP8 lm_head/embed: kalite kaybı olmadan 24 GB GPU'da 65K bağlam (≈ F16). VRAM-Saver — minimum VRAM için NVFP4 lm_head/embed, ama vocab projection'da fark edilir bir doğruluk düşüşü. Aşağıdaki herhangi bir dropdown'da yapılacak manuel değişiklik preseti “Custom”a çevirir."
app.browse = "Gözat…"
settings.ai_models.section.models_dir = "Model klasörü"
settings.ai_models.models_dir = "Modellerin aranacağı yer (.syn, LoRA, HF klasörleri)"
settings.ai_models.models_dir.desc = "Tüm pipeline'lar için ortak model klasörü. Syn-chat ajanı, checkpoint düğümlerini doldururken bundle yollarını buradan alır (pipelines action=list içeriğini gösterir). Varsayılan — ~/Storage/syn_models."
settings.ai_models.weights_storage = "Attn/MLP ağırlıkları (storage)"
settings.ai_models.weights_storage.desc = "VRAM'deki attention ve MLP linear-katman ağırlıklarının depolama formatı. NVFP4 — ana tasarruf (30 GB'ın ~12 GB'ı), Blackwell sm_120 gerektirir. FP8 — Hopper/Ada/Blackwell'de bir alternatif. F16 — kuantizasyon yok."
settings.ai_models.compute_dtype = "Compute dtype (aktivasyonlar)"
settings.ai_models.compute_dtype.desc = "Katmanlar arasındaki aktivasyonların hassasiyeti. F16 — GPU standardı. BF16 — daha geniş dinamik aralık, uzun bağlam prefill için faydalı. F32 — hata ayıklama."
settings.ai_models.kv_cache = "KV cache (full-attention katmanları)"
settings.ai_models.kv_cache.desc = "Decode adımları arasındaki K/V projeksiyonlarının depolama formatı. FP8 — KV'den -%50 VRAM (13K token'da ~-2 GB), tek bir paylaşılan per-tensor scale, matmul öncesi dequantize edilir. F16 — kuantizasyon yok. Auto = compute dtype."
settings.ai_models.lm_head = "lm_head (vocab projection, F16'da 2.5 GB)"
settings.ai_models.lm_head.desc = "vocab=248K üzerinde çıkış katmanı. F16 — standart bir Linear. FP8 E4M3 (varsayılan balance) — native cuBLASLt FP8 GEMM, ~1.2 GB tasarruf, doğruluk ≈ F16. NVFP4 — chunked bir NVFP4 kernel üzerinden ~1.9 GB tasarruf, ama vocab projection'da fark edilir kalite kaybıyla (yalnızca VRAM-Saver). Decode, FP8 quantize overhead'i nedeniyle F16'ya göre -%10..15."
settings.ai_models.embed_tokens = "embed_tokens (vocab embedding, F16'da 2.5 GB)"
settings.ai_models.embed_tokens.desc = "Token vektörleri tablosu. F16/BF16/F32 — standart bir Embedding (tablodan gather). FP8 E4M3 (varsayılan balance) — packed FP8 byte'ları + per-tensor scale + özel bir gather kernel, vocab=248K'da ~1.2 GB tasarruf, doğruluk ≈ F16. NVFP4 (Phase F) — packed FP4 nibble'lar + tile-major scale'ler, ~1.8 GB tasarruf, ama embed'de fark edilir kalite kaybıyla — yalnızca VRAM-Saver. Embed için Q8_0/Q4_0 uygulanmamıştır — F16'ya döner."
settings.ai_models.tied_embeddings = "Tied embeddings (lm_head <-> embed_tokens)"
settings.ai_models.tied_embeddings.desc = "Auto — modelin config.json'undan `tie_word_embeddings`i okur (Qwen3.6 27B için genellikle false). Force On — lm_head, embed_tokens ağırlıklarını yeniden kullanır (ayrı lm_head'in tamamından tasarruf: F16'da ~2.4 GB ya da NVFP4'te ~0.4 GB); tied olmayan bir checkpoint'te bu, sayısal çıktıyı değiştirir. Force Off — her zaman ayrı bir lm_head. Bir sonraki model yeniden yüklemesinde uygulanır."
settings.ai_models.ssm_state = "SSM state (Gated DeltaNet)"
settings.ai_models.ssm_state.desc = "48 linear-attention katmanı boyunca recurrence state. Varsayılan olarak F32 (HF'nin `mamba_ssm_dtype`'ı). BF16, uzun recurrence'larda olası doğruluk kaybıyla ~48 MB tasarruf sağlar."
settings.ai_models.conv_state = "Conv1d state (Gated DeltaNet)"
settings.ai_models.conv_state.desc = "linear_attn katmanlarındaki causal conv1d left-context. VRAM üzerindeki etkisi ihmal edilebilir (katman başına binlerce eleman), ama conv-update doğruluğunu etkiler."
