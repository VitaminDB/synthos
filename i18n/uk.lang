template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Порожній канвас — старт з нуля."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Чиста арифметика."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Відкрий WAV, натисни Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Запиши голос і одразу відтвори."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Запиши голос і почуй його з ефектами в реальному часі."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Запис мікрофона у WAV-файл (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 джерела) → Audio Player. Базовий шаблон мікшування двох треків."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Караоке-сценарій: голос поверх треку."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Референс-голос (Audio File) + текст (Text) → VoxCPM2 TTS (клонує з ref_audio) → Audio Player і Save to File. Відкрийте короткий WAV зі зразком голосу, впишіть текст, вкажіть .syn-модель VoxCPM у ноді Syn Checkpoint і натисніть Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Референс-голос (Audio File) → GigaAM ASR (авто-транскрипт → ref text) + текст (Text) → OmniVoice TTS (Clone-режим з ref_audio) → Audio Player і Save to File. Відкрийте WAV зі зразком голосу, впишіть текст, вкажіть .syn-моделі в нодах Syn Checkpoint: GigaAM (gigaam-v3.syn) для ASR і OmniVoice (omnivoice.syn) для TTS, натисніть Run. Транскрипт у Text View можна виправити перед синтезом."
template.builtin-vibevoice-dialogue.name = "VibeVoice: діалог двох голосів"
template.builtin-vibevoice-dialogue.desc = "Сценарій виду «Speaker 1: …» / «Speaker 2: …» плюс два коротких WAV зі зразками голосів → VibeVoice синтезує суцільну доріжку діалогу 24 кГц. Вкажіть vibevoice-1.5b.syn у ноді Syn Checkpoint і натисніть Run."
template.builtin-vibevoice-single.name = "VibeVoice: клон одного голосу"
template.builtin-vibevoice-single.desc = "Один WAV зі зразком голосу + текст → VibeVoice озвучує все повністю (модель тримає контекст на десятки хвилин). Модель — vibevoice-1.5b.syn або vibevoice-7b.syn у ноді Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: подкаст із теми (LLM → голос)"
template.builtin-vibevoice-llm-podcast.desc = "Тема → LLM пише сценарій рядками «Speaker N: …» → Text View (правиться вручну) → VibeVoice озвучує двома голосами → плеєр і збереження. Потрібні дві ноди Syn Checkpoint: LLM-бандл і vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → плеєр. Базова генерація музики з тексту."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Варіація треку з тими самими тегами (мікс двох шумових seed'ів). Retake variance задає силу варіації; вихідне аудіо не потрібне."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Перегенерація регіону [start,end] вихідного аудіо (поза регіоном — оригінал лишається). ⚠ Встановіть Duration = довжині вихідного аудіо."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Подовження аудіо: оригінал зберігається, генерується новий хвіст. ⚠ Встановіть Duration більше за довжину вихідного, регіон = нова частина (start = довжина вихідного, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Морфінг вихідного аудіо до нового промпту (SDEdit: ре-шум до n_max → денойз). n_max=0 ⇒ без змін, ближче до 1 ⇒ сильніше. ⚠ Duration = довжині вихідного."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Кавер: вихідне аудіо → контекст DiT, теги задають новий стиль/інструменти. ⚠ Duration = довжині вихідного."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Виділення стема з міксу: вихідне аудіо → контекст DiT, теги задають що витягти. ⚠ Duration = довжині вихідного."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Промпт → Кодувальник H3 (Qwen3-VL) → Семплер H3 (відео і звук разом, 20 кроків, CFG 5) → декодери відео і звуку → Накладання звуку → mp4 і плеєр. Розмір і тривалість — у вузлі Розмір відео H3."
template.builtin-h3-turbo.name = "H3: Turbo (6 кроків)"
template.builtin-h3-turbo.desc = "Той самий граф, що й Text to Video, для Turbo LoRA: 6 кроків без CFG. Вкажіть файл Turbo LoRA (minimax_h3_turbo…safetensors) у полі LoRA вузла Модель H3 — без нього 6 кроків дають шум."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Оживлення зображення: файл іде в перший кадр Кодувальника H3 (модель бачить його як <Picture 1>, семплер утримує його першим кадром). Задайте розмір відео за пропорціями зображення."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Перехід між двома кадрами: файли в перший і останній кадр Кодувальника H3 — модель закріплює лише перший і останній кадри."
template.builtin-h3-ref2va.name = "H3: Референси у відео"
template.builtin-h3-ref2va.desc = "Відео за референсами (модель Ref2VA): до 9 зображень, 3 відео і 3 аудіо, разом до 12 — по одному файлу в рядку вузла Список. Порядок задає теги <Picture i> / <Video k> / <Audio j>, на які посилається промпт."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Промпт → Кодувальник LTX (Gemma) + NAG → Stage1 → Апскейл ×2 → Stage2 → декодери відео і звуку → Накладання звуку → mp4 і плеєр. Модель — дистильована LTX-2.3 з бібліотеки служби (до dev-моделі додається distilled LoRA)."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Зображення (файл → Кадр-умова LTX, кадр 0) + промпт → Stage1 → Апскейл ×2 → Stage2 (кадр утримується на обох стадіях) → декодери → Накладання звуку → mp4 і плеєр."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Вихідне відео (файл) + промпт → Retake LTX: заново генеруються лише секунди [від, до], решта зберігається → декодери → Накладання звуку → mp4 і плеєр. Одна стадія, без апскейлу."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Відео-зразок (файл) задає структуру або рух, промпт — зміст → IC-LoRA LTX (сигнал: як є, контури Canny або глибина) → декодери → mp4 і плеєр. Адаптер — поле LoRA вузла Модель LTX (union / motion або файл)."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Відео з обличчям + нове мовлення (файли) → LipDub LTX: губи рухаються за мовленням, обидві стадії разом → декодери → mp4 і плеєр. Адаптер lipdub — у полі LoRA вузла Модель LTX."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Аудіо (файл) задає звукову доріжку, промпт — сцену → Відео за звуком LTX (звук зафіксовано на обох стадіях) → декодери → Накладання звуку → mp4 і плеєр."

