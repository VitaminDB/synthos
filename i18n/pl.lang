template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Puste płótno — zacznij od zera."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Czysta arytmetyka."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Otwórz plik WAV i naciśnij Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Nagraj swój głos i od razu go odtwórz."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Nagraj swój głos i usłysz go z efektami w czasie rzeczywistym."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Nagrywa dźwięk z mikrofonu do pliku WAV (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 źródła) → Audio Player. Podstawowy szablon do miksowania dwóch ścieżek."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Scenariusz karaoke: głos na podkładzie muzycznym."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Głos referencyjny (Audio File) + tekst (Text) → VoxCPM2 TTS (klonuje z ref_audio) → Audio Player i Save to File. Otwórz krótki plik WAV z próbką głosu, wpisz tekst, wskaż model VoxCPM .syn w nodzie Syn Checkpoint i kliknij Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Głos referencyjny (Audio File) → GigaAM ASR (auto-transkrypt → ref text) + tekst (Text) → OmniVoice TTS (tryb Clone z ref_audio) → Audio Player i Save to File. Otwórz plik WAV z próbką głosu, wpisz tekst, wskaż modele .syn w nodach Syn Checkpoint: GigaAM (gigaam-v3.syn) do ASR i OmniVoice (omnivoice.syn) do TTS, potem kliknij Run. Transkrypt w Text View można poprawić przed syntezą."
template.builtin-vibevoice-dialogue.name = "VibeVoice: two-voice dialogue"
template.builtin-vibevoice-dialogue.desc = "Scenariusz w formacie „Speaker 1: …” / „Speaker 2: …” plus dwie krótkie próbki głosu WAV → VibeVoice syntezuje ciągłą ścieżkę dialogu 24 kHz. Wskaż vibevoice-1.5b.syn w nodzie Syn Checkpoint i kliknij Run."
template.builtin-vibevoice-single.name = "VibeVoice: single voice clone"
template.builtin-vibevoice-single.desc = "Jedna próbka głosu WAV + tekst → VibeVoice narracja całości (model utrzymuje kontekst przez dziesiątki minut). Użyj vibevoice-1.5b.syn lub vibevoice-7b.syn w nodzie Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: podcast from a topic (LLM → voice)"
template.builtin-vibevoice-llm-podcast.desc = "Temat → LLM pisze scenariusz w liniach „Speaker N: …” → Text View (edytowalny ręcznie) → VibeVoice narracja dwoma głosami → odtwarzacz i zapis. Potrzebne dwie nody Syn Checkpoint: pakiet LLM i vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → odtwarzacz. Podstawowa generacja muzyki z tekstu."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Wariacja utworu przy tych samych tagach (mix dwóch noise seedów). Retake variance ustala siłę wariacji; źródłowe audio nie jest potrzebne."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Regeneruje region [start,end] źródłowego audio (poza regionem — oryginał pozostaje). ⚠ Ustaw Duration na długość źródłowego audio."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Wydłuża audio: oryginał zostaje zachowany, generowana jest nowa końcówka. ⚠ Ustaw Duration większe niż długość źródła, region = nowa część (start = długość źródła, end = -1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Morfuje źródłowe audio w stronę nowego promptu (SDEdit: re-noise do n_max → denoise). n_max=0 ⇒ bez zmian, bliżej 1 ⇒ silniej. ⚠ Duration = długość źródła."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Cover: źródłowe audio → kontekst DiT, tagi ustalają nowy styl/instrumenty. ⚠ Duration = długość źródła."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Wyodrębnia stem z miksu: źródłowe audio → kontekst DiT, tagi określają co wyciągnąć. ⚠ Duration = długość źródła."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Prompt → Qwen3-VL Text Encoder → Sampler (wspólny denoising wideo i audio) → VAE Decode + Audio Decode → mp4 i odtwarzacz. Wskaż pakiet .syn MiniMax-H3 w Checkpoint; enkoder zostanie pobrany z pakietu. Oryginalny pipeline: 20 kroków, CFG 5 — wartości domyślne Sampler."
template.builtin-h3-turbo.name = "H3: Turbo (6 steps)"
template.builtin-h3-turbo.desc = "Ten sam graf co Text to Video, ale dostrojony pod Turbo LoRA: 6 kroków, bez CFG (ustawione w Sampler tego szablonu). Wskaż plik minimax_h3_turbo_v4_step600_ema.safetensors w polu LoRA nody Checkpoint — bez niego 6 kroków da migoczący szum."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Ożywia obraz: Keyframe (slot „first frame”) trafia zarówno do Text Encoder (jako <Picture 1> w prezentacji promptu), jak i do Sampler (zakodowany przez VAE do conditioning). Ustaw rozdzielczość AV-latentu zgodnie z proporcjami źródła."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Przejście między dwiema klatkami. W drugiej nodzie Keyframe wybierz slot „last frame” — model obsługuje kotwice wyłącznie na pierwszej i ostatniej klatce; kotwica środkowa jest odrzucana na etapie składania layoutu."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Prompt → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → Video Save (mp4) i odtwarzacz wideo (klatki+dźwięk z pamięci, równolegle z Save). W nodzie Checkpoint wskaż LTX-2.3, Gemma i upscaler — pakiety .syn z katalogu modeli (albo .safetensors + katalog HF Gemma). Checkpoint musi być distilled (ltx-2.3-22b-distilled-*): etapy działają wg harmonogramu distilled 8+3 kroki, a checkpoint dev da rozmyte wideo."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Obraz (klatka 0) + prompt → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2 refine → VAE Decode + Audio Decode → odtwarzacz wideo / Save. W Checkpoint wskaż LTX-2.3, Gemma i upscaler; w LTX Image wskaż obraz."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Wideo źródłowe (LTX Video Input) + prompt → Text Encoder → Retake (regeneruje region [start,end] w sekundach, reszta zostaje frozen) → VAE Decode + Audio Decode → odtwarzacz wideo / Save. Jednoetapowo (bez upscale). W Checkpoint wskaż LTX-2.3 i Gemma; w Video Input wskaż wideo."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Wideo referencyjne (LTX Video Input) ustala strukturę/ruch, prompt ustala treść → Text Encoder → IC-LoRA (dołącza ref-control) → VAE Decode + Audio Decode → odtwarzacz wideo / Save. W Checkpoint wskaż LTX-2.3, Gemma i adapter IC-LoRA (pole LoRA); w Video Input wskaż wideo referencyjne."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Wideo referencyjne (twarz) + mowa (Audio Input) → synchronizacja ust z mową: Text Encoder → Lipdub (stage1 A/V dołącza ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → odtwarzacz wideo / Save. W Checkpoint wskaż LTX-2.3, Gemma, upscaler i lipdub IC-LoRA (pole LoRA)."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Audio (Audio Input) ustala ścieżkę dźwiękową, prompt ustala scenę → Text Encoder → A2V (stage1 video-denoise przy zamrożonym audio → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → odtwarzacz wideo / Save. W Checkpoint wskaż LTX-2.3, Gemma i upscaler; w Audio Input wskaż dźwięk."
