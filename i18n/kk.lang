training.overview.nav = "Қалай жұмыс істейді"
training.overview.lead = "LoRA адаптері — модель салмақтарына шағын қосымша (ондаған-жүздеген мегабайт), ол модельді стильге, жауап пішіміне немесе пәндік салаға үйретеді. Модельдің өзі өзгермейді: адаптер қосылып-өшіріледі, бір модельде олар бірнешеу болуы мүмкін. Оқыту нейрожелі қызметінде жүреді — Synthos-ты жапсаңыз да, тапсырма жалғаса береді."
training.overview.step1.title = "Деректер жинағын құрыңыз"
training.overview.step1.text = "Диалог мысалдары: пайдаланушы сұрағы және модель үйренуге тиіс жауап. Жүзден бірнеше мыңға дейін сапалы мысал жеткілікті. Деректер жинақтары модельдер кітапханасының datasets қалтасында сақталады; оған дайын JSONL салыңыз немесе осында жасап, өңдеңіз."
training.overview.step2.title = "Оқытуды бастаңыз"
training.overview.step2.text = "Модель мен деректер жинағын таңдаңыз — қалғанының ақылға қонымды әдепкі мәндері бар. Кванттелген модель сол күйінде оқытылады (QLoRA): негіз қатырылған, тек адаптерлер үйренеді. Барысында шығын қисығы, жылдамдық және қалған уақыт көрсетіледі."
training.overview.step3.title = "Адаптерді қосыңыз"
