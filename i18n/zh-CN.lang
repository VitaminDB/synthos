nav.training = "训练"
training.title = "训练"
training.subtitle = "使用 LoRA 适配器微调语言模型"
training.overview.nav = "工作原理"
training.overview.lead = "LoRA 适配器是模型权重的一个小型附加部分（几十到几百 MB），可以教会模型某种风格、回答格式或专业领域。模型本身不会改变：适配器可以开启和关闭，一个模型可以有多个适配器。训练在 AI 服务中运行 —— 即使关闭 Synthos，任务也会继续。"
training.overview.step1.title = "构建数据集"
training.overview.step1.text = "示例对话：用户的问题以及模型应当学会的回答。一百到几千条优质示例就足够了。数据集存放在模型库的 datasets 文件夹中；可以把现成的 JSONL 放进去，也可以在这里创建和编辑。"
training.overview.step2.title = "开始训练"
training.overview.step2.text = "选择模型和数据集 —— 其余参数都有合理的默认值。量化模型可直接训练（QLoRA）：基础模型保持冻结，只训练适配器。进度显示损失曲线、速度和剩余时间。"
training.overview.step3.title = "启用适配器"
training.overview.step3.text = "将训练好的适配器设为模型的默认适配器（在此处或系统设置中），或在某个聊天的“LoRA 适配器”卡片中启用。其强度可随时调整，无需重新训练。"
