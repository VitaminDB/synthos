template.builtin-empty.name = "Empty"
template.builtin-empty.desc = "Пустой канвас — старт с нуля."
template.builtin-simple-add.name = "Simple Add"
template.builtin-simple-add.desc = "Number + Number → Add → Output. Чистая арифметика."
template.builtin-audio-playback.name = "Audio Playback"
template.builtin-audio-playback.desc = "Audio File → Audio Player. Открой WAV, нажми Play."
template.builtin-voice-recording.name = "Voice Recording"
template.builtin-voice-recording.desc = "Audio Recorder → Audio Player. Запиши голос и сразу проиграй."
template.builtin-audio-effects-chain.name = "Audio Effects Chain"
template.builtin-audio-effects-chain.desc = "Recorder → Gain → Filter → Reverb → Player. Запиши голос и услышь его с эффектами в реальном времени."
template.builtin-save-to-file.name = "Save Recording"
template.builtin-save-to-file.desc = "Audio Recorder → Save to File. Запись микрофона в WAV-файл (PCM 16-bit)."
template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer (2 источника) → Audio Player. Базовый шаблон микширования двух треков."
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player. Караоке-сценарий: голос поверх трека."
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "Референс-голос (Audio File) + текст (Text) → VoxCPM2 TTS (клон по ref_audio) → Audio Player и Save to File. Откройте короткий WAV с образцом голоса, впишите текст, укажите .syn-модель VoxCPM в ноде Syn Checkpoint и нажмите Run."
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "Референс-голос (Audio File) → GigaAM ASR (авто-транскрипт → ref text) + текст (Text) → OmniVoice TTS (Clone-mode по ref_audio) → Audio Player и Save to File. Откройте WAV с образцом голоса, впишите текст, укажите .syn-модели в нодах Syn Checkpoint: GigaAM (gigaam-v3.syn) для ASR и OmniVoice (omnivoice.syn) для TTS, нажмите Run. Транскрипт в Text View можно поправить перед синтезом."
template.builtin-vibevoice-dialogue.name = "VibeVoice: диалог двух голосов"
template.builtin-vibevoice-dialogue.desc = "Сценарий вида «Speaker 1: …» / «Speaker 2: …» плюс два коротких WAV с образцами голосов → VibeVoice синтезирует сплошную дорожку диалога 24 кГц. Укажите vibevoice-1.5b.syn в ноде Syn Checkpoint и нажмите Run."
template.builtin-vibevoice-single.name = "VibeVoice: клон одного голоса"
template.builtin-vibevoice-single.desc = "Один WAV с образцом голоса + текст → VibeVoice озвучивает его целиком (модель держит контекст на десятки минут). Модель — vibevoice-1.5b.syn или vibevoice-7b.syn в ноде Syn Checkpoint."
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: подкаст из темы (LLM → голос)"
template.builtin-vibevoice-llm-podcast.desc = "Тема → LLM пишет сценарий строками «Speaker N: …» → Text View (правится вручную) → VibeVoice озвучивает двумя голосами → плеер и сохранение. Нужны два Syn Checkpoint: LLM-бандл и vibevoice-*.syn."
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint + tags/lyrics → Generate (text2music) → плеер. Базовая генерация музыки из текста."
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "Вариация трека при тех же тегах (микс двух шумовых seed'ов). Retake variance задаёт силу вариации; src-аудио не нужно."
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "Перегенерация региона [start,end] исходного аудио (вне региона — оригинал). ⚠ Установи Duration = длине исходного аудио."
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "Продление аудио: оригинал сохраняется, новый хвост генерируется. ⚠ Установи Duration > длины исходного, регион = новая часть (start=длина src, end=-1)."
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "Морфинг исходного аудио к новому промпту (SDEdit: ре-шум до n_max → денойз). n_max=0 ⇒ без изменений, ближе к 1 ⇒ сильнее. ⚠ Duration = длине src."
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "Кавер: исходное аудио → контекст DiT, теги задают новый стиль/инструменты. ⚠ Duration = длине src."
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "Выделение стема из микса: исходное аудио → контекст DiT, теги задают что вытянуть. ⚠ Duration = длине src."
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "Промпт → Qwen3-VL Text Encoder → Sampler (совместный денойзинг видео и звука) → VAE Decode + Audio Decode → mp4 и плеер. В Checkpoint укажите .syn-бандл MiniMax-H3; энкодер подхватится из бандла. Оригинальный пайплайн: 20 шагов, CFG 5 — дефолты Sampler."
template.builtin-h3-turbo.name = "H3: Turbo (6 шагов)"
template.builtin-h3-turbo.desc = "Тот же граф, что и Text to Video, но под Turbo LoRA: 6 шагов без CFG (задано в Sampler этого шаблона). Укажите minimax_h3_turbo_v4_step600_ema.safetensors в поле LoRA у Checkpoint — без неё на 6 шагах будет рябь."
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "Оживление изображения: Keyframe (слот «первый кадр») уходит и в Text Encoder (как <Picture 1> в презентации промпта), и в Sampler (VAE-энкод в cond-строки). Разрешение AV-латента задайте под пропорции исходника."
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "Переход между двумя кадрами. У второй Keyframe-ноды выберите слот «последний кадр» — модель поддерживает якоря только на первом и последнем кадрах, середина отвергается на этапе сборки layout."
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "Промпт → Text Encoder (Gemma) → Sampler Stage1 (A/V, NAG) → Upscale ×2 → Stage2-refine → VAE Decode + Audio Decode → Video Save (mp4) и Видеоплеер (кадры+звук из памяти, параллельно Save). В Checkpoint-ноде укажите чекпойнт LTX-2.3, Gemma и upscaler — .syn-бандлы из каталога моделей (или .safetensors + HF-каталог Gemma). Чекпойнт нужен ИМЕННО distilled (ltx-2.3-22b-distilled-*): стадии идут по distilled-расписанию 8+3 шага, на dev-модели видео выйдет размытым."
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "Изображение (кадр 0) + промпт → Text Encoder → Sampler Stage1 (A/V, image-cond, NAG) → Upscale ×2 → Stage2-refine → VAE Decode + Audio Decode → Видеоплеер / Save. В Checkpoint укажите чекпойнт LTX-2.3, Gemma и upscaler; в LTX Image — картинку."
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "Исходное видео (LTX Video Input) + промпт → Text Encoder → Retake (регенерация региона [начало,конец] сек, остальное frozen) → VAE Decode + Audio Decode → Видеоплеер / Save. Одностадийно (без upscale). В Checkpoint укажите чекпойнт LTX-2.3 и Gemma; в Video Input — видео."
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "Reference-видео (LTX Video Input) задаёт структуру/движение, промпт — содержание → Text Encoder → IC-LoRA (append ref-control) → VAE Decode + Audio Decode → Видеоплеер / Save. В Checkpoint укажите чекпойнт LTX-2.3, Gemma и IC-LoRA-адаптер (поле LoRA); в Video Input — reference-видео."
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "Reference-видео (лицо) + речь (Audio Input) → синхрон губ под речь: Text Encoder → Lipdub (stage1 A/V append ref+audio → upscale → stage2 refine) → VAE Decode + Audio Decode → Видеоплеер / Save. В Checkpoint укажите чекпойнт LTX-2.3, Gemma, upscaler и lipdub-IC-LoRA (поле LoRA)."
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "Аудио (Audio Input) фиксирует звуковую дорожку, промпт задаёт сцену → Text Encoder → A2V (stage1 video-denoise при frozen-аудио → upscale ×2 → stage2 refine) → VAE Decode + Audio Decode → Видеоплеер / Save. В Checkpoint укажите чекпойнт LTX-2.3, Gemma и upscaler; в Audio Input — звук."

