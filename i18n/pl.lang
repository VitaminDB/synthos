nav.training = "Trenowanie"
training.title = "Trenowanie"
training.subtitle = "Dostrajanie modeli językowych adapterami LoRA"
training.overview.nav = "Jak to działa"
training.overview.lead = "Adapter LoRA to mały dodatek do wag modelu (od dziesiątek do setek megabajtów), który uczy go stylu, formatu odpowiedzi lub dziedziny. Sam model się nie zmienia: adapter się włącza i wyłącza, a jeden model może mieć ich kilka. Trenowanie działa w usłudze AI — możesz zamknąć Synthos, a zadanie będzie kontynuowane."
training.overview.step1.title = "Przygotuj zbiór danych"
training.overview.step1.text = "Przykładowe dialogi: pytanie użytkownika i odpowiedź, której model ma się nauczyć. Wystarczy od stu do kilku tysięcy dobrych przykładów. Zbiory leżą w folderze datasets biblioteki modeli; wrzuć tam gotowy JSONL albo utwórz i edytuj zbiór tutaj."
training.overview.step2.title = "Uruchom trenowanie"
training.overview.step2.text = "Wybierz model i zbiór danych — reszta ma rozsądne wartości domyślne. Model skwantyzowany trenuje się bez zmian (QLoRA): baza pozostaje zamrożona, uczą się tylko adaptery. Postęp pokazuje krzywą loss, prędkość i pozostały czas."
training.overview.step3.title = "Włącz adapter"
training.overview.step3.text = "Włącz gotowy adapter domyślnie dla modelu (tutaj lub w Ustawieniach systemu) albo w karcie „Adaptery LoRA” konkretnego czatu. Jego siłę można zmieniać bez ponownego trenowania."
