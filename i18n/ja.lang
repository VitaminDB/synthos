template.builtin-mix-two-sources.name = "Mix 2 Sources"
template.builtin-mix-two-sources.desc = "Audio File + Audio File → Mixer（2 ソース）→ Audio Player。2 つのトラックをミックスする基本テンプレートです。"
template.builtin-mix-mic-and-file.name = "Mic + File"
template.builtin-mix-mic-and-file.desc = "Audio Recorder + Audio File → Mixer → Audio Player。カラオケのシナリオ：伴奏に声を重ねます。"
template.builtin-voice-clone-voxcpm.name = "VoxCPM: Voice Clone"
template.builtin-voice-clone-voxcpm.desc = "参照音声（Audio File）＋テキスト（Text）→ VoxCPM2 TTS（ref_audio からクローン）→ Audio Player と Save to File。声のサンプルを含む短い WAV を開き、テキストを入力し、Syn Checkpoint ノードで VoxCPM の .syn モデルを指定して Run を押します。"
template.builtin-voice-clone-omnivoice.name = "OmniVoice: Voice Clone"
template.builtin-voice-clone-omnivoice.desc = "参照音声（Audio File）→ GigaAM ASR（自動書き起こし → ref text）＋テキスト（Text）→ OmniVoice TTS（ref_audio による Clone モード）→ Audio Player と Save to File。声のサンプルを含む WAV を開き、テキストを入力し、Syn Checkpoint ノードで .syn モデルを指定します：ASR 用に GigaAM（gigaam-v3.syn）、TTS 用に OmniVoice（omnivoice.syn）。Run を押してください。Text View の書き起こしは合成前に編集できます。"
template.builtin-vibevoice-dialogue.name = "VibeVoice: 二人の対話"
template.builtin-vibevoice-dialogue.desc = "「Speaker 1: …」「Speaker 2: …」の形式の台本と、2 つの短い WAV 音声サンプル → VibeVoice が 24 kHz の連続した対話トラックを合成します。Syn Checkpoint ノードで vibevoice-1.5b.syn を指定して Run を押します。"
template.builtin-vibevoice-single.name = "VibeVoice: 単一音声クローン"
template.builtin-vibevoice-single.desc = "1 つの WAV 音声サンプルとテキスト → VibeVoice がすべてをナレーションします（モデルは数十分にわたりコンテキストを保持します）。Syn Checkpoint ノードで vibevoice-1.5b.syn または vibevoice-7b.syn を使用します。"
template.builtin-vibevoice-llm-podcast.name = "VibeVoice: トピックからのポッドキャスト（LLM → 音声）"
template.builtin-vibevoice-llm-podcast.desc = "トピック → LLM が「Speaker N: …」形式の台本を作成 → Text View（手動で編集可能）→ VibeVoice が二つの声でナレーション → プレーヤーと保存。Syn Checkpoint ノードが 2 つ必要です：LLM バンドルと vibevoice-*.syn。"
template.builtin-acestep-text2music.name = "ACE-Step: Text→Music"
template.builtin-acestep-text2music.desc = "Checkpoint ＋ tags/lyrics → Generate（text2music）→ プレーヤー。テキストから音楽を生成する基本形です。"
template.builtin-acestep-retake.name = "ACE-Step: Retake"
template.builtin-acestep-retake.desc = "同じタグでのトラックのバリエーション（2 つのノイズ seed のミックス）。Retake variance がバリエーションの強さを決めます。ソース音声は不要です。"
template.builtin-acestep-repaint.name = "ACE-Step: Repaint"
template.builtin-acestep-repaint.desc = "元音声の [start, end] 区間を再生成します（区間の外側は元のまま）。⚠ Duration は元音声の長さに合わせてください。"
template.builtin-acestep-extend.name = "ACE-Step: Extend"
template.builtin-acestep-extend.desc = "音声を延長します：元の部分は保持され、新しい末尾が生成されます。⚠ Duration は元の長さより大きく設定し、区間は新しい部分（start=元の長さ、end=-1）にしてください。"
template.builtin-acestep-edit.name = "ACE-Step: Edit"
template.builtin-acestep-edit.desc = "元音声を新しいプロンプトへとモーフィングします（SDEdit：n_max までノイズを加えて → デノイズ）。n_max=0 なら変化なし、1 に近いほど強くなります。⚠ Duration = 元音声の長さ。"
template.builtin-acestep-cover.name = "ACE-Step: Cover"
template.builtin-acestep-cover.desc = "カバー：元音声を DiT のコンテキストとして使い、tags で新しいスタイル・楽器を指定します。⚠ Duration = 元音声の長さ。"
template.builtin-acestep-extract.name = "ACE-Step: Extract"
template.builtin-acestep-extract.desc = "ミックスからステムを抽出：元音声を DiT のコンテキストとして使い、tags で抽出対象を指定します。⚠ Duration = 元音声の長さ。"
template.builtin-h3-text-to-video.name = "H3: Text to Video + Audio"
template.builtin-h3-text-to-video.desc = "プロンプト → H3 エンコーダー（Qwen3-VL）→ H3 サンプラー（動画と音声を同時生成、20 ステップ、CFG 5）→ 動画・音声デコーダー → 音声を重ねる → mp4 とプレーヤー。サイズと長さは H3 動画サイズで指定。"
template.builtin-h3-turbo.name = "H3: Turbo（6 ステップ）"
template.builtin-h3-turbo.desc = "Turbo LoRA 用の「テキストから動画」と同じグラフ：CFG なしで 6 ステップ。Turbo LoRA ファイル（minimax_h3_turbo…safetensors）を H3 モデルの LoRA 欄に指定してください。ないと 6 ステップではノイズが残ります。"
template.builtin-h3-first-frame.name = "H3: First Frame to Video"
template.builtin-h3-first-frame.desc = "画像をアニメーション化：ファイルを H3 エンコーダーの最初のフレームへ（モデルには <Picture 1> として見え、サンプラーは 1 フレーム目として保持）。動画サイズは画像の縦横比に合わせてください。"
template.builtin-h3-first-last.name = "H3: First+Last Frame"
template.builtin-h3-first-last.desc = "2 つのフレーム間のトランジション：ファイルを H3 エンコーダーの最初と最後のフレームへ。モデルは最初と最後のフレームだけを固定します。"
template.builtin-h3-ref2va.name = "H3: リファレンスから動画"
template.builtin-h3-ref2va.desc = "参照からの動画（Ref2VA モデル）：画像最大 9、動画 3、音声 3、合計 12。リストノードに 1 行 1 ファイル。順序がプロンプトで参照する <Picture i> / <Video k> / <Audio j> タグを決めます。"
template.builtin-ltx-text-to-video.name = "LTX: Text to Video"
template.builtin-ltx-text-to-video.desc = "プロンプト → LTX エンコーダー（Gemma）+ NAG → Stage1 → アップスケール ×2 → Stage2 → 動画・音声デコーダー → 音声を重ねる → mp4 とプレーヤー。モデル：サービスライブラリの distilled LTX-2.3（dev モデルには distilled LoRA を適用）。"
template.builtin-ltx-image-to-video.name = "LTX: Image to Video"
template.builtin-ltx-image-to-video.desc = "画像（ファイル → LTX 条件フレーム、フレーム 0）+ プロンプト → Stage1 → アップスケール ×2 → Stage2（両ステージでフレームを保持）→ デコーダー → 音声を重ねる → mp4 とプレーヤー。"
template.builtin-ltx-retake.name = "LTX: Retake"
template.builtin-ltx-retake.desc = "元動画（ファイル）+ プロンプト → LTX Retake：[開始, 終了] 秒だけを再生成し、残りは保持 → デコーダー → 音声を重ねる → mp4 とプレーヤー。単一ステージ、アップスケールなし。"
template.builtin-ltx-ic-lora.name = "LTX: IC-LoRA"
template.builtin-ltx-ic-lora.desc = "サンプル動画（ファイル）が構造や動き、プロンプトが内容を決定 → LTX IC-LoRA（信号：そのまま、Canny エッジ、深度）→ デコーダー → mp4 とプレーヤー。アダプター：LTX モデルの LoRA 欄（union / motion またはファイル）。"
template.builtin-ltx-lipdub.name = "LTX: Lipdub"
template.builtin-ltx-lipdub.desc = "顔の動画 + 新しい音声（ファイル）→ LTX LipDub：唇が音声に合わせて動き、両ステージを一度に → デコーダー → mp4 とプレーヤー。lipdub アダプターは LTX モデルの LoRA 欄へ。"
template.builtin-ltx-a2v.name = "LTX: Audio to Video"
template.builtin-ltx-a2v.desc = "音声（ファイル）がサウンドトラック、プロンプトがシーンを決定 → LTX 音声から動画（両ステージで音声固定）→ デコーダー → 音声を重ねる → mp4 とプレーヤー。"

