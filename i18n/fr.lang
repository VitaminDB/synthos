template.builtin-flux-text-to-image.name = "FLUX : texte vers image"
template.builtin-flux-text-to-image.desc = "Prompt → Encodeur de prompt → Sampler (28 étapes, guidance 3,5 par défaut) → Décodeur d’image → PNG. Modèle : FLUX.1 de la bibliothèque du service ; taille dans Latent vide."
template.builtin-flux-image-to-image.name = "FLUX : image vers image"
template.builtin-flux-image-to-image.desc = "Image → Image en latent → Sampler avec une force de 0,6 → Décodeur d’image → PNG. Une force plus faible reste plus proche de l’original ; 1 redessine à la taille de l’image."
template.builtin-flux2-text-to-image.name = "FLUX.2 : Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → Encodeur de prompt (Mistral-24B pour dev, Qwen3 pour klein) → Sampler (étapes selon le modèle : dev 50, klein 4) → Décodeur d’image → PNG. Modèle : FLUX.2 dev/klein de la bibliothèque du service."
template.builtin-flux2-edit.name = "FLUX.2 : Edit Image"
template.builtin-flux2-edit.desc = "Image → Références → Sampler avec une instruction de retouche → PNG à la taille d’origine (jusqu’à 1 MP). Indiquez ce qu’il faut changer et ce qu’il faut garder."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Image → Image en latent → Sampler avec une force de 0,7 → Décodeur d’image → PNG. Une force plus faible reste plus proche de l’original ; pour retoucher par instruction, utilisez Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Prompt court → un LLM le développe selon les consignes de Black Forest Labs (détails, lumière, matières, texte entre guillemets) → Text View (modifiable) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2 : Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Deux images → Références → Références (en chaîne) → Sampler : un personnage, un objet ou un style d’une image placé dans la scène de l’autre. Désignez-les par \"image 1\", \"image 2\" dans l’ordre de la chaîne."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Image → Références (vues par l’encodeur et le sampler) + instruction de retouche → Sampler (true CFG 4) → PNG d’environ 1 MP aux proportions d’origine. Modèle : Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Deux images → Références → Références (en chaîne) → encodeur et sampler : une personne, un objet ou un style d’une image dans la scène de l’autre. Qwen-Image-Edit-2509/2511 uniquement ; désignez-les par \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Encodeur de prompt (Qwen3-VL) → Sampler (40 étapes, sans CFG, cache KV) → Décodeur d’image → PNG. Taille dans Latent vide (multiples de 32 ; natifs 1024² et 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Image → Références (vers l’encodeur et le sampler) + instruction de retouche → Sampler → PNG aux proportions d’origine. Les PNG transparents gardent leur alpha."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Deux images → Références → Références (en chaîne, jusqu’à 10) → encodeur et sampler. Désignez-les par <image1>, <image2> dans l’ordre de la chaîne ; taille dans Latent vide."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Sticker, logo ou objet détouré sans arrière-plan : prompt au format de la fiche du modèle (\"This is an RGBA image with transparency … the background is transparent\") → PNG avec alpha."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Prompt court → un LLM le réécrit en description détaillée du plan selon le Prompt Enhancer de Qwen → Text View (modifiable) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt et prompt négatif → Encodeur de prompt (CLIP-L + bigG) → Sampler (30 étapes, CFG 5) → Décodeur d’image → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Image → Image en latent → Sampler avec une force de 0,6 → Décodeur d’image → PNG (jusqu’à 1 MP, côtés multiples de 64). Une force plus faible reste plus proche de l’original."
template.builtin-ltx-flux-keyframe.name = "LTX : image FLUX vers vidéo"
template.builtin-ltx-flux-keyframe.desc = "FLUX dessine la première image à partir d’un prompt (16:9, 1344×768) → Image de conditionnement LTX → LTX-2.3 image vers vidéo avec son. Prompt du haut : ce qui est dans l’image ; du bas : ce qui se passe dans la vidéo."
template.builtin-h3-flux-keyframe.name = "H3 : image FLUX vers vidéo"
template.builtin-h3-flux-keyframe.desc = "FLUX dessine la première image (16:9, 1344×768) → première image de l’Encodeur H3 → vidéo MiniMax-H3 avec son à partir de celle-ci. Prompt du haut : l’image ; du bas : action et son au format H3."

