template.builtin-flux-text-to-image.name = "FLUX: metinden görsele"
template.builtin-flux-text-to-image.desc = "İstem → İstem kodlayıcı → Örnekleyici (varsayılan 28 adım, guidance 3,5) → Görsel çözücü → PNG. Model: hizmet kütüphanesinden FLUX.1; boyut Boş latent düğümünde."
template.builtin-flux-image-to-image.name = "FLUX: görselden görsele"
template.builtin-flux-image-to-image.desc = "Görsel → Görselden latente → 0,6 güçte Örnekleyici → Görsel çözücü → PNG. Güç düştükçe sonuç kaynağa yakın kalır; 1, görsel boyutunda baştan çizer."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "İstem → İstem kodlayıcı (dev için Mistral-24B, klein için Qwen3) → Örnekleyici (modele göre adım: dev 50, klein 4) → Görsel çözücü → PNG. Model: hizmet kütüphanesinden FLUX.2 dev/klein."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Görsel → Referanslar → düzenleme talimatlı Örnekleyici → kaynak boyutunda PNG (en fazla 1 MP). Neyin değişeceğini ve neyin kalacağını yazın."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Görsel → Görselden latente → 0,7 güçte Örnekleyici → Görsel çözücü → PNG. Güç düştükçe sonuç kaynağa yakın kalır; talimatla düzenleme için Edit Image şablonunu kullanın."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Kısa istem → LLM, Black Forest Labs yönergelerine göre genişletir (ayrıntılar, ışık, malzemeler, tırnak içindeki yazılar) → Text View (düzenlenebilir) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "İki görsel → Referanslar → Referanslar (zincirleme) → Örnekleyici: bir görseldeki karakter, nesne veya stil diğerinin sahnesinde. İstemde zincir sırasıyla \"image 1\", \"image 2\" diye anın."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Görsel → Referanslar (kodlayıcı ve örnekleyici görür) + düzenleme talimatı → Örnekleyici (true CFG 4) → kaynak oranlarında ~1 MP PNG. Model: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "İki görsel → Referanslar → Referanslar (zincirleme) → kodlayıcı ve örnekleyici: bir görseldeki kişi, nesne veya stil diğerinin sahnesinde. Yalnızca Qwen-Image-Edit-2509/2511; \"Picture 1\", \"Picture 2\" diye anın."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "İstem → İstem kodlayıcı (Qwen3-VL) → Örnekleyici (40 adım, CFG yok, KV önbelleği) → Görsel çözücü → PNG. Boyut Boş latent düğümünde (32'nin katları; doğal 1024² ve 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Görsel → Referanslar (kodlayıcıya ve örnekleyiciye) + düzenleme talimatı → Örnekleyici → kaynak oranlarında PNG. Saydam PNG'ler alfa kanalını korur."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "İki görsel → Referanslar → Referanslar (zincirleme, en fazla 10) → kodlayıcı ve örnekleyici. Zincir sırasıyla <image1>, <image2> diye anın; boyut Boş latent düğümünde."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Arka plansız çıkartma, logo veya kesilmiş nesne: model kartı biçiminde istem (\"This is an RGBA image with transparency … the background is transparent\") → alfa kanallı PNG."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Kısa istem → LLM, Qwen'in Prompt Enhancer'ına göre ayrıntılı bir çekim açıklamasına dönüştürür → Text View (düzenlenebilir) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "İstem ve negatif istem → İstem kodlayıcı (CLIP-L + bigG) → Örnekleyici (30 adım, CFG 5) → Görsel çözücü → 1024² PNG."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Görsel → Görselden latente → 0,6 güçte Örnekleyici → Görsel çözücü → PNG (en fazla 1 MP, kenarlar 64'ün katı). Güç düştükçe sonuç kaynağa yakın kalır."
template.builtin-ltx-flux-keyframe.name = "LTX: FLUX karesinden videoya"
template.builtin-ltx-flux-keyframe.desc = "FLUX istemden ilk kareyi çizer (16:9, 1344×768) → LTX koşul karesi → sesli LTX-2.3 görselden videoya. Üst istem: karede ne var; alt istem: videoda ne oluyor."
template.builtin-h3-flux-keyframe.name = "H3: FLUX karesinden videoya"
template.builtin-h3-flux-keyframe.desc = "FLUX ilk kareyi çizer (16:9, 1344×768) → H3 kodlayıcı ilk kare → bundan sesli MiniMax-H3 videosu. Üst istem: kare; alt istem: H3 biçiminde eylem ve ses."

