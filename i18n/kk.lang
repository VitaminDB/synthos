template.builtin-flux-text-to-image.name = "FLUX: мәтіннен сурет"
template.builtin-flux-text-to-image.desc = "Промпт → Сипаттама кодтаушысы → Сэмплер (әдепкі 28 қадам, guidance 3,5) → Сурет декодері → PNG. Модель — қызмет кітапханасындағы FLUX.1; өлшемі — Бос латент түйінінде."
template.builtin-flux-image-to-image.name = "FLUX: суреттен сурет"
template.builtin-flux-image-to-image.desc = "Сурет → Суреттен латент → күші 0,6 Сэмплер → Сурет декодері → PNG. Күш неғұрлым аз болса, нәтиже бастапқыға соғұрлым жақын; 1 — сурет өлшемінде толық қайта салу."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Промпт → Сипаттама кодтаушысы (dev үшін Mistral-24B, klein үшін Qwen3) → Сэмплер (қадамдар модельге қарай: dev 50, klein 4) → Сурет декодері → PNG. Модель — қызмет кітапханасындағы FLUX.2 dev/klein."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Сурет → Референстер → өңдеу нұсқауы бар Сэмплер → бастапқы өлшемдегі PNG (1 MP-ге дейін). Нені өзгертіп, нені қалдыру керегін жазыңыз."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Сурет → Суреттен латент → күші 0,7 Сэмплер → Сурет декодері → PNG. Күш неғұрлым аз болса, нәтиже бастапқыға соғұрлым жақын; нұсқау бойынша өңдеу үшін — Edit Image үлгісі."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Қысқа промпт → LLM оны Black Forest Labs нұсқауы бойынша толық жазады (бөлшектер, жарық, материалдар, тырнақшадағы жазулар) → Text View (түзетуге болады) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Екі сурет → Референстер → Референстер (тізбекпен) → Сэмплер: бір суреттегі кейіпкер, зат не стиль екіншісінің көрінісінде. Промптта — тізбек ретімен \"image 1\", \"image 2\"."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Сурет → Референстер (оларды кодтаушы мен сэмплер көреді) + өңдеу нұсқауы → Сэмплер (true CFG 4) → бастапқы пропорциядағы ~1 MP PNG. Модель — Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Екі сурет → Референстер → Референстер (тізбекпен) → кодтаушы мен сэмплер: бір суреттегі адам, зат не стиль екіншісінің көрінісінде. Тек Qwen-Image-Edit-2509/2511; \"Picture 1\", \"Picture 2\" деп сілтеңіз."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Промпт → Сипаттама кодтаушысы (Qwen3-VL) → Сэмплер (40 қадам, CFG-сіз, KV-кэш) → Сурет декодері → PNG. Өлшемі — Бос латент түйінінде (32-ге еселі; негізгі 1024² және 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Сурет → Референстер (кодтаушы мен сэмплерге) + өңдеу нұсқауы → Сэмплер → бастапқы пропорциядағы PNG. Мөлдір PNG альфа-арнасын сақтайды."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Екі сурет → Референстер → Референстер (тізбекпен, 10-ға дейін) → кодтаушы мен сэмплер. Тізбек ретімен <image1>, <image2> деп сілтеңіз; өлшемі — Бос латент түйінінде."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Фонсыз стикер, логотип не қиылған нысан: модель картасы пішіміндегі промпт (\"This is an RGBA image with transparency … the background is transparent\") → альфа-арнасы бар PNG."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Қысқа промпт → LLM оны Qwen-нің Prompt Enhancer бойынша толық кадр сипаттамасына айналдырады → Text View (түзетуге болады) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Промпт және негатив промпт → Сипаттама кодтаушысы (CLIP-L + bigG) → Сэмплер (30 қадам, CFG 5) → Сурет декодері → 1024² PNG."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Сурет → Суреттен латент → күші 0,6 Сэмплер → Сурет декодері → PNG (1 MP-ге дейін, қабырғалары 64-ке еселі). Күш неғұрлым аз болса, нәтиже бастапқыға соғұрлым жақын."
template.builtin-ltx-flux-keyframe.name = "LTX: FLUX кадрын бейнеге"
template.builtin-ltx-flux-keyframe.desc = "FLUX промпт бойынша бірінші кадрды салады (16:9, 1344×768) → LTX шарт кадры → дыбысы бар LTX-2.3 суреттен бейне. Жоғарғы промпт — кадрда не бар; төменгісі — бейнеде не болады."
template.builtin-h3-flux-keyframe.name = "H3: FLUX кадрын бейнеге"
template.builtin-h3-flux-keyframe.desc = "FLUX бірінші кадрды салады (16:9, 1344×768) → H3 кодтаушысының бірінші кадры → соның негізінде дыбысы бар MiniMax-H3 бейнесі. Жоғарғы промпт — кадр; төменгісі — H3 пішіміндегі әрекет пен дыбыс."

