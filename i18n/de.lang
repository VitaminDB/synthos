settings.ai_models.layer_sync.off = "Off — nie (max. Geschwindigkeit, OOM-Risiko bei langem Kontext)"
settings.ai_models.section.runtime = "Inferenz (Runtime)"
settings.ai_models.attn = "Attention-Modus (Full-Attention-Schichten)"
settings.ai_models.attn.desc = "Steuert den CUDA-Pfad in den 16 Full-Attention-Schichten von Qwen3.6. FA-4 — am schnellsten (Split-K-Decode + WMMA Tensor Cores beim Prefill hd=256): ×1,4 bei 5K Decode, ×4,3 bei 23K Decode, ×1,81 bei 5K Prefill (1262 vs. 705 tok/s), ×2,53 bei 23K Prefill. FA-2 — dasselbe Split-K, aber ohne WMMA (skalares mma) — für Bisect-Debugging oder wenn sich die Tensor Cores auffällig verhalten. Off — Referenz-Softmax (OOM ab ≥10K Token, Baseline für Regressions-Benchmarks). Wirkt sofort auf die nächste Antwort, kein Neuladen des Modells nötig."
settings.ai_models.cuda_graph = "CUDA-Graph-Decode (Phase D)"
settings.ai_models.cuda_graph.desc = "Erfasst einen Decode-Schritt in einem CUDA Graph und spielt ihn für jeden folgenden Token erneut ab. Entfernt den Per-Launch-Overhead von ~140 Kernel-Aufrufen pro Token. Speedup: ×1,45 bei kurzem Kontext (17,8 → 25,8 tok/s), ×1,16 bei 23K (19,4 → 22,6 tok/s) — bei langem Kontext dominiert die Flash-Attention-Bandbreite gegenüber dem Launch-Overhead. Erfordert CUDA. Wirkt sofort auf die nächste Antwort — ein Neuladen des Modells ist nur nötig, wenn das Gerät ohne Non-Default-Stream erstellt wurde (ältere Builds vor Phase D — geschieht jetzt automatisch in `model_registry`)."
settings.ai_models.mtp = "MTP (Multi-Token-Prediction)"
settings.ai_models.mtp.desc = "Spekulativer Decode auf dem eingebauten nextn-Head des Modells: Der Head sagt den zweiten Token voraus, das Hauptmodell prüft beide in einem einzigen Forward-Pass. Funktioniert nur beim Greedy-Decoding (Temperature = 0) und nur, wenn das Bundle `mtp.*`-Tensoren enthält (die MTP-Variante von GGUF). Die Ausgabe ist bitidentisch zum regulären Decode. Auf einem RTX 5090 Laptop, NVFP4: 38,2 → 43,9 tok/s bei einer Draft-Akzeptanzrate von 80–84%. Erfordert ein Neuladen des Modells — die Gewichte des MTP-Heads werden zusammen mit dem Modell geladen."
settings.ai_models.dflash = "DFlash (Block-Spekulation, Muse Glimmer)"
settings.ai_models.dflash.desc = "Spekulativer Decode auf einem Assistenten-Drafter (2,3B, 5 Schichten): Der Drafter sieht die Hidden States von 5 Schichten des Hauptmodells und schlägt in einem Forward-Pass einen Block von 15 Token vor; das Hauptmodell prüft den gesamten Block in einem Durchgang. Funktioniert nur beim Greedy-Decoding (Temperature = 0) und nur, wenn das Bundle eine `dflash`-Komponente enthält. Die Ausgabe entspricht dem regulären Decode — akzeptiert werden nur vom Hauptmodell bestätigte Token. Erfordert ein Neuladen des Modells: Die Gewichte des Drafters werden zusammen mit ihm geladen (+1,2 GB bei NVFP4). Deaktivieren, um VRAM freizugeben oder die Geschwindigkeit zu vergleichen."
settings.ai_models.la_fused = "Fused linear_attn prep (Phase B-1)"
settings.ai_models.la_fused.desc = "Vereint sigmoid + softplus + 3×repeat_interleave_cast in einem einzigen CUDA-Kernel (5 → 1 Launch auf jeder der 48 linear_attn-Schichten). Bitgenau mit dem getrennten Pfad; Standard = ON. Beim 27B-Modell liegt der Gewinn im Rauschen der Messung (Compute-Kernels sind größer als der Launch-Overhead) — schadet aber nicht und hält weniger Kernel-Knoten im erfassten CUDA Graph. Nur für Bisect-Debugging deaktivieren."
settings.ai_models.gdr_fused = "Fused gated_delta_rule + RmsNorm (Phase B-2)"
settings.ai_models.gdr_fused.desc = "Vereint den SSM-Schritt und RmsNormGated in einem Kernel: Die SSM-Ausgabe bleibt im Shared Memory statt im globalen Speicher, die RMS-Phase läuft im selben Block. Entfernt 8 KB Lese-/Schreibverkehr pro Head und Token. Erfordert hk == hv (bei Qwen3.6 zutreffend, 128 == 128). Bitgenau; Standard = ON. Für Bisect-Debugging deaktivieren."
settings.ai_models.prefill_chunk = "Prefill-Chunk-Größe"
settings.ai_models.prefill_chunk.desc = "Chunk-Größe in `prefill_chunked`. Der Standardwert 1024 liefert den maximalen Durchsatz bei kurzen Prompts, aber ab ≥10K Token führt die Spitzen-KV-Allokation `(B,nh,1024,T) F32 ≈ 660 MB` oben auf dem aktuellen KV-Ring bei einer 24-GB-GPU zu OOM. Eine Reduzierung auf 64–256 tauscht -5–10% Prefill-Geschwindigkeit gegen VRAM-Spielraum. Wirkt beim nächsten Aufruf von `generate(...)` ohne Neuladen."
settings.ai_models.layer_sync = "Layer-Sync (Speicher)"
settings.ai_models.layer_sync.desc = "`cudaStreamSynchronize` nach jeder Decoder-Schicht. Ohne Sync hält cudarc über `cudaMallocAsync` MLP-Zwischentensoren zwischen den Schichten im Pool, ohne sie wirklich freizugeben: Bei Prefill-Chunk=1024 ergibt das +2–6 GB Spitzen-VRAM, was bei langen Prompts zu OOM führt. Auto (Standard) — nur synchronisieren, wenn T > 1 (d. h. bei Prefill-Chunks): keine Kosten beim Decode, ~4 GB frei bei langem Prefill. On — immer synchronisieren: -5% Decode, -4% Prefill, maximale Speicherersparnis. Off — nie: maximale Geschwindigkeit, OOM-Risiko ab ≥30K-Token-Prompts. Wirkt beim nächsten `forward`-Aufruf ohne Neuladen."
settings.ai_models.nvfp4_mma = "Native FP4-mma-GEMV (Phase E.2)"
settings.ai_models.nvfp4_mma.desc = "Native FP4 Tensor Cores für Decode M=1 bei NVFP4-Projektionen — ersetzt den cuBLASLt-NVFP4-Pfad bei Formen mit N+K als Vielfachem von 64. Nur auf Blackwell Consumer (sm_120a) verfügbar; ältere GPUs fallen still auf cuBLASLt zurück."
settings.ai_models.nvfp4_gemv = "Skalarer NVFP4-GEMV (Phase-E.2-Fallback)"
settings.ai_models.nvfp4_gemv.desc = "Skalarer GEMV-Pfad für Decode M=1 bei NVFP4-Projektionen (ohne Tensor Cores). Standardmäßig aus — cuBLASLt-NVFP4 + Tensor Cores liefert höheren Durchsatz. Nur für Bug-Bisect aktivieren."
settings.ai_models.image_tokens = "Detailgrad von Bildanhängen"
settings.ai_models.image_tokens.desc = "Wie viele Vision-Token für ein Bild im Chat aufgewendet werden. Ein Token deckt einen 28×28-px-Ausschnitt ab, sodass 1024 Token nach Smart-Resize etwa 896×896 px entsprechen: Ein Screenshot mit normalem Interface-Text ist vollständig lesbar. Mehr Token zeigen kleine Schrift und Diagrammdetails, aber jedes Bild beansprucht den Kontext und verlängert den Prefill (4096 Token für ein Foto entsprechen etwa einem angehängten Artikel). Funktioniert nur bei multimodalen Bundles (mit Vision-Turm); wirkt auf die nächste gesendete Nachricht — kein Neuladen des Modells nötig."
settings.ai_models.preset.quality = "Quality — F16 KV, F16 lm_head/embed (maximale Genauigkeit)"
settings.ai_models.preset.balance = "Balance — F16 KV + FP8 lm_head/embed (Standard, 65K bei 24 GB)"
settings.ai_models.preset.vram_saver = "VRAM-Saver — F16 KV + NVFP4 lm_head/embed (minimaler VRAM)"
settings.ai_models.preset.custom = "Custom — manuelle Konfiguration"
settings.ai_models.section.preset = "Preset"
settings.ai_models.preset = "Integrierte Quantisierungsrichtlinie"
settings.ai_models.preset.desc = "Quality — alles in F16 (maximale Genauigkeit). Balance — NVFP4-Backbone + FP8 lm_head/embed: 65K Kontext auf einer 24-GB-GPU ohne Qualitätsverlust (≈ F16). VRAM-Saver — NVFP4 lm_head/embed für minimalen VRAM, aber merklicher Genauigkeitsverlust bei der Vocab-Projektion. Jede manuelle Änderung einer Dropdown-Liste unten schaltet das Preset auf „Custom“."
app.browse = "Durchsuchen…"
settings.ai_models.section.models_dir = "Modellverzeichnis"
settings.ai_models.models_dir = "Wo nach Modellen gesucht wird (.syn, LoRA, HF-Verzeichnisse)"
settings.ai_models.models_dir.desc = "Gemeinsamer Modellordner für alle Pipelines. Der Syn-Chat-Agent entnimmt hier die Bundle-Pfade, wenn er Checkpoint-Nodes befüllt (pipelines action=list zeigt den Inhalt). Standard — ~/Storage/syn_models."
settings.ai_models.weights_storage = "Attn-/MLP-Gewichte (Storage)"
settings.ai_models.weights_storage.desc = "Speicherformat der Attention- und MLP-Linear-Schichtgewichte im VRAM. NVFP4 — die Haupteinsparung (~12 GB von 30 GB), erfordert Blackwell sm_120. FP8 — Alternative auf Hopper/Ada/Blackwell. F16 — ohne Quantisierung."
settings.ai_models.compute_dtype = "Compute-Dtype (Aktivierungen)"
settings.ai_models.compute_dtype.desc = "Genauigkeit der Aktivierungen zwischen den Schichten. F16 — der GPU-Standard. BF16 — größerer Dynamikbereich, nützlich für Prefill bei langem Kontext. F32 — Debugging."
settings.ai_models.kv_cache = "KV-Cache (Full-Attention-Schichten)"
settings.ai_models.kv_cache.desc = "Speicherformat der K/V-Projektionen zwischen Decode-Schritten. FP8 — -50% VRAM beim KV (~-2 GB bei 13K Token), ein gemeinsamer Per-Tensor-Scale, vor dem Matmul dequantisiert. F16 — ohne Quantisierung. Auto = Compute-Dtype."
settings.ai_models.lm_head = "lm_head (Vocab-Projektion, 2,5 GB in F16)"
settings.ai_models.lm_head.desc = "Ausgabeschicht über vocab=248K. F16 — ein Standard-Linear. FP8 E4M3 (Standard-Balance) — natives cuBLASLt-FP8-GEMM, spart ~1,2 GB, Genauigkeit ≈ F16. NVFP4 — spart ~1,9 GB über einen Chunked-NVFP4-Kernel, aber mit merklichem Qualitätsverlust bei der Vocab-Projektion (nur VRAM-Saver). Decode ist -10..15% gegenüber F16 wegen des FP8-Quantize-Overheads."
settings.ai_models.embed_tokens = "embed_tokens (Vocab-Embedding, 2,5 GB in F16)"
settings.ai_models.embed_tokens.desc = "Tabelle der Token-Vektoren. F16/BF16/F32 — ein Standard-Embedding (Gather aus der Tabelle). FP8 E4M3 (Standard-Balance) — gepackte FP8-Bytes + Per-Tensor-Scale + eigener Gather-Kernel, spart ~1,2 GB bei vocab=248K, Genauigkeit ≈ F16. NVFP4 (Phase F) — gepackte FP4-Nibbles + Tile-Major-Scales, spart ~1,8 GB, aber der Qualitätsverlust beim Embed ist merklich — nur VRAM-Saver. Q8_0/Q4_0 für Embed sind nicht implementiert — Rückfall auf F16."
settings.ai_models.tied_embeddings = "Tied Embeddings (lm_head ↔ embed_tokens)"
settings.ai_models.tied_embeddings.desc = "Auto — liest `tie_word_embeddings` aus der config.json des Modells (bei Qwen3.6 27B meist false). Force On — lm_head verwendet die Gewichte von embed_tokens weiter (spart den gesamten separaten lm_head: ~2,4 GB F16 oder ~0,4 GB NVFP4); bei einem Untied-Checkpoint ändert dies die numerische Ausgabe. Force Off — immer ein separater lm_head. Wirkt beim nächsten Neuladen des Modells."
settings.ai_models.ssm_state = "SSM-State (Gated DeltaNet)"
settings.ai_models.ssm_state.desc = "Rekurrenz-State über die 48 Linear-Attention-Schichten. Standardmäßig F32 (HFs `mamba_ssm_dtype`). BF16 spart ~48 MB bei möglichem Genauigkeitsverlust auf langen Rekurrenzen."
settings.ai_models.conv_state = "Conv1d-State (Gated DeltaNet)"
settings.ai_models.conv_state.desc = "Kausaler Conv1d-Linkskontext in den linear_attn-Schichten. Vernachlässigbarer Effekt auf VRAM (Tausende Elemente pro Schicht), beeinflusst aber die Genauigkeit des Conv-Updates."
