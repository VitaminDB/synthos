# Training (LoRA)
nav.training = "Training"
training.title = "Training"
training.subtitle = "Sprachmodelle mit LoRA-Adaptern feinabstimmen"
training.overview.nav = "So funktioniert es"
training.overview.lead = "Ein LoRA-Adapter ist ein kleiner Zusatz zu den Gewichten eines Modells (Dutzende bis Hunderte Megabyte), der ihm einen Stil, ein Antwortformat oder ein Fachgebiet beibringt. Das Modell selbst bleibt unverändert: Der Adapter wird ein- und ausgeschaltet, und ein Modell kann mehrere haben. Das Training läuft im KI-Dienst — Sie können Synthos schließen, der Auftrag läuft weiter."
training.overview.step1.title = "Datensatz erstellen"
training.overview.step1.text = "Beispieldialoge: eine Frage des Nutzers und die Antwort, die das Modell lernen soll. Hundert bis einige Tausend gute Beispiele genügen. Datensätze liegen im Ordner datasets der Modellbibliothek; legen Sie dort eine fertige JSONL ab oder erstellen und bearbeiten Sie hier einen Datensatz."
training.overview.step2.title = "Training starten"
training.overview.step2.text = "Wählen Sie ein Modell und einen Datensatz — für den Rest gibt es sinnvolle Standardwerte. Ein quantisiertes Modell wird unverändert trainiert (QLoRA): Die Basis bleibt eingefroren, nur die Adapter lernen. Der Fortschritt zeigt die Loss-Kurve, die Geschwindigkeit und die Restzeit."
training.overview.step3.title = "Adapter einschalten"
training.overview.step3.text = "Aktivieren Sie den fertigen Adapter standardmäßig für das Modell (hier oder in den Systemeinstellungen) oder in der Karte «LoRA-Adapter» eines bestimmten Chats. Die Stärke lässt sich ohne erneutes Training ändern."
