template.builtin-flux-image-to-image.name = "FLUX: imagem para imagem"
template.builtin-flux-image-to-image.desc = "Imagem → Imagem para latente → Sampler com intensidade 0,6 → Decodificador de imagem → PNG. Intensidade menor fica mais próxima do original; 1 redesenha no tamanho da imagem."
template.builtin-flux2-text-to-image.name = "FLUX.2: Text to Image"
template.builtin-flux2-text-to-image.desc = "Prompt → Codificador do prompt (Mistral-24B para dev, Qwen3 para klein) → Sampler (passos do modelo: dev 50, klein 4) → Decodificador de imagem → PNG. Modelo: FLUX.2 dev/klein da biblioteca do serviço."
template.builtin-flux2-edit.name = "FLUX.2: Edit Image"
template.builtin-flux2-edit.desc = "Imagem → Referências → Sampler com uma instrução de edição → PNG no tamanho original (até 1 MP). Diga o que mudar e o que manter."
template.builtin-flux2-image-to-image.name = "FLUX.2: Image to Image"
template.builtin-flux2-image-to-image.desc = "Imagem → Imagem para latente → Sampler com intensidade 0,7 → Decodificador de imagem → PNG. Intensidade menor fica mais próxima do original; para edições por instrução use Edit Image."
template.builtin-flux2-llm-upsampling.name = "FLUX.2: LLM Upsampling"
template.builtin-flux2-llm-upsampling.desc = "Prompt curto → um LLM o expande segundo as orientações da Black Forest Labs (detalhes, luz, materiais, texto entre aspas) → Visualização de texto (editável) → FLUX.2 → PNG."
template.builtin-flux2-multi-reference.name = "FLUX.2: Multi-Reference"
template.builtin-flux2-multi-reference.desc = "Duas imagens → Referências → Referências (encadeadas) → Sampler: um personagem, objeto ou estilo de uma imagem colocado na cena da outra. Chame-as de \"image 1\", \"image 2\" na ordem da cadeia."
template.builtin-qwen-image-edit.name = "Qwen-Image: Edit Image"
template.builtin-qwen-image-edit.desc = "Imagem → Referências (vistas pelo codificador e pelo sampler) + instrução de edição → Sampler (true CFG 4) → PNG de ~1 MP nas proporções originais. Modelo: Qwen-Image-Edit / 2511."
template.builtin-qwen-image-multi-edit.name = "Qwen-Image: Multi-Image Edit"
template.builtin-qwen-image-multi-edit.desc = "Duas imagens → Referências → Referências (encadeadas) → codificador e sampler: uma pessoa, objeto ou estilo de uma imagem na cena da outra. Apenas Qwen-Image-Edit-2509/2511; chame-as de \"Picture 1\", \"Picture 2\"."
template.builtin-qwen-image21-text-to-image.name = "Qwen-Image 2.1: Text to Image"
template.builtin-qwen-image21-text-to-image.desc = "Prompt → Codificador do prompt (Qwen3-VL) → Sampler (40 passos, sem CFG, cache KV) → Decodificador de imagem → PNG. Tamanho em Latente vazio (múltiplos de 32; nativos 1024² e 2048²)."
template.builtin-qwen-image21-edit.name = "Qwen-Image 2.1: Edit Image"
template.builtin-qwen-image21-edit.desc = "Imagem → Referências (para o codificador e o sampler) + instrução de edição → Sampler → PNG nas proporções originais. PNGs transparentes mantêm o canal alfa."
template.builtin-qwen-image21-multi-reference.name = "Qwen-Image 2.1: Multi-Reference"
template.builtin-qwen-image21-multi-reference.desc = "Duas imagens → Referências → Referências (encadeadas, até 10) → codificador e sampler. Use <image1>, <image2> na ordem da cadeia; tamanho em Latente vazio."
template.builtin-qwen-image21-transparent.name = "Qwen-Image 2.1: Transparent RGBA"
template.builtin-qwen-image21-transparent.desc = "Adesivo, logotipo ou objeto recortado sem fundo: prompt no formato do cartão do modelo (\"This is an RGBA image with transparency … the background is transparent\") → PNG com canal alfa."
template.builtin-qwen-image21-llm-rewrite.name = "Qwen-Image 2.1: LLM Prompt Rewrite"
template.builtin-qwen-image21-llm-rewrite.desc = "Prompt curto → um LLM o reescreve como uma descrição detalhada da cena segundo o Prompt Enhancer do Qwen → Visualização de texto (editável) → Qwen-Image 2.1 → PNG."
template.builtin-sdxl-text-to-image.name = "SDXL: Text to Image"
template.builtin-sdxl-text-to-image.desc = "Prompt e negativo → Codificador do prompt (CLIP-L + bigG) → Sampler (30 passos, CFG 5) → Decodificador de imagem → PNG 1024²."
template.builtin-sdxl-image-to-image.name = "SDXL: Image to Image"
template.builtin-sdxl-image-to-image.desc = "Imagem → Imagem para latente → Sampler com intensidade 0,6 → Decodificador de imagem → PNG (até 1 MP, lados múltiplos de 64). Intensidade menor fica mais próxima do original."
template.builtin-ltx-flux-keyframe.name = "LTX: quadro FLUX para vídeo"
template.builtin-ltx-flux-keyframe.desc = "O FLUX desenha o primeiro quadro a partir de um prompt (16:9, 1344×768) → Quadro de condição LTX → LTX-2.3 imagem para vídeo com áudio. Prompt de cima: o que está no quadro; de baixo: o que acontece no vídeo."
template.builtin-h3-flux-keyframe.name = "H3: quadro FLUX para vídeo"
template.builtin-h3-flux-keyframe.desc = "O FLUX desenha o primeiro quadro (16:9, 1344×768) → primeiro quadro do Codificador H3 → vídeo MiniMax-H3 com áudio a partir dele. Prompt de cima: o quadro; de baixo: ação e som no formato H3."

