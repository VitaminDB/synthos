# Training (LoRA)
nav.training = "Entraînement"
training.title = "Entraînement"
training.subtitle = "Affiner des modèles de langage avec des adaptateurs LoRA"
training.overview.nav = "Comment ça marche"
training.overview.lead = "Un adaptateur LoRA est un petit complément aux poids d'un modèle (de quelques dizaines à quelques centaines de mégaoctets) qui lui apprend un style, un format de réponse ou un domaine. Le modèle lui-même ne change pas : l'adaptateur s'active et se désactive, et un modèle peut en avoir plusieurs. L'entraînement s'exécute dans le service IA — vous pouvez fermer Synthos, la tâche continue."
training.overview.step1.title = "Préparer un jeu de données"
training.overview.step1.text = "Des dialogues d'exemple : la question de l'utilisateur et la réponse que le modèle doit apprendre. Une centaine à quelques milliers de bons exemples suffisent. Les jeux de données se trouvent dans le dossier datasets de la bibliothèque de modèles ; déposez-y un JSONL prêt ou créez-en un et modifiez-le ici."
training.overview.step2.title = "Lancer l'entraînement"
training.overview.step2.text = "Choisissez un modèle et un jeu de données — le reste a des valeurs par défaut raisonnables. Un modèle quantifié s'entraîne tel quel (QLoRA) : la base reste figée, seuls les adaptateurs apprennent. La progression affiche la courbe de perte, la vitesse et le temps restant."
training.overview.step3.title = "Activer l'adaptateur"
training.overview.step3.text = "Activez l'adaptateur terminé par défaut pour le modèle (ici ou dans les Paramètres système) ou dans la carte « Adaptateurs LoRA » d'un chat précis. Sa force se modifie sans réentraînement."
