training.overview.nav = "Como funciona"
training.overview.lead = "Um adaptador LoRA é um pequeno complemento aos pesos do modelo (de dezenas a centenas de megabytes) que lhe ensina um estilo, um formato de resposta ou uma área de conhecimento. O modelo em si não muda: o adaptador é ligado e desligado, e um modelo pode ter vários. O treinamento roda no serviço de IA — você pode fechar o Synthos e a tarefa continua."
training.overview.step1.title = "Monte um dataset"
training.overview.step1.text = "Diálogos de exemplo: a pergunta do usuário e a resposta que o modelo deve aprender. De cem a alguns milhares de bons exemplos bastam. Os datasets ficam na pasta datasets da biblioteca de modelos; coloque lá um JSONL pronto ou crie e edite um aqui."
training.overview.step2.title = "Inicie o treinamento"
training.overview.step2.text = "Escolha um modelo e um dataset — o resto tem padrões sensatos. Um modelo quantizado é treinado como está (QLoRA): a base fica congelada, só os adaptadores aprendem. O progresso mostra a curva de loss, a velocidade e o tempo restante."
training.overview.step3.title = "Ative o adaptador"
training.overview.step3.text = "Ative o adaptador pronto para o modelo por padrão (aqui ou nas Configurações do sistema) ou no cartão “Adaptadores LoRA” de um chat específico. A intensidade pode ser alterada sem retreinar."
training.offline.title = "O serviço de IA não está disponível"
